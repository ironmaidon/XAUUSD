//@version=6
// XAUUSD Institutional Framework
// Version: 0.3.0
//
// Session and Opening Range engine. Every state mutation happens on confirmed
// bars, so the engine never uses future values or repainting calculations.
//
// Changelog:
// - 0.3.0: Added the non-repainting Trend Engine (EMA, HTF EMA, VWAP, ADX,
//          pivot-based market structure, normalized scoring, and visuals).
// - 0.2.0: Added the Session and Opening Range engines.

//============================================================================== 
// 1. STRATEGY DECLARATION
//============================================================================== 
strategy("XAUUSD Institutional Framework v0.3.0", "XAUUSD v0.3.0", overlay = true,
     pyramiding = 0, calc_on_every_tick = false, calc_on_order_fills = false,
     process_orders_on_close = true, initial_capital = 10000, currency = currency.USD,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 1)

//============================================================================== 
// 2. CONSTANTS AND ENUMS
//============================================================================== 
string STRATEGY_VERSION = "0.3.0"
string DASHBOARD_TITLE = "XAUUSD SESSION ENGINE"
int MILLISECONDS_PER_MINUTE = 60000
int ATR_LENGTH = 14

enum SessionName
    None
    Asia
    London
    NewYork
    Custom

enum BreakoutState
    Waiting
    BuildingRange
    RangeCompleted
    BreakoutPending
    BreakoutConfirmed
    RetestPending
    TradeActive
    SessionFinished

enum TrendDirection
    Bullish
    Bearish
    Neutral

enum TrendStrength
    Weak
    Moderate
    Strong

enum MarketStructure
    HigherHigh
    HigherLow
    LowerHigh
    LowerLow
    Neutral

//============================================================================== 
// 3. INPUTS
//============================================================================== 
string GROUP_GENERAL = "1. General"
string GROUP_ASIA = "2. Asia Session"
string GROUP_LONDON = "3. London Session"
string GROUP_NEW_YORK = "4. New York Session"
string GROUP_CUSTOM = "5. Custom Session"
string GROUP_OPENING_RANGE = "6. Opening Range"
string GROUP_VISUALS = "7. Visuals"
string GROUP_DASHBOARD = "8. Dashboard and Debug"
string GROUP_TREND = "9. Trend Engine"
string GROUP_TREND_VISUALS = "10. Trend Visuals"

bool enabled = input.bool(true, "Enable strategy", group = GROUP_GENERAL)
string expectedSymbol = input.string("XAUUSD", "Expected symbol", group = GROUP_GENERAL)

bool asiaEnabled = input.bool(true, "Enable Asia", group = GROUP_ASIA)
string asiaStart = input.string("0000", "Start (HHMM)", options = ["0000", "0100", "0200", "0300", "0400", "0500", "0600", "0700", "0800", "0900", "1000", "1100", "1200", "1300", "1400", "1500", "1600", "1700", "1800", "1900", "2000", "2100", "2200", "2300"], group = GROUP_ASIA)
string asiaEnd = input.string("0800", "End (HHMM)", options = ["0000", "0100", "0200", "0300", "0400", "0500", "0600", "0700", "0800", "0900", "1000", "1100", "1200", "1300", "1400", "1500", "1600", "1700", "1800", "1900", "2000", "2100", "2200", "2300"], group = GROUP_ASIA)
string asiaTimezone = input.string("Etc/UTC", "Timezone", options = ["Etc/UTC", "Asia/Tokyo", "Europe/London", "America/New_York"], group = GROUP_ASIA)

bool londonEnabled = input.bool(true, "Enable London", group = GROUP_LONDON)
string londonStart = input.string("0800", "Start (HHMM)", options = ["0000", "0100", "0200", "0300", "0400", "0500", "0600", "0700", "0800", "0900", "1000", "1100", "1200", "1300", "1400", "1500", "1600", "1700", "1800", "1900", "2000", "2100", "2200", "2300"], group = GROUP_LONDON)
string londonEnd = input.string("1600", "End (HHMM)", options = ["0000", "0100", "0200", "0300", "0400", "0500", "0600", "0700", "0800", "0900", "1000", "1100", "1200", "1300", "1400", "1500", "1600", "1700", "1800", "1900", "2000", "2100", "2200", "2300"], group = GROUP_LONDON)
string londonTimezone = input.string("Europe/London", "Timezone", options = ["Etc/UTC", "Asia/Tokyo", "Europe/London", "America/New_York"], group = GROUP_LONDON)

bool newYorkEnabled = input.bool(true, "Enable New York", group = GROUP_NEW_YORK)
string newYorkStart = input.string("0800", "Start (HHMM)", options = ["0000", "0100", "0200", "0300", "0400", "0500", "0600", "0700", "0800", "0900", "1000", "1100", "1200", "1300", "1400", "1500", "1600", "1700", "1800", "1900", "2000", "2100", "2200", "2300"], group = GROUP_NEW_YORK)
string newYorkEnd = input.string("1700", "End (HHMM)", options = ["0000", "0100", "0200", "0300", "0400", "0500", "0600", "0700", "0800", "0900", "1000", "1100", "1200", "1300", "1400", "1500", "1600", "1700", "1800", "1900", "2000", "2100", "2200", "2300"], group = GROUP_NEW_YORK)
string newYorkTimezone = input.string("America/New_York", "Timezone", options = ["Etc/UTC", "Asia/Tokyo", "Europe/London", "America/New_York"], group = GROUP_NEW_YORK)

bool customEnabled = input.bool(false, "Enable Custom", group = GROUP_CUSTOM)
string customStart = input.string("0800", "Start (HHMM)", options = ["0000", "0100", "0200", "0300", "0400", "0500", "0600", "0700", "0800", "0900", "1000", "1100", "1200", "1300", "1400", "1500", "1600", "1700", "1800", "1900", "2000", "2100", "2200", "2300"], group = GROUP_CUSTOM)
string customEnd = input.string("1700", "End (HHMM)", options = ["0000", "0100", "0200", "0300", "0400", "0500", "0600", "0700", "0800", "0900", "1000", "1100", "1200", "1300", "1400", "1500", "1600", "1700", "1800", "1900", "2000", "2100", "2200", "2300"], group = GROUP_CUSTOM)
string customTimezone = input.string("Etc/UTC", "Timezone", options = ["Etc/UTC", "Asia/Tokyo", "Europe/London", "America/New_York"], group = GROUP_CUSTOM)

string openingRangeLength = input.string("30", "Opening range length (minutes)", options = ["15", "30", "45", "60", "90", "120"], group = GROUP_OPENING_RANGE)
float minimumAtrRatio = input.float(0.25, "Minimum ATR ratio", minval = 0.01, step = 0.01, group = GROUP_OPENING_RANGE)
float maximumAtrRatio = input.float(2.50, "Maximum ATR ratio", minval = 0.02, step = 0.01, group = GROUP_OPENING_RANGE)

bool showRangeBox = input.bool(true, "Draw opening range box", group = GROUP_VISUALS)
color rangeColor = input.color(color.aqua, "Range color", group = GROUP_VISUALS)
int rangeTransparency = input.int(85, "Range transparency", minval = 0, maxval = 100, group = GROUP_VISUALS)
bool showRangeBorder = input.bool(true, "Draw range border", group = GROUP_VISUALS)
bool showRangeLines = input.bool(true, "Draw high, low, and mid", group = GROUP_VISUALS)
bool showRangeLabels = input.bool(true, "Draw range labels", group = GROUP_VISUALS)

bool showDashboard = input.bool(true, "Show dashboard", group = GROUP_DASHBOARD)
bool debugEnabled = input.bool(false, "Show debug panel", group = GROUP_DASHBOARD)

bool emaFilterEnabled = input.bool(true, "Enable EMA filter", group = GROUP_TREND)
int fastEmaLength = input.int(50, "Fast EMA length", minval = 1, group = GROUP_TREND)
int slowEmaLength = input.int(200, "Slow EMA length", minval = 2, group = GROUP_TREND)
string htfTimeframe = input.timeframe("15", "HTF EMA timeframe", group = GROUP_TREND)
bool vwapFilterEnabled = input.bool(true, "Enable VWAP filter", group = GROUP_TREND)
int adxLength = input.int(14, "ADX length", minval = 1, group = GROUP_TREND)
float adxTrendThreshold = input.float(20.0, "ADX trending threshold", minval = 1.0, step = 0.5, group = GROUP_TREND)
int pivotLength = input.int(5, "Market structure pivot length", minval = 1, group = GROUP_TREND)

bool showEmaPlots = input.bool(true, "Plot EMAs", group = GROUP_TREND_VISUALS)
bool showTrendBackground = input.bool(false, "Color trend background", group = GROUP_TREND_VISUALS)
bool showTrendLabel = input.bool(false, "Show trend label", group = GROUP_TREND_VISUALS)

//============================================================================== 
// 4. STATE MODELS
//============================================================================== 
type SessionEngineState
    SessionName currentSession
    bool isActive
    bool justStarted
    bool justEnded
    int startTime
    int durationMinutes
    int barsInSession
    float progressPercent
    int barsRemaining

type OpeningRangeState
    float high
    float low
    float mid
    float width
    float atrRatio
    float percent
    float ticks
    int startTime
    int endTime
    int bars
    bool isBuilding
    bool isComplete
    bool qualityAccepted

type TradeControlState
    bool tradeTaken
    bool longTaken
    bool shortTaken
    bool sessionLocked

type SessionStatistics
    int sessions
    float totalRange
    float largestRange
    float smallestRange
    float totalAtrRatio
    int breakouts
    int falseBreakouts
    int successfulBreakouts

type TrendEngineState
    TrendDirection direction
    TrendStrength strength
    MarketStructure structure
    float score
    float fastEma
    float slowEma
    float htfFastEma
    float htfSlowEma
    float vwapValue
    float vwapDistance
    float vwapSlope
    float adx
    float plusDi
    float minusDi
    float swingHigh
    float swingLow
    bool structureBreak
    bool isTrending

var SessionEngineState sessionState = SessionEngineState.new(SessionName.None, false, false, false, na, 0, 0, 0.0, 0)
var OpeningRangeState rangeState = OpeningRangeState.new(na, na, na, na, na, na, na, na, na, 0, false, false, false)
var TradeControlState tradeControl = TradeControlState.new(false, false, false, false)
var SessionStatistics sessionStatistics = SessionStatistics.new(0, 0.0, na, na, 0.0, 0, 0, 0)
var TrendEngineState trendState = TrendEngineState.new(TrendDirection.Neutral, TrendStrength.Weak, MarketStructure.Neutral, 0.0, na, na, na, na, na, na, na, na, na, na, na, na, false, false)
var BreakoutState breakoutState = BreakoutState.Waiting
var int breakoutDirection = 0
var float atrAtRangeCompletion = na

//============================================================================== 
// 5. UTILITY FUNCTIONS
//============================================================================== 
// Returns a TradingView session specification from two HHMM input values.
BuildSession(string startValue, string endValue) =>
    startValue + "-" + endValue

// Returns true when the current chart bar belongs to the supplied session.
IsInSession(string sessionSpec, string timezone) =>
    not na(time(timeframe.period, sessionSpec, timezone))

// Returns a readable name for a session enum value.
SessionText(SessionName sessionName) =>
    switch sessionName
        SessionName.Asia => "Asia"
        SessionName.London => "London"
        SessionName.NewYork => "New York"
        SessionName.Custom => "Custom"
        => "None"

// Returns a readable name for a breakout-state enum value.
StateText(BreakoutState state) =>
    switch state
        BreakoutState.Waiting => "Waiting"
        BreakoutState.BuildingRange => "Building Range"
        BreakoutState.RangeCompleted => "Range Completed"
        BreakoutState.BreakoutPending => "Breakout Pending"
        BreakoutState.BreakoutConfirmed => "Breakout Confirmed"
        BreakoutState.RetestPending => "Retest Pending"
        BreakoutState.TradeActive => "Trade Active"
        => "Session Finished"

// Prevents division-by-zero while preserving a caller supplied fallback value.
SafeDivide(float numerator, float denominator, float fallback) =>
    denominator != 0.0 ? numerator / denominator : fallback

// Formats a price using the chart symbol's minimum tick size.
FormatPrice(float price) =>
    na(price) ? "n/a" : str.tostring(price, format.mintick)

// Formats a decimal number as a concise percentage string.
FormatPercent(float value) =>
    na(value) ? "n/a" : str.tostring(value, "#.##") + "%"

// Converts the opening-range input selection into an integer minute duration.
OpeningRangeMinutes() =>
    int(str.tonumber(openingRangeLength))

// Converts a HHMM session input into minutes since midnight.
MinutesFromHhmm(string timeValue) =>
    int hours = int(str.tonumber(str.substring(timeValue, 0, 2)))
    int minutes = int(str.tonumber(str.substring(timeValue, 2, 4)))
    hours * 60 + minutes

// Returns the configured duration for one session, including midnight crossings.
SessionDurationMinutes(SessionName sessionName) =>
    string startValue = sessionName == SessionName.Asia ? asiaStart : sessionName == SessionName.London ? londonStart : sessionName == SessionName.NewYork ? newYorkStart : customStart
    string endValue = sessionName == SessionName.Asia ? asiaEnd : sessionName == SessionName.London ? londonEnd : sessionName == SessionName.NewYork ? newYorkEnd : customEnd
    int startMinutes = MinutesFromHhmm(startValue)
    int endMinutes = MinutesFromHhmm(endValue)
    int rawDuration = endMinutes - startMinutes
    rawDuration > 0 ? rawDuration : rawDuration + 1440

// Selects one current session with stable priority: Asia, London, New York, Custom.
CurrentSession() =>
    bool asiaActive = asiaEnabled and IsInSession(BuildSession(asiaStart, asiaEnd), asiaTimezone)
    bool londonActive = londonEnabled and IsInSession(BuildSession(londonStart, londonEnd), londonTimezone)
    bool newYorkActive = newYorkEnabled and IsInSession(BuildSession(newYorkStart, newYorkEnd), newYorkTimezone)
    bool customActive = customEnabled and IsInSession(BuildSession(customStart, customEnd), customTimezone)
    asiaActive ? SessionName.Asia : londonActive ? SessionName.London : newYorkActive ? SessionName.NewYork : customActive ? SessionName.Custom : SessionName.None

// Returns a concise label for a trend direction.
TrendDirectionText(TrendDirection direction) =>
    direction == TrendDirection.Bullish ? "Bullish" : direction == TrendDirection.Bearish ? "Bearish" : "Neutral"

// Returns a concise label for the calculated trend strength.
TrendStrengthText(TrendStrength strength) =>
    strength == TrendStrength.Strong ? "Strong" : strength == TrendStrength.Moderate ? "Moderate" : "Weak"

// Returns a concise label for the latest confirmed market-structure event.
MarketStructureText(MarketStructure structure) =>
    structure == MarketStructure.HigherHigh ? "Higher High" : structure == MarketStructure.HigherLow ? "Higher Low" : structure == MarketStructure.LowerHigh ? "Lower High" : structure == MarketStructure.LowerLow ? "Lower Low" : "Neutral"

// Returns the current normalized direction computed by the Trend Engine.
GetTrendDirection() =>
    trendState.direction

// Returns the current normalized 0-100 trend score.
GetTrendScore() =>
    trendState.score

// Returns true only when the normalized Trend Engine direction is bullish.
IsBullTrend() =>
    GetTrendDirection() == TrendDirection.Bullish

// Returns true only when the normalized Trend Engine direction is bearish.
IsBearTrend() =>
    GetTrendDirection() == TrendDirection.Bearish

// Returns true when ADX is at or above the configured trending threshold.
IsTrending() =>
    trendState.isTrending

// Returns true when ADX is below the configured trending threshold.
IsRanging() =>
    not IsTrending()

// Returns the latest confirmed pivot-based market-structure classification.
GetMarketStructure() =>
    trendState.structure

//==============================================================================
// 6. TREND ENGINE
//==============================================================================
var float priorSwingHigh = na
var float priorSwingLow = na

// Updates swing prices and structure only after a pivot is confirmed.
UpdateMarketStructure(float pivotHigh, float pivotLow) =>
    trendState.structureBreak := false
    if not na(pivotHigh)
        priorSwingHigh := trendState.swingHigh
        trendState.swingHigh := pivotHigh
        if not na(priorSwingHigh)
            trendState.structure := pivotHigh > priorSwingHigh ? MarketStructure.HigherHigh : MarketStructure.LowerHigh
    if not na(pivotLow)
        priorSwingLow := trendState.swingLow
        trendState.swingLow := pivotLow
        if not na(priorSwingLow)
            trendState.structure := pivotLow > priorSwingLow ? MarketStructure.HigherLow : MarketStructure.LowerLow
    bool breaksHigh = not na(priorSwingHigh) and ta.crossover(close, priorSwingHigh)
    bool breaksLow = not na(priorSwingLow) and ta.crossunder(close, priorSwingLow)
    trendState.structureBreak := breaksHigh or breaksLow

// Derives direction, strength, and the 0-100 score from reusable trend inputs.
UpdateTrendEngine(float fastEma, float slowEma, float htfFastEma, float htfSlowEma, float vwapValue, float adxValue, float plusDiValue, float minusDiValue, float pivotHigh, float pivotLow) =>
    trendState.fastEma := fastEma
    trendState.slowEma := slowEma
    trendState.htfFastEma := htfFastEma
    trendState.htfSlowEma := htfSlowEma
    trendState.vwapValue := vwapValue
    trendState.vwapDistance := close - vwapValue
    trendState.vwapSlope := vwapValue - vwapValue[1]
    trendState.adx := adxValue
    trendState.plusDi := plusDiValue
    trendState.minusDi := minusDiValue
    trendState.isTrending := adxValue >= adxTrendThreshold
    UpdateMarketStructure(pivotHigh, pivotLow)

    bool emaBullish = emaFilterEnabled and fastEma > slowEma
    bool emaBearish = emaFilterEnabled and fastEma < slowEma
    bool htfBullish = emaFilterEnabled and htfFastEma > htfSlowEma
    bool htfBearish = emaFilterEnabled and htfFastEma < htfSlowEma
    bool vwapBullish = vwapFilterEnabled and close > vwapValue
    bool vwapBearish = vwapFilterEnabled and close < vwapValue
    bool structureBullish = trendState.structure == MarketStructure.HigherHigh or trendState.structure == MarketStructure.HigherLow
    bool structureBearish = trendState.structure == MarketStructure.LowerHigh or trendState.structure == MarketStructure.LowerLow

    float bullScore = (emaBullish ? 30.0 : 0.0) + (htfBullish ? 25.0 : 0.0) + (vwapBullish ? 15.0 : 0.0) + (trendState.isTrending and plusDiValue > minusDiValue ? 20.0 : 0.0) + (structureBullish ? 10.0 : 0.0)
    float bearScore = (emaBearish ? 30.0 : 0.0) + (htfBearish ? 25.0 : 0.0) + (vwapBearish ? 15.0 : 0.0) + (trendState.isTrending and minusDiValue > plusDiValue ? 20.0 : 0.0) + (structureBearish ? 10.0 : 0.0)
    trendState.score := math.max(bullScore, bearScore)
    trendState.direction := bullScore > bearScore ? TrendDirection.Bullish : bearScore > bullScore ? TrendDirection.Bearish : TrendDirection.Neutral
    trendState.strength := trendState.score >= 70.0 ? TrendStrength.Strong : trendState.score >= 45.0 ? TrendStrength.Moderate : TrendStrength.Weak

//============================================================================== 
// 6. SESSION ENGINE
//============================================================================== 
// Updates session lifecycle fields once per confirmed bar.
UpdateSessionEngine() =>
    SessionName activeSession = CurrentSession()
    bool activeNow = activeSession != SessionName.None
    bool sessionChanged = activeNow and activeSession != sessionState.currentSession
    sessionState.justStarted := sessionChanged
    sessionState.justEnded := sessionState.isActive and (not activeNow or sessionChanged)
    if sessionChanged
        sessionState.currentSession := activeSession
        sessionState.startTime := time
        sessionState.durationMinutes := SessionDurationMinutes(activeSession)
        sessionState.barsInSession := 1
    else if activeNow
        sessionState.barsInSession += 1
    else
        sessionState.barsInSession := 0
        sessionState.currentSession := SessionName.None
        sessionState.durationMinutes := 0
    sessionState.isActive := activeNow
    float elapsedMilliseconds = activeNow ? time - sessionState.startTime : 0.0
    float durationMilliseconds = sessionState.durationMinutes * MILLISECONDS_PER_MINUTE
    sessionState.progressPercent := activeNow ? math.min(100.0, SafeDivide(elapsedMilliseconds * 100.0, durationMilliseconds, 0.0)) : 0.0
    float barMilliseconds = timeframe.in_seconds() * 1000.0
    sessionState.barsRemaining := activeNow ? math.max(0, int(math.ceil(SafeDivide(durationMilliseconds - elapsedMilliseconds, barMilliseconds, 0.0))) ) : 0

//============================================================================== 
// 7. OPENING RANGE ENGINE
//============================================================================== 
// Resets every range and trade-control field at the beginning of a new session.
ResetForSession() =>
    rangeState.high := na
    rangeState.low := na
    rangeState.mid := na
    rangeState.width := na
    rangeState.atrRatio := na
    rangeState.percent := na
    rangeState.ticks := na
    rangeState.startTime := time
    rangeState.endTime := time + OpeningRangeMinutes() * MILLISECONDS_PER_MINUTE
    rangeState.bars := 0
    rangeState.isBuilding := true
    rangeState.isComplete := false
    rangeState.qualityAccepted := false
    tradeControl.tradeTaken := false
    tradeControl.longTaken := false
    tradeControl.shortTaken := false
    tradeControl.sessionLocked := false
    breakoutDirection := 0
    atrAtRangeCompletion := na
    breakoutState := BreakoutState.BuildingRange

// Adds one confirmed bar to the opening range and derives its metrics.
BuildOpeningRange(float atrValue) =>
    bool isRangeBar = time < rangeState.endTime
    if rangeState.isBuilding and isRangeBar
        rangeState.high := na(rangeState.high) ? high : math.max(rangeState.high, high)
        rangeState.low := na(rangeState.low) ? low : math.min(rangeState.low, low)
        rangeState.bars += 1
        rangeState.mid := (rangeState.high + rangeState.low) * 0.5
        rangeState.width := rangeState.high - rangeState.low
        rangeState.atrRatio := SafeDivide(rangeState.width, atrValue, na)
        rangeState.percent := SafeDivide(rangeState.width * 100.0, rangeState.mid, na)
        rangeState.ticks := SafeDivide(rangeState.width, syminfo.mintick, na)
    if rangeState.isBuilding and not isRangeBar
        rangeState.isBuilding := false
        rangeState.isComplete := true
        rangeState.mid := (rangeState.high + rangeState.low) * 0.5
        rangeState.width := rangeState.high - rangeState.low
        atrAtRangeCompletion := atrValue
        rangeState.atrRatio := SafeDivide(rangeState.width, atrValue, na)
        rangeState.percent := SafeDivide(rangeState.width * 100.0, rangeState.mid, na)
        rangeState.ticks := SafeDivide(rangeState.width, syminfo.mintick, na)
        rangeState.qualityAccepted := rangeState.atrRatio >= minimumAtrRatio and rangeState.atrRatio <= maximumAtrRatio
        breakoutState := BreakoutState.RangeCompleted

// Stores a completed range in aggregate session statistics exactly once.
RecordCompletedRange() =>
    sessionStatistics.sessions += 1
    sessionStatistics.totalRange += rangeState.width
    sessionStatistics.totalAtrRatio += rangeState.atrRatio
    sessionStatistics.largestRange := na(sessionStatistics.largestRange) ? rangeState.width : math.max(sessionStatistics.largestRange, rangeState.width)
    sessionStatistics.smallestRange := na(sessionStatistics.smallestRange) ? rangeState.width : math.min(sessionStatistics.smallestRange, rangeState.width)

//============================================================================== 
// 8. BREAKOUT STATE MACHINE
//============================================================================== 
// Advances the non-trading breakout state machine using only confirmed closes.
UpdateBreakoutState() =>
    if rangeState.isComplete and sessionState.isActive and rangeState.qualityAccepted
        bool closesAbove = close > rangeState.high
        bool closesBelow = close < rangeState.low
        bool closesInside = close <= rangeState.high and close >= rangeState.low
        if breakoutState == BreakoutState.RangeCompleted and (closesAbove or closesBelow)
            breakoutDirection := closesAbove ? 1 : -1
            breakoutState := BreakoutState.BreakoutPending
        else if breakoutState == BreakoutState.BreakoutPending
            bool confirms = breakoutDirection == 1 ? closesAbove : closesBelow
            if confirms
                breakoutState := BreakoutState.BreakoutConfirmed
                sessionStatistics.breakouts += 1
                sessionStatistics.successfulBreakouts += 1
            else if closesInside
                breakoutState := BreakoutState.RangeCompleted
                breakoutDirection := 0
                sessionStatistics.falseBreakouts += 1
        else if breakoutState == BreakoutState.BreakoutConfirmed
            bool retestsLevel = breakoutDirection == 1 ? low <= rangeState.high : high >= rangeState.low
            if retestsLevel
                breakoutState := BreakoutState.RetestPending
        else if breakoutState == BreakoutState.RetestPending
            bool resumesBreakout = breakoutDirection == 1 ? close > rangeState.high : close < rangeState.low
            if resumesBreakout
                breakoutState := BreakoutState.BreakoutConfirmed

//============================================================================== 
// 9. DRAWING MANAGER
//============================================================================== 
var box rangeBox = na
var line rangeHighLine = na
var line rangeLowLine = na
var line rangeMidLine = na
var label rangeHighLabel = na
var label rangeLowLabel = na
var label rangeWidthLabel = na

// Creates the fixed set of drawing objects once, then updates them in place.
EnsureDrawings() =>
    if na(rangeBox)
        rangeBox := box.new(bar_index, close, bar_index, close, border_color = rangeColor, bgcolor = color.new(rangeColor, rangeTransparency))
        rangeHighLine := line.new(bar_index, close, bar_index, close, color = rangeColor)
        rangeLowLine := line.new(bar_index, close, bar_index, close, color = rangeColor)
        rangeMidLine := line.new(bar_index, close, bar_index, close, color = color.new(rangeColor, 30), style = line.style_dashed)
        rangeHighLabel := label.new(bar_index, close, "", style = label.style_label_left, color = color.new(rangeColor, 80), textcolor = color.white, size = size.tiny)
        rangeLowLabel := label.new(bar_index, close, "", style = label.style_label_left, color = color.new(rangeColor, 80), textcolor = color.white, size = size.tiny)
        rangeWidthLabel := label.new(bar_index, close, "", style = label.style_label_left, color = color.new(rangeColor, 80), textcolor = color.white, size = size.tiny)

// Shows the latest opening range using reused box, line, and label objects.
UpdateRangeDrawings() =>
    EnsureDrawings()
    bool hasRange = not na(rangeState.high) and not na(rangeState.low)
    int leftBar = math.max(0, bar_index - rangeState.bars + 1)
    if hasRange and showRangeBox
        box.set_lefttop(rangeBox, leftBar, rangeState.high)
        box.set_rightbottom(rangeBox, bar_index, rangeState.low)
        box.set_bgcolor(rangeBox, color.new(rangeColor, rangeTransparency))
        box.set_border_color(rangeBox, showRangeBorder ? rangeColor : color.new(rangeColor, 100))
    else
        box.set_bgcolor(rangeBox, color.new(rangeColor, 100))
        box.set_border_color(rangeBox, color.new(rangeColor, 100))
    if hasRange and showRangeLines
        line.set_xy1(rangeHighLine, leftBar, rangeState.high)
        line.set_xy2(rangeHighLine, bar_index, rangeState.high)
        line.set_xy1(rangeLowLine, leftBar, rangeState.low)
        line.set_xy2(rangeLowLine, bar_index, rangeState.low)
        line.set_xy1(rangeMidLine, leftBar, rangeState.mid)
        line.set_xy2(rangeMidLine, bar_index, rangeState.mid)
        line.set_color(rangeHighLine, rangeColor)
        line.set_color(rangeLowLine, rangeColor)
        line.set_color(rangeMidLine, color.new(rangeColor, 30))
    else
        line.set_color(rangeHighLine, color.new(rangeColor, 100))
        line.set_color(rangeLowLine, color.new(rangeColor, 100))
        line.set_color(rangeMidLine, color.new(rangeColor, 100))
    if hasRange and showRangeLabels
        label.set_xy(rangeHighLabel, bar_index, rangeState.high)
        label.set_text(rangeHighLabel, "OR High " + FormatPrice(rangeState.high))
        label.set_xy(rangeLowLabel, bar_index, rangeState.low)
        label.set_text(rangeLowLabel, "OR Low " + FormatPrice(rangeState.low))
        label.set_xy(rangeWidthLabel, bar_index, rangeState.mid)
        label.set_text(rangeWidthLabel, "Width " + FormatPrice(rangeState.width))
        label.set_color(rangeHighLabel, color.new(rangeColor, 80))
        label.set_color(rangeLowLabel, color.new(rangeColor, 80))
        label.set_color(rangeWidthLabel, color.new(rangeColor, 80))
    else
        label.set_color(rangeHighLabel, color.new(rangeColor, 100))
        label.set_color(rangeLowLabel, color.new(rangeColor, 100))
        label.set_color(rangeWidthLabel, color.new(rangeColor, 100))

//==============================================================================
// 10. TREND VISUALS
//==============================================================================
var label trendLabel = na

// Returns a display color for the current normalized trend direction.
TrendColor() =>
    IsBullTrend() ? color.lime : IsBearTrend() ? color.red : color.gray

// Updates one reusable label with the current normalized trend state.
UpdateTrendLabel() =>
    if showTrendLabel and barstate.islast
        string labelText = TrendDirectionText(GetTrendDirection()) + " " + str.tostring(GetTrendScore(), "#.##") + " / " + TrendStrengthText(trendState.strength)
        if na(trendLabel)
            trendLabel := label.new(bar_index, high, labelText, style = label.style_label_down, color = TrendColor(), textcolor = color.white, size = size.small)
        else
            label.set_xy(trendLabel, bar_index, high)
            label.set_text(trendLabel, labelText)
            label.set_color(trendLabel, TrendColor())
    else if not na(trendLabel)
        label.set_color(trendLabel, color.new(TrendColor(), 100))

//============================================================================== 
// 11. DASHBOARD AND DEBUG
//============================================================================== 
var table dashboard = table.new(position.top_right, 2, 15, border_width = 1)
var table debugTable = table.new(position.bottom_right, 2, 6, border_width = 1)

// Writes one consistently styled dashboard row.
SetDashboardRow(table target, int row, string caption, string value) =>
    table.cell(target, 0, row, caption, text_color = color.silver, bgcolor = color.new(color.black, 15), text_size = size.small)
    table.cell(target, 1, row, value, text_color = color.white, bgcolor = color.new(color.black, 65), text_size = size.small)

// Updates the session dashboard only on the last chart bar.
UpdateDashboard() =>
    if barstate.islast
        if showDashboard
            SetDashboardRow(dashboard, 0, DASHBOARD_TITLE, "v" + STRATEGY_VERSION)
            SetDashboardRow(dashboard, 1, "Current session", SessionText(sessionState.currentSession))
            SetDashboardRow(dashboard, 2, "Current state", StateText(breakoutState))
            SetDashboardRow(dashboard, 3, "Range width", FormatPrice(rangeState.width))
            SetDashboardRow(dashboard, 4, "ATR ratio", str.tostring(rangeState.atrRatio, "#.##"))
            SetDashboardRow(dashboard, 5, "Session progress", FormatPercent(sessionState.progressPercent))
            SetDashboardRow(dashboard, 6, "Bars in session", str.tostring(sessionState.barsInSession))
            SetDashboardRow(dashboard, 7, "Bars remaining", str.tostring(sessionState.barsRemaining))
            SetDashboardRow(dashboard, 8, "Current trend", TrendDirectionText(GetTrendDirection()))
            SetDashboardRow(dashboard, 9, "Trend score", str.tostring(GetTrendScore(), "#.##"))
            SetDashboardRow(dashboard, 10, "EMA direction", trendState.fastEma > trendState.slowEma ? "Bullish" : trendState.fastEma < trendState.slowEma ? "Bearish" : "Neutral")
            SetDashboardRow(dashboard, 11, "HTF direction", trendState.htfFastEma > trendState.htfSlowEma ? "Bullish" : trendState.htfFastEma < trendState.htfSlowEma ? "Bearish" : "Neutral")
            SetDashboardRow(dashboard, 12, "VWAP status", close > trendState.vwapValue ? "Above" : close < trendState.vwapValue ? "Below" : "At VWAP")
            SetDashboardRow(dashboard, 13, "ADX", str.tostring(trendState.adx, "#.##"))
            SetDashboardRow(dashboard, 14, "Structure", MarketStructureText(GetMarketStructure()))
        else
            table.clear(dashboard, 0, 0, 1, 14)

// Updates the diagnostic panel only on the last chart bar when debugging is enabled.
UpdateDebugPanel() =>
    if barstate.islast
        if debugEnabled
            SetDashboardRow(debugTable, 0, "DEBUG", "v" + STRATEGY_VERSION)
            SetDashboardRow(debugTable, 1, "Session", SessionText(sessionState.currentSession))
            SetDashboardRow(debugTable, 2, "State", StateText(breakoutState))
            SetDashboardRow(debugTable, 3, "Range high", FormatPrice(rangeState.high))
            SetDashboardRow(debugTable, 4, "Range low", FormatPrice(rangeState.low))
            SetDashboardRow(debugTable, 5, "ATR / bars", str.tostring(rangeState.atrRatio, "#.##") + " / " + str.tostring(sessionState.barsInSession))
        else
            table.clear(debugTable, 0, 0, 1, 5)

//============================================================================== 
// 12. ORCHESTRATION
//============================================================================== 
float atrValue = ta.atr(ATR_LENGTH)
float fastEmaValue = ta.ema(close, fastEmaLength)
float slowEmaValue = ta.ema(close, slowEmaLength)
[htfFastEmaValue, htfSlowEmaValue] = request.security(syminfo.tickerid, htfTimeframe, [ta.ema(close, fastEmaLength), ta.ema(close, slowEmaLength)], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
float vwapValue = ta.vwap(hlc3)
[plusDiValue, minusDiValue, adxValue] = ta.dmi(adxLength, adxLength)
float confirmedPivotHigh = ta.pivothigh(high, pivotLength, pivotLength)
float confirmedPivotLow = ta.pivotlow(low, pivotLength, pivotLength)
bool symbolMatches = str.contains(str.upper(syminfo.tickerid), str.upper(expectedSymbol))

if barstate.isconfirmed
    UpdateTrendEngine(fastEmaValue, slowEmaValue, htfFastEmaValue, htfSlowEmaValue, vwapValue, adxValue, plusDiValue, minusDiValue, confirmedPivotHigh, confirmedPivotLow)
    UpdateSessionEngine()
    if sessionState.justEnded
        if rangeState.isComplete
            RecordCompletedRange()
        tradeControl.sessionLocked := true
        breakoutState := BreakoutState.SessionFinished
    if enabled and symbolMatches and sessionState.justStarted
        ResetForSession()
    if enabled and symbolMatches and sessionState.isActive
        BuildOpeningRange(atrValue)
        UpdateBreakoutState()

UpdateRangeDrawings()
UpdateTrendLabel()
UpdateDashboard()
UpdateDebugPanel()

plot(showEmaPlots ? fastEmaValue : na, "Fast EMA", color = color.teal, linewidth = 2)
plot(showEmaPlots ? slowEmaValue : na, "Slow EMA", color = color.orange, linewidth = 2)
color trendBackground = IsBullTrend() ? color.new(color.lime, 90) : IsBearTrend() ? color.new(color.red, 90) : color.new(color.gray, 95)
bgcolor(showTrendBackground ? trendBackground : na, title = "Trend Background")
