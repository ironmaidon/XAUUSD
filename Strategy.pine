//@version=6
// XAUUSD Institutional Framework
// Version: 0.9.0
//
// Session and Opening Range engine. Every state mutation happens on confirmed
// bars, so the engine never uses future values or repainting calculations.
//
// Changelog:
// - 0.9.0: Added M9-A event-driven entry execution with fixed initial stop and
//          target orders, M9-B partial-target lifecycle and residual-stop
//          protection tracking, M9-C breakeven management after TP1, and M9-D
//          selectable ATR, Chandelier, SuperTrend, and Swing trailing stops.
//          M9-E adds closed-trade aggregation, realized outcomes, and guard
//          reconciliation from actual execution.
// - 0.8.0: Added M8-A initial stop-selection architecture and fixed initial
//          risk-distance context, fixed position sizing, fixed-R targets/RR
//          validation, and guarded final risk approval with dashboard support.
// - 0.7.0: Added M7 directional component scoring, mandatory setup gates,
//          bounded penalties and adjusted scores, final directional
//          qualification/conflict resolution, setup lifecycle, and visuals.
// - 0.6.0: Added M6-A completed daily/weekly context, pivot-confirmed equal
//          high/low liquidity levels, M6-B liquidity sweep context, and M6-C
//          bounded Fair Value Gap lifecycle/proximity context, and M6-D basic
//          Order Block/premium-discount context, directional Smart Money scores,
//          lightweight M6 visuals, and dashboard integration.
//          Remaining Smart Money work is deferred.
// - 0.5.0: Added retest lifecycle, tolerance and penetration controls, retest
//          windows, pattern/quality confirmation, scoring, close-failure
//          confirmation, controlled retries, event visuals, and dashboard state.
// - 0.4.0: Added confirmed-candle breakout state, buffers, candle quality,
//          momentum, scoring, failure/attempt controls, visuals, and dashboard.
// - 0.3.0: Added the non-repainting Trend Engine (EMA, HTF EMA, VWAP, ADX,
//          pivot-based market structure, normalized scoring, and visuals).
// - 0.2.0: Added the Session and Opening Range engines.

//============================================================================== 
// 1. STRATEGY DECLARATION
//============================================================================== 
strategy("XAUUSD Institutional Framework v0.9.0", "XAUUSD v0.9.0", overlay = true,
     pyramiding = 0, calc_on_every_tick = false, calc_on_order_fills = false,
     process_orders_on_close = true, initial_capital = 10000, currency = currency.USD,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 1)

//============================================================================== 
// 2. CONSTANTS AND ENUMS
//============================================================================== 
string STRATEGY_VERSION = "0.9.0"
string DASHBOARD_TITLE = "XAUUSD SESSION ENGINE"
int MILLISECONDS_PER_MINUTE = 60000
int ATR_LENGTH = 14
float TRADE_PROFIT_TOLERANCE = 0.01

enum SessionName
    None
    Asia
    London
    NewYork
    Custom

enum BreakoutState
    None
    BullishCandidate
    BearishCandidate
    BullishConfirmed
    BearishConfirmed
    BullishFailed
    BearishFailed
    Invalidated

enum BreakoutStrength
    Weak
    Normal
    Strong
    Extreme

enum TradeDirection
    None
    Long
    Short

enum RetestState
    None
    WaitingForRetest
    RetestDetected
    RetestConfirmed
    RetestFailed
    Expired

enum RetestWindowMode
    Bars
    Minutes

enum RetestDistanceMode
    Ticks
    Atr
    Percentage

enum RetestConfirmationMode
    TouchAndClose
    Rejection
    PinBar
    Engulfing
    AnyPattern
    Strict

enum EqualLevelToleranceMode
    Ticks
    Atr
    Percentage

enum LiquiditySource
    None
    SwingHigh
    SwingLow
    EqualHigh
    EqualLow
    PreviousDayHigh
    PreviousDayLow
    PreviousWeekHigh
    PreviousWeekLow
    OpeningRangeHigh
    OpeningRangeLow

enum SweepStrength
    Weak
    Normal
    Strong
    Extreme

enum FvgInvalidationMode
    Midpoint
    FullFill
    CloseThrough

enum OrderBlockInvalidationMode
    WickThrough
    CloseThrough

enum DealingRangeMode
    RecentStructure
    OpeningRange
    PreviousDay

enum PremiumDiscountState
    Unknown
    Premium
    Equilibrium
    Discount

enum SmartMoneyBias
    Bullish
    Bearish
    Neutral

enum SmartMoneyStrength
    Weak
    Normal
    Strong
    Extreme

enum BreakoutBufferMode
    Ticks
    Percentage
    Atr

enum BreakoutConfirmationMode
    CloseOnly
    ClosePlusBuffer
    CandleQuality
    CandlePlusMomentum
    FullConfirmation

enum TrendDirection
    Bullish
    Bearish
    Neutral

enum TrendStrength
    Weak
    Moderate
    Strong

enum MarketStructure
    HigherHigh
    HigherLow
    LowerHigh
    LowerLow
    Neutral

// M7-owned lifecycle state for a qualified directional setup. This state is
// diagnostic only and never places or manages a trade.
enum TradeSetupState
    None
    BullishQualified
    BearishQualified
    Conflict
    Disqualified
    Expired

// M7-owned final setup bias. It is deliberately separate from SmartMoneyBias.
enum TradeBias
    None
    Bullish
    Bearish
    Neutral

// M7-owned diagnostic classification of a selected setup score.
enum TradeSetupStrength
    Weak
    Normal
    Strong
    Extreme

// M8 stop-selection policy for the initial, fixed stop-loss reference.
enum StopLossMode
    ATR
    Swing
    OpeningRange
    RetestStructure
    Conservative

// M8 diagnostic source for the selected initial stop-loss reference.
enum StopSource
    None
    ATR
    Swing
    OpeningRange
    Retest
    Conservative

// M8-B position-size policy. Quantity is always a positive magnitude.
enum PositionSizingMode
    RiskPercent
    FixedCashRisk
    FixedQuantity

// M8-B source for the equity captured with an initial risk context.
enum AccountEquitySource
    DynamicStrategyEquity
    InitialCapital

// M8-D deterministic diagnostic for final approval guard failures.
enum RiskBlockReason
    None
    DailyRisk
    DailyLoss
    TradeCount
    ConsecutiveLosses
    SessionRisk
    Multiple

// M9-A entry submission policy. With process_orders_on_close enabled, both
// supported modes deterministically submit at the approval bar's close.
enum EntryMode
    MarketOnApproval
    ApprovalClose

// M9-C breakeven activation source. RMultiple uses a completed-bar move from
// the actual (or planned fallback) entry and preserves TP1-only behavior.
enum BreakevenTriggerMode
    TP1Hit
    RMultiple

// M9-C breakeven offset calculation. Positive offsets always improve the stop
// in the direction of an open position.
enum BreakevenOffsetMode
    ExactEntry
    Ticks
    ATR

// M9-D trailing candidate source. Exactly one selected mode can improve the
// shared effective protective stop for an open trade.
enum TrailingStopMode
    None
    ATR
    Chandelier
    SuperTrend
    Swing

// M9-D trailing activation policy. AfterTP1 consumes M9-B's verified fill
// state, while RMultiple uses a completed-bar favorable move.
enum TrailingActivationMode
    Immediate
    AfterTP1
    RMultiple

// The source that last improved the shared protective stop. It is diagnostic
// state only and does not alter order or outcome behavior.
enum ActiveStopMode
    Initial
    Breakeven
    ATRTrail
    Chandelier
    SuperTrend
    Swing

// M9-E final lifecycle classification from realized closed-trade profit.
enum TradeOutcome
    None
    Win
    Loss
    Breakeven

// M9-E exit context. Actual closed-trade details are retained diagnostically;
// exact target/stop prices provide conservative final-reason classification.
enum TradeExitReason
    None
    TP1
    TP2
    InitialStop
    Breakeven
    TrailingStop
    Other

//============================================================================== 
// 3. INPUTS
//============================================================================== 
string GROUP_GENERAL = "1. General"
string GROUP_ASIA = "2. Asia Session"
string GROUP_LONDON = "3. London Session"
string GROUP_NEW_YORK = "4. New York Session"
string GROUP_CUSTOM = "5. Custom Session"
string GROUP_OPENING_RANGE = "6. Opening Range"
string GROUP_VISUALS = "7. Visuals"
string GROUP_DASHBOARD = "8. Dashboard and Debug"
string GROUP_TREND = "9. Trend Engine"
string GROUP_TREND_VISUALS = "10. Trend Visuals"
string GROUP_BREAKOUT = "11. Breakout Engine"
string GROUP_RETEST = "12. Retest Engine"
string GROUP_SMART_MONEY = "13. Smart Money Engine"
string GROUP_LIQUIDITY_SWEEPS = "14. Liquidity Sweeps"
string GROUP_FAIR_VALUE_GAPS = "15. Fair Value Gaps"
