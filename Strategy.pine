//============================================================================== 
// 4. STATE MODELS
//============================================================================== 
type SessionEngineState
    SessionName currentSession
    bool isActive
    bool justStarted
    bool justEnded
    int startTime
    int durationMinutes
    int barsInSession
    float progressPercent
    int barsRemaining

type OpeningRangeState
    float high
    float low
    float mid
    float width
    float atrRatio
    float percent
    float ticks
    int startTime
    int endTime
    int bars
    bool isBuilding
    bool isComplete
    bool qualityAccepted

type TradeControlState
    bool tradeTaken
    bool longTaken
    bool shortTaken
    bool sessionLocked

type SessionStatistics
    int sessions
    float totalRange
    float largestRange
    float smallestRange
    float totalAtrRatio
    int breakouts
    int falseBreakouts
    int successfulBreakouts

type TrendEngineState
    TrendDirection direction
    TrendStrength strength
    MarketStructure structure
    float score
    float fastEma
    float slowEma
    float htfFastEma
    float htfSlowEma
    float vwapValue
    float vwapDistance
    float vwapSlope
    float adx
    float plusDi
    float minusDi
    float swingHigh
    float swingLow
    bool structureBreak
    bool isTrending

type BreakoutEngineState
    BreakoutState state
    int direction
    float price
    float score
    BreakoutStrength strength
    float distance
    float distancePercent
    float distanceAtr
    bool attempted
    bool confirmed
    bool failed
    int barIndex
    int failureBars

type FvgZone
    TradeDirection direction
    float top
    float bottom
    float midpoint
    int creationBar
    bool active
    bool partiallyMitigated
    bool fullyMitigated

type OrderBlockZone
    TradeDirection direction
    float top
    float bottom
    float midpoint
    int creationBar
    int sourceBar
    bool active
    bool mitigated
    bool invalidated

