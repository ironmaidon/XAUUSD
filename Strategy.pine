bool showTradeBiasBackground = input.bool(false, "Show trade bias background", group = GROUP_TRADE_SCORING_VISUALS)
bool showRawVsAdjustedScore = input.bool(true, "Show raw vs adjusted score", group = GROUP_TRADE_SCORING_VISUALS)

//============================================================================== 
// 4. STATE MODELS
//============================================================================== 
type SessionEngineState
    SessionName currentSession
    bool isActive
    bool justStarted
    bool justEnded
    int startTime
    int durationMinutes
    int barsInSession
    float progressPercent
    int barsRemaining

type OpeningRangeState
    float high
    float low
    float mid
    float width
    float atrRatio
    float percent
    float ticks
    int startTime
    int endTime
    int bars
    bool isBuilding
    bool isComplete
    bool qualityAccepted

type TradeControlState
    bool tradeTaken
    bool longTaken
    bool shortTaken
    bool sessionLocked

type SessionStatistics
    int sessions
    float totalRange
    float largestRange
    float smallestRange
    float totalAtrRatio
    int breakouts
    int falseBreakouts
    int successfulBreakouts

type TrendEngineState
    TrendDirection direction
    TrendStrength strength
    MarketStructure structure
    float score
    float fastEma
    float slowEma
    float htfFastEma
    float htfSlowEma
    float vwapValue
    float vwapDistance
    float vwapSlope
    float adx
    float plusDi
    float minusDi
    float swingHigh
    float swingLow
    bool structureBreak
    bool isTrending

type BreakoutEngineState
    BreakoutState state
    int direction
    float price
    float score
    BreakoutStrength strength
    float distance
    float distancePercent
    float distanceAtr
