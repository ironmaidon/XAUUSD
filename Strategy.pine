bool fvgHistoryAvailable = bar_index >= 2
float bullishFvgBottomCandidate = fvgHistoryAvailable ? high[2] : na
float bullishFvgTopCandidate = fvgHistoryAvailable ? low : na
float bearishFvgBottomCandidate = fvgHistoryAvailable ? high : na
float bearishFvgTopCandidate = fvgHistoryAvailable ? low[2] : na
