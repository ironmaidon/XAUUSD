//============================================================================== 
// 5. UTILITY FUNCTIONS
//============================================================================== 
// Returns a TradingView session specification from two HHMM input values.
BuildSession(string startValue, string endValue) =>
    startValue + "-" + endValue

// Returns true when the current chart bar belongs to the supplied session.
IsInSession(string sessionSpec, string timezone) =>
    not na(time(timeframe.period, sessionSpec, timezone))

// Returns a readable name for a session enum value.
SessionText(SessionName sessionName) =>
    switch sessionName
        SessionName.Asia => "Asia"
        SessionName.London => "London"
        SessionName.NewYork => "New York"
        SessionName.Custom => "Custom"
        => "None"

// Returns a readable name for a breakout-state enum value.
StateText(BreakoutState state) =>
    switch state
        BreakoutState.BullishCandidate => "Bullish Candidate"
        BreakoutState.BearishCandidate => "Bearish Candidate"
        BreakoutState.BullishConfirmed => "Bullish Confirmed"
        BreakoutState.BearishConfirmed => "Bearish Confirmed"
        BreakoutState.BullishFailed => "Bullish Failed"
        BreakoutState.BearishFailed => "Bearish Failed"
        BreakoutState.Invalidated => "Invalidated"
        => "None"

// Returns a display label for an M4 breakout direction.
BreakoutDirectionText(TradeDirection direction) =>
    direction == TradeDirection.Long ? "Bullish" : direction == TradeDirection.Short ? "Bearish" : "None"

// Returns a display label for every M4 breakout-strength enum member.
BreakoutStrengthText(BreakoutStrength strength) =>
    strength == BreakoutStrength.Extreme ? "Extreme" : strength == BreakoutStrength.Strong ? "Strong" : strength == BreakoutStrength.Normal ? "Normal" : "Weak"

// Returns a display label for every M5 retest-state enum member.
RetestStateText(RetestState state) =>
    state == RetestState.WaitingForRetest ? "Waiting" : state == RetestState.RetestDetected ? "Detected" : state == RetestState.RetestConfirmed ? "Confirmed" : state == RetestState.RetestFailed ? "Failed" : state == RetestState.Expired ? "Expired" : "None"

// Returns a display label for an M5 retest direction.
RetestDirectionText(TradeDirection direction) =>
    direction == TradeDirection.Long ? "Bullish" : direction == TradeDirection.Short ? "Bearish" : "None"

LiquiditySourceText(series LiquiditySource source) =>
    source == LiquiditySource.EqualHigh ? "Equal High" : source == LiquiditySource.EqualLow ? "Equal Low" : source == LiquiditySource.PreviousDayHigh ? "PDH" : source == LiquiditySource.PreviousDayLow ? "PDL" : source == LiquiditySource.PreviousWeekHigh ? "PWH" : source == LiquiditySource.PreviousWeekLow ? "PWL" : source == LiquiditySource.SwingHigh ? "Swing High" : source == LiquiditySource.SwingLow ? "Swing Low" : source == LiquiditySource.OpeningRangeHigh ? "OR High" : source == LiquiditySource.OpeningRangeLow ? "OR Low" : "None"

SweepStrengthText(series SweepStrength strength) =>
    strength == SweepStrength.Extreme ? "Extreme" : strength == SweepStrength.Strong ? "Strong" : strength == SweepStrength.Normal ? "Normal" : "Weak"

PremiumDiscountText(series PremiumDiscountState state) =>
    state == PremiumDiscountState.Premium ? "Premium" : state == PremiumDiscountState.Discount ? "Discount" : state == PremiumDiscountState.Equilibrium ? "Equilibrium" : "Unknown"

SmartMoneyBiasText(series SmartMoneyBias bias) =>
    bias == SmartMoneyBias.Bullish ? "Bullish" : bias == SmartMoneyBias.Bearish ? "Bearish" : "Neutral"

SmartMoneyStrengthText(series SmartMoneyStrength strength) =>
    strength == SmartMoneyStrength.Extreme ? "Extreme" : strength == SmartMoneyStrength.Strong ? "Strong" : strength == SmartMoneyStrength.Normal ? "Normal" : "Weak"

// Returns a readable label for every M7 setup-lifecycle state.
TradeSetupStateText(series TradeSetupState state) =>
    state == TradeSetupState.BullishQualified ? "Bullish Qualified" : state == TradeSetupState.BearishQualified ? "Bearish Qualified" : state == TradeSetupState.Conflict ? "Conflict" : state == TradeSetupState.Disqualified ? "Disqualified" : state == TradeSetupState.Expired ? "Expired" : "None"

// Returns a readable label for the M7-owned final trade bias.
TradeBiasText(series TradeBias bias) =>
    bias == TradeBias.Bullish ? "Bullish" : bias == TradeBias.Bearish ? "Bearish" : bias == TradeBias.Neutral ? "Neutral" : "None"

// Returns a readable label for every M7 setup-strength classification.
TradeSetupStrengthText(series TradeSetupStrength strength) =>
    strength == TradeSetupStrength.Extreme ? "Extreme" : strength == TradeSetupStrength.Strong ? "Strong" : strength == TradeSetupStrength.Normal ? "Normal" : "Weak"

// Returns a readable label for an M9-E realized-trade outcome.
TradeOutcomeText(series TradeOutcome outcome) =>
    outcome == TradeOutcome.Win ? "Win" : outcome == TradeOutcome.Loss ? "Loss" : outcome == TradeOutcome.Breakeven ? "Breakeven" : "None"

// Returns a readable label for the final known M9 exit context.
TradeExitReasonText(series TradeExitReason reason) =>
    reason == TradeExitReason.TP1 ? "TP1" : reason == TradeExitReason.TP2 ? "TP2" : reason == TradeExitReason.InitialStop ? "Initial Stop" : reason == TradeExitReason.Breakeven ? "Breakeven" : reason == TradeExitReason.TrailingStop ? "Trailing Stop" : reason == TradeExitReason.Other ? "Other" : "None"

// Returns a readable label for the M9 source that last improved the stop.
ActiveStopModeText(series ActiveStopMode mode) =>
    mode == ActiveStopMode.Breakeven ? "Breakeven" : mode == ActiveStopMode.ATRTrail ? "ATR Trail" : mode == ActiveStopMode.Chandelier ? "Chandelier" : mode == ActiveStopMode.SuperTrend ? "SuperTrend" : mode == ActiveStopMode.Swing ? "Swing" : "Initial"

// Formats a nullable decimal value for the dashboard without displaying na.
FormatValueOrDash(float value) =>
    na(value) ? "-" : str.tostring(value, "#.##")

// Formats a nullable integer value for the dashboard without displaying na.
FormatIntOrDash(int value) =>
    na(value) ? "-" : str.tostring(value)

// Prevents division-by-zero while preserving a caller supplied fallback value.
SafeDivide(float numerator, float denominator, float fallback) =>
    denominator != 0.0 ? numerator / denominator : fallback

// Formats a price using the chart symbol's minimum tick size.
FormatPrice(float price) =>
    na(price) ? "n/a" : str.tostring(price, format.mintick)

// Formats a decimal number as a concise percentage string.
FormatPercent(float value) =>
    na(value) ? "n/a" : str.tostring(value, "#.##") + "%"

// Converts the opening-range input selection into an integer minute duration.
OpeningRangeMinutes() =>
    int(str.tonumber(openingRangeLength))

// Converts a HHMM session input into minutes since midnight.
MinutesFromHhmm(string timeValue) =>
    int hours = int(str.tonumber(str.substring(timeValue, 0, 2)))
    int minutes = int(str.tonumber(str.substring(timeValue, 2, 4)))
    hours * 60 + minutes

// Returns the configured duration for one session, including midnight crossings.
SessionDurationMinutes(SessionName sessionName) =>
    string startValue = sessionName == SessionName.Asia ? asiaStart : sessionName == SessionName.London ? londonStart : sessionName == SessionName.NewYork ? newYorkStart : customStart
    string endValue = sessionName == SessionName.Asia ? asiaEnd : sessionName == SessionName.London ? londonEnd : sessionName == SessionName.NewYork ? newYorkEnd : customEnd
    int startMinutes = MinutesFromHhmm(startValue)
    int endMinutes = MinutesFromHhmm(endValue)
    int rawDuration = endMinutes - startMinutes
    rawDuration > 0 ? rawDuration : rawDuration + 1440

// Selects one current session with stable priority: Asia, London, New York, Custom.
CurrentSession() =>
    bool asiaActive = asiaEnabled and IsInSession(BuildSession(asiaStart, asiaEnd), asiaTimezone)
    bool londonActive = londonEnabled and IsInSession(BuildSession(londonStart, londonEnd), londonTimezone)
    bool newYorkActive = newYorkEnabled and IsInSession(BuildSession(newYorkStart, newYorkEnd), newYorkTimezone)
    bool customActive = customEnabled and IsInSession(BuildSession(customStart, customEnd), customTimezone)
    asiaActive ? SessionName.Asia : londonActive ? SessionName.London : newYorkActive ? SessionName.NewYork : customActive ? SessionName.Custom : SessionName.None

// Returns a concise label for a trend direction.
TrendDirectionText(TrendDirection direction) =>
    direction == TrendDirection.Bullish ? "Bullish" : direction == TrendDirection.Bearish ? "Bearish" : "Neutral"

// Returns a concise label for the calculated trend strength.
TrendStrengthText(TrendStrength strength) =>
    strength == TrendStrength.Strong ? "Strong" : strength == TrendStrength.Moderate ? "Moderate" : "Weak"

// Returns a concise label for the latest confirmed market-structure event.
MarketStructureText(MarketStructure structure) =>
    structure == MarketStructure.HigherHigh ? "Higher High" : structure == MarketStructure.HigherLow ? "Higher Low" : structure == MarketStructure.LowerHigh ? "Lower High" : structure == MarketStructure.LowerLow ? "Lower Low" : "Neutral"

// Returns the current normalized direction computed by the Trend Engine.
GetTrendDirection() =>
    trendState.direction

// Returns the current normalized 0-100 trend score.
GetTrendScore() =>
    trendState.score

// Returns true only when the normalized Trend Engine direction is bullish.
IsBullTrend() =>
    GetTrendDirection() == TrendDirection.Bullish

// Returns true only when the normalized Trend Engine direction is bearish.
IsBearTrend() =>
    GetTrendDirection() == TrendDirection.Bearish

// Returns true when ADX is at or above the configured trending threshold.
IsTrending() =>
    trendState.isTrending

// Returns true when ADX is below the configured trending threshold.
IsRanging() =>
    not IsTrending()

// Returns the latest confirmed pivot-based market-structure classification.
GetMarketStructure() =>
    trendState.structure

//==============================================================================
// 6. TREND ENGINE
//==============================================================================
var float priorSwingHigh = na
var float priorSwingLow = na

// Calculates updated swing values without mutating persistent global state.
CalculateMarketStructure(float previousHigh, float previousLow, float currentHigh, float currentLow, MarketStructure currentStructure, float pivotHigh, float pivotLow) =>
    float nextPreviousHigh = previousHigh
    float nextPreviousLow = previousLow
    float nextCurrentHigh = currentHigh
    float nextCurrentLow = currentLow
    MarketStructure nextStructure = currentStructure
    if not na(pivotHigh)
        nextPreviousHigh := currentHigh
        nextCurrentHigh := pivotHigh
        if not na(nextPreviousHigh)
            nextStructure := pivotHigh > nextPreviousHigh ? MarketStructure.HigherHigh : MarketStructure.LowerHigh
    if not na(pivotLow)
        nextPreviousLow := currentLow
        nextCurrentLow := pivotLow
        if not na(nextPreviousLow)
            nextStructure := pivotLow > nextPreviousLow ? MarketStructure.HigherLow : MarketStructure.LowerLow
    bool breaksHigh = not na(nextPreviousHigh) and ta.crossover(close, nextPreviousHigh)
    bool breaksLow = not na(nextPreviousLow) and ta.crossunder(close, nextPreviousLow)
    [nextPreviousHigh, nextPreviousLow, nextCurrentHigh, nextCurrentLow, nextStructure, breaksHigh or breaksLow]

// Calculates one bounded, pivot-confirmed equal-level cluster without mutating global state.
// Pivot values are delayed by the M3 right-side confirmation length and do not repaint once received.
CalculateEqualLevelState(bool enabled, bool isHighLevel, float previousLevel, int previousTouches, int previousLastBar, float confirmedPivot, int pivotBarIndex, float tolerance, bool toleranceValid, int minimumTouches, int maximumAge, float currentHigh, float currentLow) =>
    float nextLevel = previousLevel
    int nextTouches = previousTouches
    int nextLastBar = previousLastBar
    bool hasLevel = not na(nextLevel)
    bool expired = hasLevel and not na(nextLastBar) and bar_index - nextLastBar > maximumAge
    bool invalidated = hasLevel and toleranceValid and (isHighLevel ? currentHigh > nextLevel + tolerance : currentLow < nextLevel - tolerance)
    if not enabled or expired or invalidated
        nextLevel := na
        nextTouches := 0
        nextLastBar := na
    if enabled and not na(confirmedPivot)
        if na(nextLevel)
            nextLevel := confirmedPivot
            nextTouches := 1
            nextLastBar := pivotBarIndex
        else if toleranceValid and math.abs(confirmedPivot - nextLevel) <= tolerance
            nextLevel := (nextLevel * nextTouches + confirmedPivot) / (nextTouches + 1)
            nextTouches += 1
            nextLastBar := pivotBarIndex
        else
            nextLevel := confirmedPivot
            nextTouches := 1
            nextLastBar := pivotBarIndex
    bool active = enabled and toleranceValid and not na(nextLevel) and nextTouches >= minimumTouches and not na(nextLastBar) and bar_index - nextLastBar <= maximumAge
    [nextLevel, nextTouches, nextLastBar, active]

// Converts one sweep penetration input to price units without introducing a new ATR calculation.
CalculateSweepPenetration(float level, float inputValue, RetestDistanceMode mode, float atrValue) =>
    na(level) ? na : mode == RetestDistanceMode.Ticks ? inputValue * syminfo.mintick : mode == RetestDistanceMode.Atr ? atrValue * inputValue : math.abs(level) * inputValue * 0.01

// Returns true when a completed candle sweeps sell-side liquidity and rejects upward.
IsBullishSweepAtLevel(float level, float minimumInput, float maximumInput, RetestDistanceMode mode, float atrValue, bool requireCloseBack, bool requireRejectionWick, float minimumWickPercent, float lowPrice, float closePrice, float wickPercent) =>
    float minimumPenetration = CalculateSweepPenetration(level, minimumInput, mode, atrValue)
    float maximumPenetration = CalculateSweepPenetration(level, maximumInput, mode, atrValue)
    float penetration = not na(level) ? level - lowPrice : na
    bool boundsValid = not na(minimumPenetration) and not na(maximumPenetration) and minimumPenetration <= maximumPenetration
    bool penetrationValid = not na(penetration) and penetration > 0.0 and penetration >= minimumPenetration and penetration <= maximumPenetration
    bool closeBackValid = not requireCloseBack or (not na(level) and closePrice > level)
    bool rejectionWickValid = not requireRejectionWick or wickPercent >= minimumWickPercent
    not na(level) and boundsValid and penetrationValid and closeBackValid and rejectionWickValid

// Returns true when a completed candle sweeps buy-side liquidity and rejects downward.
IsBearishSweepAtLevel(float level, float minimumInput, float maximumInput, RetestDistanceMode mode, float atrValue, bool requireCloseBack, bool requireRejectionWick, float minimumWickPercent, float highPrice, float closePrice, float wickPercent) =>
    float minimumPenetration = CalculateSweepPenetration(level, minimumInput, mode, atrValue)
    float maximumPenetration = CalculateSweepPenetration(level, maximumInput, mode, atrValue)
    float penetration = not na(level) ? highPrice - level : na
    bool boundsValid = not na(minimumPenetration) and not na(maximumPenetration) and minimumPenetration <= maximumPenetration
    bool penetrationValid = not na(penetration) and penetration > 0.0 and penetration >= minimumPenetration and penetration <= maximumPenetration
    bool closeBackValid = not requireCloseBack or (not na(level) and closePrice < level)
    bool rejectionWickValid = not requireRejectionWick or wickPercent >= minimumWickPercent
    not na(level) and boundsValid and penetrationValid and closeBackValid and rejectionWickValid

// Classifies accepted sweep context from bounded penetration, wick quality, close-back, and source significance.
CalculateSweepStrength(float penetration, float maximumPenetration, float wickPercent, bool closeBack, LiquiditySource source) =>
    float penetrationRatio = not na(penetration) and maximumPenetration > 0.0 ? math.min(math.max(penetration / maximumPenetration, 0.0), 1.0) : 0.0
    float sourceScore = source == LiquiditySource.EqualHigh or source == LiquiditySource.EqualLow ? 30.0 : source == LiquiditySource.PreviousDayHigh or source == LiquiditySource.PreviousDayLow ? 25.0 : source == LiquiditySource.PreviousWeekHigh or source == LiquiditySource.PreviousWeekLow ? 25.0 : source == LiquiditySource.SwingHigh or source == LiquiditySource.SwingLow ? 15.0 : source == LiquiditySource.OpeningRangeHigh or source == LiquiditySource.OpeningRangeLow ? 10.0 : 0.0
    float score = sourceScore + penetrationRatio * 25.0 + math.min(math.max(wickPercent, 0.0), 100.0) * 0.25 + (closeBack ? 20.0 : 0.0)
    score >= 85.0 ? SweepStrength.Extreme : score >= 65.0 ? SweepStrength.Strong : score >= 40.0 ? SweepStrength.Normal : SweepStrength.Weak

// Returns the non-negative distance from a price to an FVG zone, or na for invalid bounds.
DistanceToFvgZone(float price, float top, float bottom) =>
    na(price) or na(top) or na(bottom) or top < bottom ? na : price > top ? price - top : price < bottom ? bottom - price : 0.0

// Calculates the normalized trend values without mutating persistent global state.
CalculateTrendState(float fastEma, float slowEma, float htfFastEma, float htfSlowEma, float vwapValue, float priorVwapValue, float adxValue, float plusDiValue, float minusDiValue, MarketStructure structure) =>
    float vwapDistance = close - vwapValue
    float vwapSlope = vwapValue - priorVwapValue
    bool trending = adxValue >= adxTrendThreshold
    bool emaBullish = emaFilterEnabled and fastEma > slowEma
    bool emaBearish = emaFilterEnabled and fastEma < slowEma
    bool htfBullish = emaFilterEnabled and htfFastEma > htfSlowEma
    bool htfBearish = emaFilterEnabled and htfFastEma < htfSlowEma
    bool vwapBullish = vwapFilterEnabled and close > vwapValue
    bool vwapBearish = vwapFilterEnabled and close < vwapValue
    bool structureBullish = structure == MarketStructure.HigherHigh or structure == MarketStructure.HigherLow
    bool structureBearish = structure == MarketStructure.LowerHigh or structure == MarketStructure.LowerLow

    float bullScore = (emaBullish ? 30.0 : 0.0) + (htfBullish ? 25.0 : 0.0) + (vwapBullish ? 15.0 : 0.0) + (trending and plusDiValue > minusDiValue ? 20.0 : 0.0) + (structureBullish ? 10.0 : 0.0)
    float bearScore = (emaBearish ? 30.0 : 0.0) + (htfBearish ? 25.0 : 0.0) + (vwapBearish ? 15.0 : 0.0) + (trending and minusDiValue > plusDiValue ? 20.0 : 0.0) + (structureBearish ? 10.0 : 0.0)
    float score = math.max(bullScore, bearScore)
    TrendDirection direction = bullScore > bearScore ? TrendDirection.Bullish : bearScore > bullScore ? TrendDirection.Bearish : TrendDirection.Neutral
    TrendStrength strength = score >= 70.0 ? TrendStrength.Strong : score >= 45.0 ? TrendStrength.Moderate : TrendStrength.Weak
    [direction, strength, score, vwapDistance, vwapSlope, trending]

//============================================================================== 
// 6. SESSION ENGINE
//============================================================================== 
// Calculates session lifecycle fields without mutating persistent global state.
CalculateSessionState(SessionEngineState previousState) =>
    SessionName activeSession = CurrentSession()
    bool activeNow = activeSession != SessionName.None
    bool sessionChanged = activeNow and activeSession != previousState.currentSession
    bool justEnded = previousState.isActive and (not activeNow or sessionChanged)
    int startTime = sessionChanged ? time : previousState.startTime
    int durationMinutes = activeNow ? (sessionChanged ? SessionDurationMinutes(activeSession) : previousState.durationMinutes) : 0
    int barsInSession = sessionChanged ? 1 : activeNow ? previousState.barsInSession + 1 : 0
    float elapsedMilliseconds = activeNow ? time - startTime : 0.0
    float durationMilliseconds = durationMinutes * MILLISECONDS_PER_MINUTE
    float progressPercent = activeNow ? math.min(100.0, SafeDivide(elapsedMilliseconds * 100.0, durationMilliseconds, 0.0)) : 0.0
    float barMilliseconds = timeframe.in_seconds() * 1000.0
    int barsRemaining = activeNow ? math.max(0, int(math.ceil(SafeDivide(durationMilliseconds - elapsedMilliseconds, barMilliseconds, 0.0)))) : 0
    SessionEngineState.new(activeNow ? activeSession : SessionName.None, activeNow, sessionChanged, justEnded, startTime, durationMinutes, barsInSession, progressPercent, barsRemaining)

//============================================================================== 
// 7. OPENING RANGE ENGINE
//============================================================================== 
// Calculates the fresh session range and trade-control state.
CreateSessionRange() =>
    OpeningRangeState freshRange = OpeningRangeState.new(na, na, na, na, na, na, na, time, time + OpeningRangeMinutes() * MILLISECONDS_PER_MINUTE, 0, true, false, false)
    TradeControlState freshTradeControl = TradeControlState.new(false, false, false, false)
    int freshBreakoutDirection = 0
    float freshAtrAtCompletion = na
    [freshRange, freshTradeControl, freshBreakoutDirection, freshAtrAtCompletion, BreakoutState.None]

// Calculates the next opening-range state from one confirmed chart bar.
CalculateOpeningRange(OpeningRangeState previousRange, float atrValue) =>
    float nextHigh = previousRange.high
    float nextLow = previousRange.low
    int nextBars = previousRange.bars
    bool nextBuilding = previousRange.isBuilding
    bool nextComplete = previousRange.isComplete
    bool rangeBar = time < previousRange.endTime
    if previousRange.isBuilding and rangeBar
        nextHigh := na(nextHigh) ? high : math.max(nextHigh, high)
        nextLow := na(nextLow) ? low : math.min(nextLow, low)
        nextBars += 1
    float nextMid = not na(nextHigh) and not na(nextLow) ? (nextHigh + nextLow) * 0.5 : na
    float nextWidth = not na(nextHigh) and not na(nextLow) ? nextHigh - nextLow : na
    float nextAtrRatio = SafeDivide(nextWidth, atrValue, na)
    float nextPercent = SafeDivide(nextWidth * 100.0, nextMid, na)
    float nextTicks = SafeDivide(nextWidth, syminfo.mintick, na)
    float nextAtrAtCompletion = na
    BreakoutState rangeCompletionState = breakoutState
    bool nextQualityAccepted = previousRange.qualityAccepted
    if previousRange.isBuilding and not rangeBar
        nextBuilding := false
        nextComplete := true
        nextAtrAtCompletion := atrValue
        nextQualityAccepted := nextAtrRatio >= minimumAtrRatio and nextAtrRatio <= maximumAtrRatio
        rangeCompletionState := BreakoutState.None
    OpeningRangeState nextRange = OpeningRangeState.new(nextHigh, nextLow, nextMid, nextWidth, nextAtrRatio, nextPercent, nextTicks, previousRange.startTime, previousRange.endTime, nextBars, nextBuilding, nextComplete, nextQualityAccepted)
    [nextRange, nextAtrAtCompletion, rangeCompletionState]

// Calculates aggregate statistics after one completed opening range.
CalculateCompletedRangeStatistics(SessionStatistics previousStatistics, OpeningRangeState completedRange) =>
    SessionStatistics.new(previousStatistics.sessions + 1, previousStatistics.totalRange + completedRange.width, na(previousStatistics.largestRange) ? completedRange.width : math.max(previousStatistics.largestRange, completedRange.width), na(previousStatistics.smallestRange) ? completedRange.width : math.min(previousStatistics.smallestRange, completedRange.width), previousStatistics.totalAtrRatio + completedRange.atrRatio, previousStatistics.breakouts, previousStatistics.falseBreakouts, previousStatistics.successfulBreakouts)

//============================================================================== 
// 8. BREAKOUT STATE MACHINE
//============================================================================== 
// Calculates the next non-trading breakout state and associated statistics.
CalculateBreakoutState(OpeningRangeState currentRange, BreakoutState currentState, int currentDirection, SessionStatistics previousStatistics) =>
    BreakoutState nextState = currentState
    int nextDirection = currentDirection
    SessionStatistics nextStatistics = previousStatistics
    if currentRange.isComplete and sessionState.isActive and currentRange.qualityAccepted
        bool closesAbove = close > currentRange.high
        bool closesBelow = close < currentRange.low
        bool closesInside = close <= currentRange.high and close >= currentRange.low
        if currentState == BreakoutState.None and (closesAbove or closesBelow)
            nextDirection := closesAbove ? 1 : -1
            nextState := closesAbove ? BreakoutState.BullishCandidate : BreakoutState.BearishCandidate
        else if currentState == BreakoutState.BullishCandidate or currentState == BreakoutState.BearishCandidate
            bool confirms = nextDirection == 1 ? closesAbove : closesBelow
            if confirms
                nextState := nextDirection == 1 ? BreakoutState.BullishConfirmed : BreakoutState.BearishConfirmed
                nextStatistics := SessionStatistics.new(previousStatistics.sessions, previousStatistics.totalRange, previousStatistics.largestRange, previousStatistics.smallestRange, previousStatistics.totalAtrRatio, previousStatistics.breakouts + 1, previousStatistics.falseBreakouts, previousStatistics.successfulBreakouts + 1)
            else if closesInside
                nextState := BreakoutState.None
                nextDirection := 0
                nextStatistics := SessionStatistics.new(previousStatistics.sessions, previousStatistics.totalRange, previousStatistics.largestRange, previousStatistics.smallestRange, previousStatistics.totalAtrRatio, previousStatistics.breakouts, previousStatistics.falseBreakouts + 1, previousStatistics.successfulBreakouts)
        else if currentState == BreakoutState.BullishConfirmed or currentState == BreakoutState.BearishConfirmed
            bool fails = nextDirection == 1 ? close <= currentRange.high : close >= currentRange.low
            if fails
                nextState := nextDirection == 1 ? BreakoutState.BullishFailed : BreakoutState.BearishFailed
    [nextDirection, nextState, nextStatistics]

//============================================================================== 
// 9. DRAWING MANAGER
//============================================================================== 
var box rangeBox = na
var line rangeHighLine = na
var line rangeLowLine = na
var line rangeMidLine = na
var label rangeHighLabel = na
var label rangeLowLabel = na
var label rangeWidthLabel = na

// Creates drawing references for assignment from the main execution scope.
CreateRangeDrawings() =>
    box nextRangeBox = box.new(bar_index, close, bar_index, close, border_color = rangeColor, bgcolor = color.new(rangeColor, rangeTransparency))
    line nextRangeHighLine = line.new(bar_index, close, bar_index, close, color = rangeColor)
    line nextRangeLowLine = line.new(bar_index, close, bar_index, close, color = rangeColor)
    line nextRangeMidLine = line.new(bar_index, close, bar_index, close, color = color.new(rangeColor, 30), style = line.style_dashed)
    label nextRangeHighLabel = label.new(bar_index, close, "", style = label.style_label_left, color = color.new(rangeColor, 80), textcolor = color.white, size = size.tiny)
    label nextRangeLowLabel = label.new(bar_index, close, "", style = label.style_label_left, color = color.new(rangeColor, 80), textcolor = color.white, size = size.tiny)
    label nextRangeWidthLabel = label.new(bar_index, close, "", style = label.style_label_left, color = color.new(rangeColor, 80), textcolor = color.white, size = size.tiny)
    [nextRangeBox, nextRangeHighLine, nextRangeLowLine, nextRangeMidLine, nextRangeHighLabel, nextRangeLowLabel, nextRangeWidthLabel]

// Shows the latest opening range using reused box, line, and label objects.
UpdateRangeDrawings() =>
    bool hasRange = not na(rangeState.high) and not na(rangeState.low)
    int leftBar = math.max(0, bar_index - rangeState.bars + 1)
    if hasRange and showRangeBox
        box.set_lefttop(rangeBox, leftBar, rangeState.high)
        box.set_rightbottom(rangeBox, bar_index, rangeState.low)
        box.set_bgcolor(rangeBox, color.new(rangeColor, rangeTransparency))
        box.set_border_color(rangeBox, showRangeBorder ? rangeColor : color.new(rangeColor, 100))
    else
        box.set_bgcolor(rangeBox, color.new(rangeColor, 100))
        box.set_border_color(rangeBox, color.new(rangeColor, 100))
    if hasRange and showRangeLines
        line.set_xy1(rangeHighLine, leftBar, rangeState.high)
        line.set_xy2(rangeHighLine, bar_index, rangeState.high)
        line.set_xy1(rangeLowLine, leftBar, rangeState.low)
        line.set_xy2(rangeLowLine, bar_index, rangeState.low)
        line.set_xy1(rangeMidLine, leftBar, rangeState.mid)
        line.set_xy2(rangeMidLine, bar_index, rangeState.mid)
        line.set_color(rangeHighLine, rangeColor)
        line.set_color(rangeLowLine, rangeColor)
        line.set_color(rangeMidLine, color.new(rangeColor, 30))
    else
        line.set_color(rangeHighLine, color.new(rangeColor, 100))
        line.set_color(rangeLowLine, color.new(rangeColor, 100))
        line.set_color(rangeMidLine, color.new(rangeColor, 100))
    if hasRange and showRangeLabels
        label.set_xy(rangeHighLabel, bar_index, rangeState.high)
        label.set_text(rangeHighLabel, "OR High " + FormatPrice(rangeState.high))
        label.set_xy(rangeLowLabel, bar_index, rangeState.low)
        label.set_text(rangeLowLabel, "OR Low " + FormatPrice(rangeState.low))
        label.set_xy(rangeWidthLabel, bar_index, rangeState.mid)
        label.set_text(rangeWidthLabel, "Width " + FormatPrice(rangeState.width))
        label.set_color(rangeHighLabel, color.new(rangeColor, 80))
        label.set_color(rangeLowLabel, color.new(rangeColor, 80))
        label.set_color(rangeWidthLabel, color.new(rangeColor, 80))
    else
        label.set_color(rangeHighLabel, color.new(rangeColor, 100))
        label.set_color(rangeLowLabel, color.new(rangeColor, 100))
        label.set_color(rangeWidthLabel, color.new(rangeColor, 100))

//==============================================================================
// 10. TREND VISUALS
//==============================================================================
var label trendLabel = na

// Returns a display color for the current normalized trend direction.
TrendColor() =>
    IsBullTrend() ? color.lime : IsBearTrend() ? color.red : color.gray

// Calculates the reusable trend-label reference without mutating global state.
CalculateTrendLabel(label previousLabel) =>
    label nextLabel = previousLabel
    if showTrendLabel and barstate.islast
        string labelText = TrendDirectionText(GetTrendDirection()) + " " + str.tostring(GetTrendScore(), "#.##") + " / " + TrendStrengthText(trendState.strength)
        if na(nextLabel)
            nextLabel := label.new(bar_index, high, labelText, style = label.style_label_down, color = TrendColor(), textcolor = color.white, size = size.small)
        else
            label.set_xy(nextLabel, bar_index, high)
            label.set_text(nextLabel, labelText)
            label.set_color(nextLabel, TrendColor())
    else if not na(nextLabel)
        label.set_color(nextLabel, color.new(TrendColor(), 100))
    nextLabel

//============================================================================== 
// 11. DASHBOARD AND DEBUG
//============================================================================== 
var table dashboard = table.new(position.top_right, 2, 116, border_width = 1)
var table debugTable = table.new(position.bottom_right, 2, 6, border_width = 1)

// Writes one consistently styled dashboard row.
SetDashboardRow(table target, int row, string caption, string value) =>
    table.cell(target, 0, row, caption, text_color = color.silver, bgcolor = color.new(color.black, 15), text_size = size.small)
    table.cell(target, 1, row, value, text_color = color.white, bgcolor = color.new(color.black, 65), text_size = size.small)

// Updates the session dashboard only on the last chart bar.
UpdateDashboard() =>
    if barstate.islast
        if showDashboard
            SetDashboardRow(dashboard, 0, DASHBOARD_TITLE, "v" + STRATEGY_VERSION)
            SetDashboardRow(dashboard, 1, "Current session", SessionText(sessionState.currentSession))
            SetDashboardRow(dashboard, 2, "Current state", StateText(breakoutState))
            SetDashboardRow(dashboard, 3, "Range width", FormatPrice(rangeState.width))
            SetDashboardRow(dashboard, 4, "ATR ratio", str.tostring(rangeState.atrRatio, "#.##"))
            SetDashboardRow(dashboard, 5, "Session progress", FormatPercent(sessionState.progressPercent))
            SetDashboardRow(dashboard, 6, "Bars in session", str.tostring(sessionState.barsInSession))
            SetDashboardRow(dashboard, 7, "Bars remaining", str.tostring(sessionState.barsRemaining))
            SetDashboardRow(dashboard, 8, "Current trend", TrendDirectionText(GetTrendDirection()))
            SetDashboardRow(dashboard, 9, "Trend score", str.tostring(GetTrendScore(), "#.##"))
            SetDashboardRow(dashboard, 10, "EMA direction", trendState.fastEma > trendState.slowEma ? "Bullish" : trendState.fastEma < trendState.slowEma ? "Bearish" : "Neutral")
            SetDashboardRow(dashboard, 11, "HTF direction", trendState.htfFastEma > trendState.htfSlowEma ? "Bullish" : trendState.htfFastEma < trendState.htfSlowEma ? "Bearish" : "Neutral")
            SetDashboardRow(dashboard, 12, "VWAP status", close > trendState.vwapValue ? "Above" : close < trendState.vwapValue ? "Below" : "At VWAP")
            SetDashboardRow(dashboard, 13, "ADX", str.tostring(trendState.adx, "#.##"))
            SetDashboardRow(dashboard, 14, "Structure", MarketStructureText(GetMarketStructure()))
            SetDashboardRow(dashboard, 15, "Breakout state", StateText(breakoutState))
            SetDashboardRow(dashboard, 16, "Breakout direction", BreakoutDirectionText(breakoutTradeDirection))
            SetDashboardRow(dashboard, 17, "Breakout score", na(breakoutScore) ? "-" : str.tostring(breakoutScore, "#.##"))
            SetDashboardRow(dashboard, 18, "Breakout strength", BreakoutStrengthText(breakoutStrength))
            SetDashboardRow(dashboard, 19, "Distance ATR", na(breakoutDistanceATR) ? "-" : str.tostring(breakoutDistanceATR, "#.##"))
            SetDashboardRow(dashboard, 20, "Breakout attempted", breakoutAttempted ? "Yes" : "No")
            SetDashboardRow(dashboard, 21, "Breakout confirmed", breakoutConfirmed ? "Yes" : "No")
            SetDashboardRow(dashboard, 22, "Breakout failed", breakoutFailed ? "Yes" : "No")
            SetDashboardRow(dashboard, 23, "Retest state", RetestStateText(retestState))
            SetDashboardRow(dashboard, 24, "Retest direction", RetestDirectionText(retestTradeDirection))
            SetDashboardRow(dashboard, 25, "Retest level", na(retestLevel) ? "-" : FormatPrice(retestLevel))
            SetDashboardRow(dashboard, 26, "Retest score", FormatValueOrDash(retestScore))
            SetDashboardRow(dashboard, 27, "Retest attempts", str.tostring(retestAttemptCount))
            SetDashboardRow(dashboard, 28, "Retry pending", retestRetryPending ? "Yes" : "No")
            SetDashboardRow(dashboard, 29, "Bars since breakout", FormatIntOrDash(retestBarsSinceBreakout))
            SetDashboardRow(dashboard, 30, "Retest distance ATR", FormatValueOrDash(retestDistanceATR))
            SetDashboardRow(dashboard, 31, "Retest penetration ATR", FormatValueOrDash(retestPenetrationATR))
            SetDashboardRow(dashboard, 32, "Retest confirmed", retestConfirmed ? "Yes" : "No")
            SetDashboardRow(dashboard, 33, "Retest failed", retestFailed ? "Yes" : "No")
            SetDashboardRow(dashboard, 34, "Smart Money bias", smartMoneyBiasDashboardText)
            SetDashboardRow(dashboard, 35, "SMC strength", smartMoneyStrengthDashboardText)
            SetDashboardRow(dashboard, 36, "Bullish SMC score", showSmartMoneyScore ? FormatValueOrDash(bullishSmartMoneyScore) : "-")
            SetDashboardRow(dashboard, 37, "Bearish SMC score", showSmartMoneyScore ? FormatValueOrDash(bearishSmartMoneyScore) : "-")
            SetDashboardRow(dashboard, 38, "Liquidity sweep", bullishLiquiditySweep ? "Bullish" : bearishLiquiditySweep ? "Bearish" : "-")
            SetDashboardRow(dashboard, 39, "Sweep source", LiquiditySourceText(sweepSource))
            SetDashboardRow(dashboard, 40, "Sweep strength", SweepStrengthText(sweepStrength))
            SetDashboardRow(dashboard, 41, "Bullish FVG", latestBullishFvgActive ? "Active" : "-")
            SetDashboardRow(dashboard, 42, "Bearish FVG", latestBearishFvgActive ? "Active" : "-")
            SetDashboardRow(dashboard, 43, "Bullish OB", latestBullishObActive ? "Active" : "-")
            SetDashboardRow(dashboard, 44, "Bearish OB", latestBearishObActive ? "Active" : "-")
            SetDashboardRow(dashboard, 45, "Premium / Discount", PremiumDiscountText(premiumDiscountState))
            SetDashboardRow(dashboard, 46, "Equal high", equalHighActive ? "Active" : "-")
            SetDashboardRow(dashboard, 47, "Equal low", equalLowActive ? "Active" : "-")
            SetDashboardRow(dashboard, 48, "PDH / PDL", priceAbovePDH ? "Above PDH" : priceBelowPDL ? "Below PDL" : "Between")
            SetDashboardRow(dashboard, 49, "PWH / PWL", priceAbovePWH ? "Above PWH" : priceBelowPWL ? "Below PWL" : "Between")
            SetDashboardRow(dashboard, 50, "Trade setup state", tradeSetupStateDashboardText)
            SetDashboardRow(dashboard, 51, "Trade bias", tradeBiasDashboardText)
            SetDashboardRow(dashboard, 52, "Setup strength", tradeSetupStrengthDashboardText)
            SetDashboardRow(dashboard, 53, "Setup score", FormatValueOrDash(tradeSetupScore))
            SetDashboardRow(dashboard, 54, "Bullish raw score", showRawVsAdjustedScore ? FormatValueOrDash(bullishTradeScoreRawDisplay) : "-")
            SetDashboardRow(dashboard, 55, "Bearish raw score", showRawVsAdjustedScore ? FormatValueOrDash(bearishTradeScoreRawDisplay) : "-")
            SetDashboardRow(dashboard, 56, "Bullish adjusted score", showRawVsAdjustedScore ? FormatValueOrDash(bullishTradeScore) : "-")
            SetDashboardRow(dashboard, 57, "Bearish adjusted score", showRawVsAdjustedScore ? FormatValueOrDash(bearishTradeScore) : "-")
            SetDashboardRow(dashboard, 58, "Bullish penalty", showRawVsAdjustedScore ? FormatValueOrDash(bullishTradePenaltyDisplay) : "-")
            SetDashboardRow(dashboard, 59, "Bearish penalty", showRawVsAdjustedScore ? FormatValueOrDash(bearishTradePenaltyDisplay) : "-")
            SetDashboardRow(dashboard, 60, "Bullish mandatory gates", bullishMandatoryGateDisplay ? "Pass" : "Fail")
            SetDashboardRow(dashboard, 61, "Bearish mandatory gates", bearishMandatoryGateDisplay ? "Pass" : "Fail")
            SetDashboardRow(dashboard, 62, "Bullish candidate", bullishTradeCandidateDisplay ? "Yes" : "No")
            SetDashboardRow(dashboard, 63, "Bearish candidate", bearishTradeCandidateDisplay ? "Yes" : "No")
            SetDashboardRow(dashboard, 64, "Bullish qualified", bullishTradeQualified ? "Yes" : "No")
            SetDashboardRow(dashboard, 65, "Bearish qualified", bearishTradeQualified ? "Yes" : "No")
            SetDashboardRow(dashboard, 66, "Directional score difference", FormatValueOrDash(tradeScoreDifferenceDisplay))
            SetDashboardRow(dashboard, 67, "Risk context active", riskContextActive ? "Yes" : "No")
            SetDashboardRow(dashboard, 68, "Risk direction", riskDirectionDashboardText)
            SetDashboardRow(dashboard, 69, "Risk entry", FormatValueOrDash(riskEntryPrice))
            SetDashboardRow(dashboard, 70, "Risk stop", FormatValueOrDash(riskStopPrice))
            SetDashboardRow(dashboard, 71, "Stop source", riskStopSourceDashboardText)
            SetDashboardRow(dashboard, 72, "Risk distance ATR", FormatValueOrDash(riskDistanceATR))
            SetDashboardRow(dashboard, 73, "Sizing equity", FormatValueOrDash(riskSizingEquity))
            SetDashboardRow(dashboard, 74, "Target cash risk", FormatValueOrDash(riskCashAmount))
            SetDashboardRow(dashboard, 75, "Position quantity", FormatValueOrDash(riskQuantity))
            SetDashboardRow(dashboard, 76, "Actual cash risk", FormatValueOrDash(riskActualCashAmount))
            SetDashboardRow(dashboard, 77, "Actual risk %", FormatValueOrDash(riskActualPercent))
            SetDashboardRow(dashboard, 78, "TP1", FormatValueOrDash(riskTP1))
            SetDashboardRow(dashboard, 79, "TP2", FormatValueOrDash(riskTP2))
            SetDashboardRow(dashboard, 80, "RR1", FormatValueOrDash(riskRR1))
            SetDashboardRow(dashboard, 81, "RR2", FormatValueOrDash(riskRR2))
            SetDashboardRow(dashboard, 82, "Base risk approved", baseRiskApproved ? "Yes" : "No")
            SetDashboardRow(dashboard, 83, "Final risk approved", riskApproved ? "Yes" : "No")
            SetDashboardRow(dashboard, 84, "Daily allocated risk %", FormatValueOrDash(dailyAllocatedRiskPercent))
            SetDashboardRow(dashboard, 85, "Daily P/L %", FormatValueOrDash(dailyPnLPercent))
            SetDashboardRow(dashboard, 86, "Daily approved setups", str.tostring(dailyApprovedSetupCount))
            SetDashboardRow(dashboard, 87, "Session allocated risk %", FormatValueOrDash(sessionAllocatedRiskPercent))
            SetDashboardRow(dashboard, 88, "Session approved setups", str.tostring(sessionApprovedSetupCount))
            SetDashboardRow(dashboard, 89, "Consecutive losses", str.tostring(consecutiveLossCount))
            SetDashboardRow(dashboard, 90, "Risk guard pass", riskGuardPass ? "Yes" : "No")
            SetDashboardRow(dashboard, 91, "Risk block reason", riskBlockReasonDashboardText)
            SetDashboardRow(dashboard, 92, "Trade active", tradeActive ? "Yes" : "No")
            SetDashboardRow(dashboard, 93, "Active direction", TradeBiasText(activeTradeDirection))
            SetDashboardRow(dashboard, 94, "Planned entry", FormatValueOrDash(tradePlannedEntry))
            SetDashboardRow(dashboard, 95, "Actual entry", FormatValueOrDash(tradeActualEntry))
            SetDashboardRow(dashboard, 96, "Initial stop", FormatValueOrDash(tradeInitialStop))
            SetDashboardRow(dashboard, 97, "Effective stop", FormatValueOrDash(tradeEffectiveStop))
            SetDashboardRow(dashboard, 98, "Active stop mode", ActiveStopModeText(activeStopMode))
            SetDashboardRow(dashboard, 99, "Trade TP1", FormatValueOrDash(tradeTP1))
            SetDashboardRow(dashboard, 100, "Trade TP2", FormatValueOrDash(tradeTP2))
            SetDashboardRow(dashboard, 101, "TP1 hit", tradeTP1Hit ? "Yes" : "No")
            SetDashboardRow(dashboard, 102, "TP2 hit", tradeTP2Hit ? "Yes" : "No")
            SetDashboardRow(dashboard, 103, "Breakeven active", breakevenActivated ? "Yes" : "No")
            SetDashboardRow(dashboard, 104, "Trailing active", trailingActivated ? "Yes" : "No")
            SetDashboardRow(dashboard, 105, "Remaining quantity", FormatValueOrDash(tradeRemainingQuantity))
            SetDashboardRow(dashboard, 106, "Last trade outcome", TradeOutcomeText(lastTradeOutcome))
            SetDashboardRow(dashboard, 107, "Last trade profit", FormatValueOrDash(lastTradeProfit))
            SetDashboardRow(dashboard, 108, "Last trade R", FormatValueOrDash(lastTradeRMultiple))
            SetDashboardRow(dashboard, 109, "Last exit reason", TradeExitReasonText(lastTradeExitReason))
            SetDashboardRow(dashboard, 110, "Daily executed trades", str.tostring(dailyExecutedTradeCount))
            SetDashboardRow(dashboard, 111, "Session executed trades", str.tostring(sessionExecutedTradeCount))
            SetDashboardRow(dashboard, 112, "Total executed trades", str.tostring(totalExecutedTradeCount))
            SetDashboardRow(dashboard, 113, "Daily realized P/L", FormatValueOrDash(dailyRealizedTradeProfit))
            SetDashboardRow(dashboard, 114, "Session realized P/L", FormatValueOrDash(sessionRealizedTradeProfit))
            SetDashboardRow(dashboard, 115, "Last trade P/L %", FormatPercent(lastTradeProfitPercent))
        else
            table.clear(dashboard, 0, 0, 1, 115)

// Updates the diagnostic panel only on the last chart bar when debugging is enabled.
UpdateDebugPanel() =>
    if barstate.islast
        if debugEnabled
            SetDashboardRow(debugTable, 0, "DEBUG", "v" + STRATEGY_VERSION)
            SetDashboardRow(debugTable, 1, "Session", SessionText(sessionState.currentSession))
            SetDashboardRow(debugTable, 2, "State", StateText(breakoutState))
            SetDashboardRow(debugTable, 3, "Range high", FormatPrice(rangeState.high))
            SetDashboardRow(debugTable, 4, "Range low", FormatPrice(rangeState.low))
            SetDashboardRow(debugTable, 5, "ATR / bars", str.tostring(rangeState.atrRatio, "#.##") + " / " + str.tostring(sessionState.barsInSession))
        else
            table.clear(debugTable, 0, 0, 1, 5)

//============================================================================== 
// 12. ORCHESTRATION
//============================================================================== 
float atrValue = ta.atr(ATR_LENGTH)
float breakoutBuffer = na(rangeState.high) or na(rangeState.low) ? na : breakoutBufferMode == BreakoutBufferMode.Ticks ? breakoutBufferValue * syminfo.mintick : breakoutBufferMode == BreakoutBufferMode.Percentage ? rangeState.mid * breakoutBufferValue * 0.01 : atrValue * breakoutBufferValue
float bullishBreakoutThreshold = na(rangeState.high) or na(breakoutBuffer) ? na : rangeState.high + breakoutBuffer
float bearishBreakoutThreshold = na(rangeState.low) or na(breakoutBuffer) ? na : rangeState.low - breakoutBuffer
float candleRange = high - low
float safeCandleRange = math.max(candleRange, syminfo.mintick)
float candleBody = math.abs(close - open)
float bodyPercent = candleBody * 100.0 / safeCandleRange
float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low
float upperWickPercent = upperWick * 100.0 / safeCandleRange
float lowerWickPercent = lowerWick * 100.0 / safeCandleRange
float bullishClosePosition = (close - low) * 100.0 / safeCandleRange
float bearishClosePosition = (high - close) * 100.0 / safeCandleRange
bool bullishBreakoutSignal = false
bool bearishBreakoutSignal = false
bool bullishBreakoutFailure = false
bool bearishBreakoutFailure = false
bool bullishCandleQuality = close > open and bodyPercent >= minimumBodyPercent and upperWickPercent <= maximumRejectionWickPercent and bullishClosePosition >= minimumClosePositionPercent
bool bearishCandleQuality = close < open and bodyPercent >= minimumBodyPercent and lowerWickPercent <= maximumRejectionWickPercent and bearishClosePosition >= minimumClosePositionPercent
float breakoutCandleATR = SafeDivide(candleRange, atrValue, na)
float breakoutDistanceATRCurrent = na(bullishBreakoutThreshold) ? na : SafeDivide(math.max(math.max(0.0, close - bullishBreakoutThreshold), math.max(0.0, bearishBreakoutThreshold - close)), atrValue, na)
float atrExpansionBaseline = ta.sma(atrValue, ATR_LENGTH)
float atrExpansionRatio = SafeDivide(atrValue, atrExpansionBaseline, na)
bool bullishMomentumValid = breakoutCandleATR >= minimumBreakoutRangeAtr and (not useAtrExpansionFilter or atrExpansionRatio >= minimumAtrExpansion)
bool bearishMomentumValid = bullishMomentumValid
bool bullishTrendAligned = GetTrendDirection() == TrendDirection.Bullish
bool bearishTrendAligned = GetTrendDirection() == TrendDirection.Bearish
bool bullishHTFAligned = trendState.htfFastEma > trendState.htfSlowEma
bool bearishHTFAligned = trendState.htfFastEma < trendState.htfSlowEma
bool bullishVWAPAligned = close > trendState.vwapValue
bool bearishVWAPAligned = close < trendState.vwapValue
bool bullishADXAligned = trendState.isTrending and trendState.plusDi > trendState.minusDi
bool bearishADXAligned = trendState.isTrending and trendState.minusDi > trendState.plusDi
bool bullishTrendRequirementsPass = (not requireTrendAlignment or bullishTrendAligned) and (not requireHtfAlignment or bullishHTFAligned) and (not requireVwapAlignment or bullishVWAPAligned) and (not requireAdxConfirmation or bullishADXAligned)
bool bearishTrendRequirementsPass = (not requireTrendAlignment or bearishTrendAligned) and (not requireHtfAlignment or bearishHTFAligned) and (not requireVwapAlignment or bearishVWAPAligned) and (not requireAdxConfirmation or bearishADXAligned)
bool breakoutRangeQualityValid = rangeState.isComplete and rangeState.qualityAccepted
bool bullishCloseOutsideRange = barstate.isconfirmed and close > rangeState.high
bool bearishCloseOutsideRange = barstate.isconfirmed and close < rangeState.low
bool bullishCloseOutsideBuffer = barstate.isconfirmed and close > bullishBreakoutThreshold
bool bearishCloseOutsideBuffer = barstate.isconfirmed and close < bearishBreakoutThreshold
bool bullishBreakoutCandidate = breakoutEnabled and breakoutRangeQualityValid and (breakoutMode == BreakoutConfirmationMode.CloseOnly ? bullishCloseOutsideRange : breakoutMode == BreakoutConfirmationMode.ClosePlusBuffer ? bullishCloseOutsideBuffer : breakoutMode == BreakoutConfirmationMode.CandleQuality ? bullishCloseOutsideBuffer and bullishCandleQuality : breakoutMode == BreakoutConfirmationMode.CandlePlusMomentum ? bullishCloseOutsideBuffer and bullishCandleQuality and bullishMomentumValid : bullishCloseOutsideBuffer and bullishCandleQuality and bullishMomentumValid and bullishTrendRequirementsPass)
bool bearishBreakoutCandidate = breakoutEnabled and breakoutRangeQualityValid and (breakoutMode == BreakoutConfirmationMode.CloseOnly ? bearishCloseOutsideRange : breakoutMode == BreakoutConfirmationMode.ClosePlusBuffer ? bearishCloseOutsideBuffer : breakoutMode == BreakoutConfirmationMode.CandleQuality ? bearishCloseOutsideBuffer and bearishCandleQuality : breakoutMode == BreakoutConfirmationMode.CandlePlusMomentum ? bearishCloseOutsideBuffer and bearishCandleQuality and bearishMomentumValid : bearishCloseOutsideBuffer and bearishCandleQuality and bearishMomentumValid and bearishTrendRequirementsPass)
float bullishBreakoutScore = math.max(0.0, math.min(100.0, (bullishCandleQuality ? 25.0 : 0.0) + (bullishMomentumValid ? 20.0 : 0.0) + (bullishTrendAligned ? 20.0 : 0.0) + (bullishHTFAligned ? 15.0 : 0.0) + ((bullishVWAPAligned and bullishADXAligned) ? 10.0 : 0.0) + (breakoutRangeQualityValid ? 10.0 : 0.0)))
float bearishBreakoutScore = math.max(0.0, math.min(100.0, (bearishCandleQuality ? 25.0 : 0.0) + (bearishMomentumValid ? 20.0 : 0.0) + (bearishTrendAligned ? 20.0 : 0.0) + (bearishHTFAligned ? 15.0 : 0.0) + ((bearishVWAPAligned and bearishADXAligned) ? 10.0 : 0.0) + (breakoutRangeQualityValid ? 10.0 : 0.0)))
BreakoutStrength bullishBreakoutStrength = bullishBreakoutScore >= 85.0 ? BreakoutStrength.Extreme : bullishBreakoutScore >= 65.0 ? BreakoutStrength.Strong : bullishBreakoutScore >= 40.0 ? BreakoutStrength.Normal : BreakoutStrength.Weak
BreakoutStrength bearishBreakoutStrength = bearishBreakoutScore >= 85.0 ? BreakoutStrength.Extreme : bearishBreakoutScore >= 65.0 ? BreakoutStrength.Strong : bearishBreakoutScore >= 40.0 ? BreakoutStrength.Normal : BreakoutStrength.Weak
bool bullishBreakoutQualityPass = bullishBreakoutScore >= minimumBreakoutScore
bool bearishBreakoutQualityPass = bearishBreakoutScore >= minimumBreakoutScore
int breakoutWindowMinutes = breakoutValidityWindow == "Entire session" ? 0 : int(str.tonumber(breakoutValidityWindow))
bool breakoutWindowValid = rangeState.isComplete and sessionState.isActive and (breakoutWindowMinutes == 0 or time <= rangeState.endTime + breakoutWindowMinutes * MILLISECONDS_PER_MINUTE)
bool breakoutAttemptGate = allowMultipleBreakoutAttempts or not breakoutAttempted
bool bullishBreakoutAccepted = barstate.isconfirmed and breakoutWindowValid and breakoutAttemptGate and bullishBreakoutCandidate and bullishBreakoutQualityPass and not bearishBreakoutCandidate
bool bearishBreakoutAccepted = barstate.isconfirmed and breakoutWindowValid and breakoutAttemptGate and bearishBreakoutCandidate and bearishBreakoutQualityPass and not bullishBreakoutCandidate
bool bullishRetestDetected = false
bool bearishRetestDetected = false
bool bullishRetestConfirmed = false
bool bearishRetestConfirmed = false
bool bullishRetestFailure = false
bool bearishRetestFailure = false
bool retestPendingState = retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected
bool retestWindowState = retestPendingState or (retestState == RetestState.RetestFailed and retestRetryPending)
bool retestWindowValid = retestWindowState and not na(retestStartBarIndex) and (retestWindowMode == RetestWindowMode.Bars ? bar_index - retestStartBarIndex <= retestWindowValue : time - retestStartTime <= retestWindowValue * MILLISECONDS_PER_MINUTE)
bool retestRetryEligible = allowMultipleRetestAttempts and retestState == RetestState.RetestFailed and not retestConfirmed and retestRetryPending and retestWindowValid and ((retestTradeDirection == TradeDirection.Long and breakoutState != BreakoutState.BullishFailed) or (retestTradeDirection == TradeDirection.Short and breakoutState != BreakoutState.BearishFailed))
float retestTolerance = na(retestLevel) ? na : retestToleranceMode == RetestDistanceMode.Ticks ? retestToleranceValue * syminfo.mintick : retestToleranceMode == RetestDistanceMode.Atr ? atrValue * retestToleranceValue : retestLevel * retestToleranceValue * 0.01
float maximumRetestPenetration = na(retestLevel) ? na : maximumPenetrationMode == RetestDistanceMode.Ticks ? maximumPenetrationValue * syminfo.mintick : maximumPenetrationMode == RetestDistanceMode.Atr ? atrValue * maximumPenetrationValue : retestLevel * maximumPenetrationValue * 0.01
bool retestActive = retestEnabled and retestWindowValid and not na(retestLevel) and retestTradeDirection != TradeDirection.None and not retestConfirmed and not retestFailed
bool bullishRetestInteraction = retestActive and retestTradeDirection == TradeDirection.Long and bar_index > retestStartBarIndex and low <= retestLevel + retestTolerance and low >= retestLevel - maximumRetestPenetration
bool bearishRetestInteraction = retestActive and retestTradeDirection == TradeDirection.Short and bar_index > retestStartBarIndex and high >= retestLevel - retestTolerance and high <= retestLevel + maximumRetestPenetration
bool bullishRetestContext = retestEnabled and retestTradeDirection == TradeDirection.Long and retestPendingState and not na(retestLevel) and not na(retestStartBarIndex) and bar_index > retestStartBarIndex
bool bearishRetestContext = retestEnabled and retestTradeDirection == TradeDirection.Short and retestPendingState and not na(retestLevel) and not na(retestStartBarIndex) and bar_index > retestStartBarIndex
bool bullishRetestCandleQuality = barstate.isconfirmed and bodyPercent >= minimumRetestBodyPercent and lowerWickPercent >= minimumRetestRejectionWickPercent and bullishClosePosition >= minimumRetestClosePositionPercent
bool bearishRetestCandleQuality = barstate.isconfirmed and bodyPercent >= minimumRetestBodyPercent and upperWickPercent >= minimumRetestRejectionWickPercent and bearishClosePosition >= minimumRetestClosePositionPercent
bool bullishTouchAndClose = bullishRetestContext and bullishRetestInteraction and barstate.isconfirmed and close >= retestLevel
bool bearishTouchAndClose = bearishRetestContext and bearishRetestInteraction and barstate.isconfirmed and close <= retestLevel
bool bullishRetestPinBar = bullishRetestContext and bullishRetestInteraction and bullishRetestCandleQuality and close >= retestLevel and upperWick <= lowerWick
bool bearishRetestPinBar = bearishRetestContext and bearishRetestInteraction and bearishRetestCandleQuality and close <= retestLevel and lowerWick <= upperWick
bool bullishRetestEngulfing = bullishRetestContext and barstate.isconfirmed and close > open and close[1] < open[1] and open <= close[1] and close >= open[1]
bool bearishRetestEngulfing = bearishRetestContext and barstate.isconfirmed and close < open and close[1] > open[1] and open >= close[1] and close <= open[1]
bool bullishStrongRetestRejection = bullishRetestContext and bullishRetestInteraction and bullishRetestCandleQuality and close >= retestLevel
bool bearishStrongRetestRejection = bearishRetestContext and bearishRetestInteraction and bearishRetestCandleQuality and close <= retestLevel
bool bullishAnyRetestPattern = (enableRetestPinBar and bullishRetestPinBar) or (enableRetestEngulfing and bullishRetestEngulfing) or (enableStrongRetestRejection and bullishStrongRetestRejection)
bool bearishAnyRetestPattern = (enableRetestPinBar and bearishRetestPinBar) or (enableRetestEngulfing and bearishRetestEngulfing) or (enableStrongRetestRejection and bearishStrongRetestRejection)
bool longRetestScoringActive = retestActive and retestTradeDirection == TradeDirection.Long
bool shortRetestScoringActive = retestActive and retestTradeDirection == TradeDirection.Short
float levelDistanceRatio = retestTolerance > 0 and not na(retestDistance) ? math.min(math.max(retestDistance / retestTolerance, 0.0), 1.0) : 1.0
float bullishLevelScore = longRetestScoringActive and bullishRetestInteraction ? 25.0 * (1.0 - levelDistanceRatio) : 0.0
float bearishLevelScore = shortRetestScoringActive and bearishRetestInteraction ? 25.0 * (1.0 - levelDistanceRatio) : 0.0
float bullishRejectionScore = longRetestScoringActive ? math.min(25.0, (bullishStrongRetestRejection ? 10.0 : 0.0) + math.min(lowerWickPercent, 100.0) * 0.08 + math.min(bullishClosePosition, 100.0) * 0.07) : 0.0
float bearishRejectionScore = shortRetestScoringActive ? math.min(25.0, (bearishStrongRetestRejection ? 10.0 : 0.0) + math.min(upperWickPercent, 100.0) * 0.08 + math.min(bearishClosePosition, 100.0) * 0.07) : 0.0
float bullishStructureScore = longRetestScoringActive ? math.min(20.0, (bullishRetestCandleQuality ? 10.0 : 0.0) + (bullishAnyRetestPattern ? 7.0 : 0.0) + ((bullishRetestPinBar and bullishRetestEngulfing) ? 3.0 : 0.0)) : 0.0
float bearishStructureScore = shortRetestScoringActive ? math.min(20.0, (bearishRetestCandleQuality ? 10.0 : 0.0) + (bearishAnyRetestPattern ? 7.0 : 0.0) + ((bearishRetestPinBar and bearishRetestEngulfing) ? 3.0 : 0.0)) : 0.0
float penetrationRatio = maximumRetestPenetration > 0 and not na(retestPenetration) ? math.min(math.max(retestPenetration / maximumRetestPenetration, 0.0), 1.0) : 0.0
float penetrationQualityScore = retestActive and not na(retestPenetration) ? 15.0 * (1.0 - penetrationRatio) : 0.0
float timingFraction = retestActive ? (retestWindowMode == RetestWindowMode.Bars ? math.min(math.max(SafeDivide(retestBarsSinceBreakout, retestWindowValue, 1.0), 0.0), 1.0) : math.min(math.max(SafeDivide(time - retestStartTime, retestWindowValue * MILLISECONDS_PER_MINUTE, 1.0), 0.0), 1.0)) : 1.0
float timingQualityScore = retestActive ? 15.0 * (1.0 - timingFraction) : 0.0
float bullishRetestScore = longRetestScoringActive ? math.max(0.0, math.min(100.0, bullishLevelScore + bullishRejectionScore + bullishStructureScore + penetrationQualityScore + timingQualityScore)) : 0.0
float bearishRetestScore = shortRetestScoringActive ? math.max(0.0, math.min(100.0, bearishLevelScore + bearishRejectionScore + bearishStructureScore + penetrationQualityScore + timingQualityScore)) : 0.0
bool bullishRetestQualityPass = longRetestScoringActive and bullishRetestScore >= retestScoreThreshold
bool bearishRetestQualityPass = shortRetestScoringActive and bearishRetestScore >= retestScoreThreshold
bool retestPatternEnabled = enableRetestPinBar or enableRetestEngulfing or enableStrongRetestRejection
