    bearishBaseRiskApprovedEvent := baseRiskApprovalCandidate and riskDirection == TradeBias.Bearish
else
    baseRiskApproved := riskApprovedStored and finalRiskApprovalEnabled and riskEngineEnabled and m7RiskDirectionMatches

// Exposed M8-C outputs are frozen target context, with validity recalculated
// only from those fixed values and current M8/M7 lifecycle validity.
float projectedTP1 = riskContextActive ? riskTP1 : na
float projectedTP2 = riskContextActive ? riskTP2 : na
bool tp1Valid = riskContextActive and not na(projectedTP1) and (riskDirection == TradeBias.Bullish ? projectedTP1 > riskEntryPrice : riskDirection == TradeBias.Bearish ? projectedTP1 < riskEntryPrice : false)
bool tp2Valid = riskContextActive and not na(projectedTP2) and (riskDirection == TradeBias.Bullish ? projectedTP2 > riskEntryPrice : riskDirection == TradeBias.Bearish ? projectedTP2 < riskEntryPrice : false)
float projectedRR1 = tp1Valid ? riskRR1 : na
float projectedRR2 = tp2Valid ? riskRR2 : na
bool rr1Pass = not na(projectedRR1) and projectedRR1 >= minimumRequiredRr
bool rr2Pass = not na(projectedRR2) and projectedRR2 >= minimumRequiredRr
bool targetStructureValid = tp1Valid and tp2Valid and (riskDirection == TradeBias.Bullish ? projectedTP2 > projectedTP1 and projectedTP1 > riskEntryPrice and riskEntryPrice > riskStopPrice : riskDirection == TradeBias.Bearish ? projectedTP2 < projectedTP1 and projectedTP1 < riskEntryPrice and riskEntryPrice < riskStopPrice : false)
bool requiredRrValidationPass = requireTp2RrValidation ? rr2Pass : rr1Pass
baseRiskApproved := riskApprovedStored and finalRiskApprovalEnabled and riskEngineEnabled and riskContextActive and proposedStopValid and stopDistanceValid and riskSizingValid and positionSizingValid and positionRiskWithinLimit and targetStructureValid and requiredRrValidationPass and m7RiskDirectionMatches

//==============================================================================
// 23. M8-D DAILY AND SESSION RISK GUARDS
//==============================================================================
// M8 has no order execution. Allocated risk therefore represents final
// approved setup risk, while daily P/L is only a strategy.equity diagnostic
// until M9 produces actual executed-trade outcomes.
bool newRiskDay = not na(time("D")[1]) and time("D") != time("D")[1]
if na(dailyStartEquity) or newRiskDay
    dailyStartEquity := strategy.equity
    dailyAllocatedRisk := 0.0
    dailyApprovedSetupCount := 0
    dailyExecutedTradeCount := 0
    dailyRealizedTradeProfit := 0.0
if na(sessionStartEquity) or (resetGuardsOnNewSession and sessionState.justStarted)
    sessionStartEquity := strategy.equity
    if resetGuardsOnNewSession and sessionState.justStarted
        sessionAllocatedRisk := 0.0
        sessionApprovedSetupCount := 0
        sessionExecutedTradeCount := 0
        sessionRealizedTradeProfit := 0.0
dailyPnL := not na(dailyStartEquity) ? strategy.equity - dailyStartEquity : na
dailyPnLPercent := not na(dailyStartEquity) and dailyStartEquity > 0.0 ? dailyPnL * 100.0 / dailyStartEquity : na
dailyAllocatedRiskPercent := not na(dailyStartEquity) and dailyStartEquity > 0.0 ? dailyAllocatedRisk * 100.0 / dailyStartEquity : na
sessionAllocatedRiskPercent := not na(sessionStartEquity) and sessionStartEquity > 0.0 ? sessionAllocatedRisk * 100.0 / sessionStartEquity : na
float pendingApprovedRisk = baseRiskApproved and newRiskContext and not na(riskCashAmount) and riskCashAmount >= 0.0 ? riskCashAmount : 0.0
bool dailyBaselineValid = not na(dailyStartEquity) and dailyStartEquity > 0.0
bool sessionBaselineValid = not na(sessionStartEquity) and sessionStartEquity > 0.0
dailyRiskBudgetAvailable := not dailyRiskGuardEnabled or dailyBaselineValid and dailyAllocatedRisk + pendingApprovedRisk <= dailyStartEquity * maximumDailyRiskPercent * 0.01
dailyLossLimitPass := not dailyRiskGuardEnabled or not na(dailyPnLPercent) and dailyPnLPercent > -maximumDailyLossPercent
dailyTradeCountPass := not dailyRiskGuardEnabled or (tradeExecutionEnabled ? dailyExecutedTradeCount : dailyApprovedSetupCount) < maximumTradesPerDay
// M8 intentionally leaves this at zero. Only M9 can safely incorporate
// realized closed-trade outcomes; setup/retest failures are not losses here.
consecutiveLossLimitPass := not dailyRiskGuardEnabled or consecutiveLossCount < maximumConsecutiveLosses
sessionRiskBudgetAvailable := not sessionRiskGuardEnabled or sessionBaselineValid and sessionAllocatedRisk + pendingApprovedRisk <= sessionStartEquity * maximumSessionRiskPercent * 0.01
riskGuardPass := dailyRiskBudgetAvailable and dailyLossLimitPass and dailyTradeCountPass and consecutiveLossLimitPass and sessionRiskBudgetAvailable
blockedByDailyRisk := dailyRiskGuardEnabled and not dailyRiskBudgetAvailable
blockedByDailyLoss := dailyRiskGuardEnabled and not dailyLossLimitPass
blockedByTradeCount := dailyRiskGuardEnabled and not dailyTradeCountPass
blockedByConsecutiveLosses := dailyRiskGuardEnabled and not consecutiveLossLimitPass
blockedBySessionRisk := sessionRiskGuardEnabled and not sessionRiskBudgetAvailable
int riskBlockCount = (blockedByDailyRisk ? 1 : 0) + (blockedByDailyLoss ? 1 : 0) + (blockedByTradeCount ? 1 : 0) + (blockedByConsecutiveLosses ? 1 : 0) + (blockedBySessionRisk ? 1 : 0)
riskBlockReason := riskBlockCount > 1 ? RiskBlockReason.Multiple : blockedByDailyRisk ? RiskBlockReason.DailyRisk : blockedByDailyLoss ? RiskBlockReason.DailyLoss : blockedByTradeCount ? RiskBlockReason.TradeCount : blockedByConsecutiveLosses ? RiskBlockReason.ConsecutiveLosses : blockedBySessionRisk ? RiskBlockReason.SessionRisk : RiskBlockReason.None

// Public approval is the final guarded result. Its events are asserted only
// on an approved new M8 context, so guards cannot double-count persistent state.
bullishRiskApprovedEvent := false
bearishRiskApprovedEvent := false
riskApproved := baseRiskApproved and riskGuardPass
bool bullishRiskApproved = riskApproved and bullishTradeQualified and riskDirection == TradeBias.Bullish
bool bearishRiskApproved = riskApproved and bearishTradeQualified and riskDirection == TradeBias.Bearish
if newRiskContext and riskApproved
    bullishRiskApprovedEvent := riskDirection == TradeBias.Bullish
    bearishRiskApprovedEvent := riskDirection == TradeBias.Bearish
if bullishRiskApprovedEvent or bearishRiskApprovedEvent
    dailyAllocatedRisk += riskCashAmount
    dailyApprovedSetupCount += 1
    sessionAllocatedRisk += riskCashAmount
    sessionApprovedSetupCount += 1
    dailyAllocatedRiskPercent := dailyBaselineValid ? dailyAllocatedRisk * 100.0 / dailyStartEquity : na
    sessionAllocatedRiskPercent := sessionBaselineValid ? sessionAllocatedRisk * 100.0 / sessionStartEquity : na

// Dashboard text is formed in the main execution scope to avoid enum qualifier
// coercion through UpdateDashboard.
riskDirectionDashboardText := riskDirection == TradeBias.Bullish ? "Bullish" : riskDirection == TradeBias.Bearish ? "Bearish" : "None"
riskStopSourceDashboardText := riskStopSource == StopSource.ATR ? "ATR" : riskStopSource == StopSource.Swing ? "Swing" : riskStopSource == StopSource.OpeningRange ? "Opening Range" : riskStopSource == StopSource.Retest ? "Retest" : riskStopSource == StopSource.Conservative ? "Conservative" : "None"
riskBlockReasonDashboardText := riskBlockReason == RiskBlockReason.DailyRisk ? "Daily Risk" : riskBlockReason == RiskBlockReason.DailyLoss ? "Daily Loss" : riskBlockReason == RiskBlockReason.TradeCount ? "Trade Count" : riskBlockReason == RiskBlockReason.ConsecutiveLosses ? "Consecutive Losses" : riskBlockReason == RiskBlockReason.SessionRisk ? "Session Risk" : riskBlockReason == RiskBlockReason.Multiple ? "Multiple" : "None"

//==============================================================================
// 24. M9-A ENTRY EXECUTION AND INITIAL PROTECTIVE ORDERS
//==============================================================================
// M9-A consumes only one-bar final M8 approvals. It records the planned M8
// reference separately from TradingView's actual fill price and never changes
// the initial stop or targets after submission.
float previousPositionSize = nz(strategy.position_size[1], 0.0)
bool longPositionOpened = strategy.position_size > 0.0 and previousPositionSize <= 0.0
bool shortPositionOpened = strategy.position_size < 0.0 and previousPositionSize >= 0.0
bool positionClosedEvent = strategy.position_size == 0.0 and previousPositionSize != 0.0
bool tradeEntryEvent = longPositionOpened or shortPositionOpened
if longPositionOpened
    tradeActive := true
    activeTradeDirection := TradeBias.Bullish
    tradeActualEntry := strategy.position_avg_price
else if shortPositionOpened
    tradeActive := true
    activeTradeDirection := TradeBias.Bearish
    tradeActualEntry := strategy.position_avg_price
else if strategy.position_size != 0.0
    tradeActive := true
    tradeActualEntry := strategy.position_avg_price
else if positionClosedEvent
    tradeActive := false
    activeTradeDirection := TradeBias.None
    tradeActualEntry := na

// A new actual fill starts a fresh breakeven lifecycle. Initial-stop context
// remains immutable for risk and later outcome modules.
if tradeEntryEvent
    breakevenActivated := false
    activeTradeStop := tradeInitialStop
    breakevenActivationBar := na
    tradeBreakevenHit := false
    tradeBreakevenHitEvent := false
    trailingActivated := false
    trailingActivatedEvent := false
    trailingStopPrice := na
    trailingActivationBar := na
    trailingStopUpdatedEvent := false
    tradeTrailingStopHit := false
    tradeTrailingStopHitEvent := false
    activeStopMode := ActiveStopMode.Initial
    activeTradeRealizedProfit := 0.0
    activeTradeClosedLegCount := 0
    activeTradeEntryId := longPositionOpened ? "LONG" : "SHORT"
    tradeInitialCashRisk := not na(riskCashAmount) and riskCashAmount > 0.0 ? riskCashAmount : na
    tradeInitialEquity := strategy.equity
    dailyExecutedTradeCount += 1
    sessionExecutedTradeCount += 1
    totalExecutedTradeCount += 1

// Both M9-A entry modes submit at approval close because the strategy is
// configured with process_orders_on_close. No limit/retest entry is introduced.
bool entryModeSupported = entryMode == EntryMode.MarketOnApproval or entryMode == EntryMode.ApprovalClose
bool dualRiskApprovalEvent = bullishRiskApprovedEvent and bearishRiskApprovedEvent
// Pyramiding remains zero and M9-A never reverses an active position. The
// optional one-position setting also guards transient tracked trade state.
bool onePositionGatePass = strategy.position_size == 0.0 and (not allowOnePositionAtATime or not tradeActive)
bool targetAllocationValid = not (useTp1 and useTp2) or tp1QuantityPercent > 0.0 and tp2QuantityPercent > 0.0 and math.abs(tp1QuantityPercent + tp2QuantityPercent - 100.0) <= 0.000001
bool longStopAndTargetValid = not na(riskEntryPrice) and not na(riskStopPrice) and riskStopPrice < riskEntryPrice and (not useTp1 or not na(riskTP1) and riskEntryPrice < riskTP1) and (not useTp2 or not na(riskTP2) and riskEntryPrice < riskTP2) and (not (useTp1 and useTp2) or riskTP1 < riskTP2)
bool shortStopAndTargetValid = not na(riskEntryPrice) and not na(riskStopPrice) and riskStopPrice > riskEntryPrice and (not useTp1 or not na(riskTP1) and riskEntryPrice > riskTP1) and (not useTp2 or not na(riskTP2) and riskEntryPrice > riskTP2) and (not (useTp1 and useTp2) or riskTP1 > riskTP2)
bool longEntryAllowed = tradeExecutionEnabled and entryModeSupported and allowLongTrades and not dualRiskApprovalEvent and bullishRiskApprovedEvent and riskApproved and bullishRiskApproved and riskDirection == TradeBias.Bullish and not na(riskQuantity) and riskQuantity > 0.0 and longStopAndTargetValid and targetAllocationValid and onePositionGatePass
bool shortEntryAllowed = tradeExecutionEnabled and entryModeSupported and allowShortTrades and not dualRiskApprovalEvent and bearishRiskApprovedEvent and riskApproved and bearishRiskApproved and riskDirection == TradeBias.Bearish and not na(riskQuantity) and riskQuantity > 0.0 and shortStopAndTargetValid and targetAllocationValid and onePositionGatePass

if cancelPendingSetupOnSessionEnd and sessionState.justEnded and strategy.position_size == 0.0
    strategy.cancel("LONG")
    strategy.cancel("SHORT")
if longEntryAllowed
    strategy.entry("LONG", strategy.long, qty = riskQuantity)
    if useTp1 and useTp2
        strategy.exit("L-TP1", from_entry = "LONG", stop = riskStopPrice, limit = riskTP1, qty_percent = tp1QuantityPercent)
        strategy.exit("L-TP2", from_entry = "LONG", stop = riskStopPrice, limit = riskTP2, qty_percent = tp2QuantityPercent)
    else if useTp1
        strategy.exit("L-TP1", from_entry = "LONG", stop = riskStopPrice, limit = riskTP1, qty_percent = 100.0)
    else if useTp2
        strategy.exit("L-TP2", from_entry = "LONG", stop = riskStopPrice, limit = riskTP2, qty_percent = 100.0)
    else
        strategy.exit("L-SL", from_entry = "LONG", stop = riskStopPrice, qty_percent = 100.0)
    tradePlannedEntry := riskEntryPrice
    tradeInitialStop := riskStopPrice
    tradeTP1 := useTp1 ? riskTP1 : na
    tradeTP2 := useTp2 ? riskTP2 : na
    tradeTP1QuantityPercent := useTp1 and useTp2 ? tp1QuantityPercent : useTp1 ? 100.0 : 0.0
    tradeTP2QuantityPercent := useTp1 and useTp2 ? tp2QuantityPercent : useTp2 ? 100.0 : 0.0
    tradeInitialQuantity := riskQuantity
    tradeEntryBarIndex := bar_index
    activeTradeDirection := TradeBias.Bullish
else if shortEntryAllowed
    strategy.entry("SHORT", strategy.short, qty = riskQuantity)
    if useTp1 and useTp2
        strategy.exit("S-TP1", from_entry = "SHORT", stop = riskStopPrice, limit = riskTP1, qty_percent = tp1QuantityPercent)
        strategy.exit("S-TP2", from_entry = "SHORT", stop = riskStopPrice, limit = riskTP2, qty_percent = tp2QuantityPercent)
    else if useTp1
        strategy.exit("S-TP1", from_entry = "SHORT", stop = riskStopPrice, limit = riskTP1, qty_percent = 100.0)
    else if useTp2
        strategy.exit("S-TP2", from_entry = "SHORT", stop = riskStopPrice, limit = riskTP2, qty_percent = 100.0)
    else
        strategy.exit("S-SL", from_entry = "SHORT", stop = riskStopPrice, qty_percent = 100.0)
    tradePlannedEntry := riskEntryPrice
    tradeInitialStop := riskStopPrice
    tradeTP1 := useTp1 ? riskTP1 : na
    tradeTP2 := useTp2 ? riskTP2 : na
    tradeTP1QuantityPercent := useTp1 and useTp2 ? tp1QuantityPercent : useTp1 ? 100.0 : 0.0
    tradeTP2QuantityPercent := useTp1 and useTp2 ? tp2QuantityPercent : useTp2 ? 100.0 : 0.0
    tradeInitialQuantity := riskQuantity
    tradeEntryBarIndex := bar_index
    activeTradeDirection := TradeBias.Bearish

//==============================================================================
// 25. M9-B PARTIAL TARGET LIFECYCLE AND RESIDUAL PROTECTION
//==============================================================================
// Position size is the authoritative fill source. Price is consulted only on
// an actual closure through strategy.closedtrades, never from candle touches.
tradeTP1HitEvent := false
tradeTP2HitEvent := false
tradeStopHitEvent := false
tradeBreakevenHitEvent := false
float currentPositionQuantity = math.abs(strategy.position_size)
float quantityTolerance = math.max(quantityStep, 0.000001)
float lastClosedExitPrice = positionClosedEvent and strategy.closedtrades > 0 ? strategy.closedtrades.exit_price(strategy.closedtrades - 1) : na
if tradeEntryEvent
    tradeTP1Hit := false
    tradeTP2Hit := false
    tradeStopHit := false
    tradeRemainingQuantity := currentPositionQuantity
    tradeTP1Quantity := not na(tradeTP1) and not na(tradeTP1QuantityPercent) ? currentPositionQuantity * tradeTP1QuantityPercent * 0.01 : 0.0
    tradeTP2Quantity := not na(tradeTP2) and not na(tradeTP2QuantityPercent) ? currentPositionQuantity * tradeTP2QuantityPercent * 0.01 : 0.0
    tradeTP1BarIndex := na
    tradeTP2BarIndex := na
    tradeQuantityMismatch := not na(tradeInitialQuantity) and math.abs(currentPositionQuantity - tradeInitialQuantity) > quantityTolerance
else if tradeActive
    tradeRemainingQuantity := currentPositionQuantity

// A TP1 event requires an actual remaining-position reduction approximately
// equal to its frozen allocation. It cannot be triggered by a price wick.
float positionQuantityReduction = math.max(math.abs(previousPositionSize) - currentPositionQuantity, 0.0)
bool partialPositionReduction = tradeActive and currentPositionQuantity > quantityTolerance and positionQuantityReduction > quantityTolerance
bool tp1PartialFillDetected = partialPositionReduction and not tradeTP1Hit and not na(tradeTP1Quantity) and tradeTP1Quantity > 0.0 and positionQuantityReduction >= tradeTP1Quantity - quantityTolerance
if tp1PartialFillDetected
    tradeTP1Hit := true
    tradeTP1HitEvent := true
    tradeTP1BarIndex := bar_index

// A closure is classified only when TradingView reports an exit price near a
// frozen target or stop. Both targets can be marked on one closure bar when a
// fast bar/gap traverses TP2 and the TP1 portion was not separately observable.
bool closedAtTP1 = positionClosedEvent and not na(lastClosedExitPrice) and not na(tradeTP1) and math.abs(lastClosedExitPrice - tradeTP1) <= syminfo.mintick * 2.0
bool closedAtTP2 = positionClosedEvent and not na(lastClosedExitPrice) and not na(tradeTP2) and math.abs(lastClosedExitPrice - tradeTP2) <= syminfo.mintick * 2.0
float stopDiagnosticPrice = not na(activeTradeStop) ? activeTradeStop : tradeInitialStop
bool closedAtEffectiveStop = positionClosedEvent and not na(lastClosedExitPrice) and not na(stopDiagnosticPrice) and math.abs(lastClosedExitPrice - stopDiagnosticPrice) <= syminfo.mintick * 2.0
if positionClosedEvent
    tradeRemainingQuantity := 0.0
    if closedAtTP2
        if not na(tradeTP1) and not tradeTP1Hit
            tradeTP1Hit := true
            tradeTP1HitEvent := true
            tradeTP1BarIndex := bar_index
        if not tradeTP2Hit
            tradeTP2Hit := true
            tradeTP2HitEvent := true
            tradeTP2BarIndex := bar_index
    else if closedAtTP1 and na(tradeTP2) and not tradeTP1Hit
        tradeTP1Hit := true
        tradeTP1HitEvent := true
        tradeTP1BarIndex := bar_index
    else if closedAtEffectiveStop and not tradeStopHit
        tradeStopHit := true
        tradeStopHitEvent := true
tradeResidualProtected := tradeActive and currentPositionQuantity > quantityTolerance and not na(activeTradeStop)

//==============================================================================
// 26. M9-C BREAKEVEN MANAGEMENT AND RESIDUAL STOP PROTECTION
//==============================================================================
// M9-C changes only the active protective stop after a verified trigger. It
// never changes the original risk stop, target allocations, or target prices.
float breakevenReferencePrice = not na(tradeActualEntry) ? tradeActualEntry : tradePlannedEntry
float breakevenOffset = breakevenOffsetMode == BreakevenOffsetMode.Ticks ? breakevenOffsetValue * syminfo.mintick : breakevenOffsetMode == BreakevenOffsetMode.ATR and not na(atrValue) ? breakevenOffsetValue * atrValue : 0.0
float breakevenStopPrice = activeTradeDirection == TradeBias.Bullish and not na(breakevenReferencePrice) ? breakevenReferencePrice + breakevenOffset : activeTradeDirection == TradeBias.Bearish and not na(breakevenReferencePrice) ? breakevenReferencePrice - breakevenOffset : na
float initialTradeRiskDistance = not na(breakevenReferencePrice) and not na(tradeInitialStop) ? math.abs(breakevenReferencePrice - tradeInitialStop) : na
bool residualPositionOpen = tradeActive and strategy.position_size != 0.0 and currentPositionQuantity > quantityTolerance and not positionClosedEvent
bool tp1BreakevenTrigger = breakevenTriggerMode == BreakevenTriggerMode.TP1Hit and applyBreakevenAfterTp1 and tradeTP1Hit and residualPositionOpen
bool longRMultipleTrigger = breakevenTriggerMode == BreakevenTriggerMode.RMultiple and residualPositionOpen and activeTradeDirection == TradeBias.Bullish and barstate.isconfirmed and not na(breakevenReferencePrice) and not na(initialTradeRiskDistance) and initialTradeRiskDistance > 0.0 and close - breakevenReferencePrice >= initialTradeRiskDistance * breakevenTriggerR
bool shortRMultipleTrigger = breakevenTriggerMode == BreakevenTriggerMode.RMultiple and residualPositionOpen and activeTradeDirection == TradeBias.Bearish and barstate.isconfirmed and not na(breakevenReferencePrice) and not na(initialTradeRiskDistance) and initialTradeRiskDistance > 0.0 and breakevenReferencePrice - close >= initialTradeRiskDistance * breakevenTriggerR
bool breakevenTriggerCondition = breakevenEnabled and not breakevenActivated and (tp1BreakevenTrigger or longRMultipleTrigger or shortRMultipleTrigger)
bool longBreakevenStopValid = activeTradeDirection == TradeBias.Bullish and not na(breakevenReferencePrice) and not na(breakevenStopPrice) and not na(tradeInitialStop) and breakevenStopPrice >= breakevenReferencePrice and breakevenStopPrice < close and breakevenStopPrice > tradeInitialStop and (na(activeTradeStop) or breakevenStopPrice > activeTradeStop) and (na(tradeTP2) or breakevenStopPrice < tradeTP2)
bool shortBreakevenStopValid = activeTradeDirection == TradeBias.Bearish and not na(breakevenReferencePrice) and not na(breakevenStopPrice) and not na(tradeInitialStop) and breakevenStopPrice <= breakevenReferencePrice and breakevenStopPrice > close and breakevenStopPrice < tradeInitialStop and (na(activeTradeStop) or breakevenStopPrice < activeTradeStop) and (na(tradeTP2) or breakevenStopPrice > tradeTP2)
bool breakevenStopValid = longBreakevenStopValid or shortBreakevenStopValid
bool breakevenActivatedEvent = false

if breakevenTriggerCondition and breakevenStopValid
    breakevenActivated := true
    activeTradeStop := activeTradeDirection == TradeBias.Bullish ? na(activeTradeStop) ? breakevenStopPrice : math.max(activeTradeStop, breakevenStopPrice) : na(activeTradeStop) ? breakevenStopPrice : math.min(activeTradeStop, breakevenStopPrice)
    breakevenActivationBar := bar_index
    breakevenActivatedEvent := true
    activeStopMode := ActiveStopMode.Breakeven

// Update only the remaining reservation. TP1 is never recreated after a fill.
if breakevenActivatedEvent and residualPositionOpen and not na(activeTradeStop)
    if activeTradeDirection == TradeBias.Bullish
        if not na(tradeTP1) and not tradeTP1Hit and not na(tradeTP1QuantityPercent) and tradeTP1QuantityPercent > 0.0
            strategy.exit("L-TP1", from_entry = "LONG", stop = activeTradeStop, limit = tradeTP1, qty_percent = tradeTP1QuantityPercent)
        if not na(tradeTP2) and not na(tradeTP2QuantityPercent) and tradeTP2QuantityPercent > 0.0
            strategy.exit("L-TP2", from_entry = "LONG", stop = activeTradeStop, limit = tradeTP2, qty_percent = tradeTP2QuantityPercent)
        else if na(tradeTP1)
            strategy.exit("L-SL", from_entry = "LONG", stop = activeTradeStop, qty_percent = 100.0)
    else if activeTradeDirection == TradeBias.Bearish
        if not na(tradeTP1) and not tradeTP1Hit and not na(tradeTP1QuantityPercent) and tradeTP1QuantityPercent > 0.0
            strategy.exit("S-TP1", from_entry = "SHORT", stop = activeTradeStop, limit = tradeTP1, qty_percent = tradeTP1QuantityPercent)
        if not na(tradeTP2) and not na(tradeTP2QuantityPercent) and tradeTP2QuantityPercent > 0.0
            strategy.exit("S-TP2", from_entry = "SHORT", stop = activeTradeStop, limit = tradeTP2, qty_percent = tradeTP2QuantityPercent)
        else if na(tradeTP1)
            strategy.exit("S-SL", from_entry = "SHORT", stop = activeTradeStop, qty_percent = 100.0)

tradeEffectiveStop := not na(activeTradeStop) ? activeTradeStop : tradeInitialStop
bool closedAtBreakevenStop = positionClosedEvent and breakevenActivated and activeStopMode == ActiveStopMode.Breakeven and not na(lastClosedExitPrice) and not na(activeTradeStop) and math.abs(lastClosedExitPrice - activeTradeStop) <= syminfo.mintick * 2.0
if closedAtBreakevenStop
    tradeBreakevenHit := true
    tradeBreakevenHitEvent := true

//==============================================================================
// 27. M9-D SELECTABLE TRAILING STOP MANAGEMENT
//==============================================================================
// Every trailing mode produces one candidate. The selected candidate can only
// improve activeTradeStop, which is shared with M9-C breakeven management.
trailingActivatedEvent := false
trailingStopUpdatedEvent := false
tradeTrailingStopHitEvent := false

// Pivot values become available only after swingTrailPivotLength right-side
// bars confirm the turning point. Their stored bar indices prevent using a
// pivot that predates the current trade lifecycle.
float confirmedTrailingSwingLow = ta.pivotlow(low, swingTrailPivotLength, swingTrailPivotLength)
float confirmedTrailingSwingHigh = ta.pivothigh(high, swingTrailPivotLength, swingTrailPivotLength)
if not na(confirmedTrailingSwingLow)
    latestTrailingSwingLow := confirmedTrailingSwingLow
    latestTrailingSwingLowBar := bar_index - swingTrailPivotLength
if not na(confirmedTrailingSwingHigh)
    latestTrailingSwingHigh := confirmedTrailingSwingHigh
    latestTrailingSwingHighBar := bar_index - swingTrailPivotLength

// SuperTrend is evaluated once per bar and uses no higher-timeframe data or
// lookahead. TradingView reports a negative direction on its bullish side.
[superTrendLine, superTrendDirection] = ta.supertrend(superTrendFactor, superTrendAtrLength)
float chandelierHighestHigh = ta.highest(high, chandelierLength)
float chandelierLowestLow = ta.lowest(low, chandelierLength)
float atrTrailingCandidate = activeTradeDirection == TradeBias.Bullish and not na(atrValue) ? close - atrValue * atrTrailMultiplier : activeTradeDirection == TradeBias.Bearish and not na(atrValue) ? close + atrValue * atrTrailMultiplier : na
float chandelierTrailingCandidate = activeTradeDirection == TradeBias.Bullish and not na(atrValue) ? chandelierHighestHigh - atrValue * chandelierAtrMultiplier : activeTradeDirection == TradeBias.Bearish and not na(atrValue) ? chandelierLowestLow + atrValue * chandelierAtrMultiplier : na
float superTrendTrailingCandidate = activeTradeDirection == TradeBias.Bullish and superTrendDirection < 0 ? superTrendLine : activeTradeDirection == TradeBias.Bearish and superTrendDirection > 0 ? superTrendLine : na
float swingTrailBufferPrice = swingTrailBuffer * syminfo.mintick
bool currentTradeHasConfirmedSwingLow = not na(latestTrailingSwingLow) and not na(latestTrailingSwingLowBar) and not na(tradeEntryBarIndex) and latestTrailingSwingLowBar >= tradeEntryBarIndex
bool currentTradeHasConfirmedSwingHigh = not na(latestTrailingSwingHigh) and not na(latestTrailingSwingHighBar) and not na(tradeEntryBarIndex) and latestTrailingSwingHighBar >= tradeEntryBarIndex
float swingTrailingCandidate = activeTradeDirection == TradeBias.Bullish and currentTradeHasConfirmedSwingLow ? latestTrailingSwingLow - swingTrailBufferPrice : activeTradeDirection == TradeBias.Bearish and currentTradeHasConfirmedSwingHigh ? latestTrailingSwingHigh + swingTrailBufferPrice : na
float selectedTrailingCandidate = trailingStopMode == TrailingStopMode.ATR ? atrTrailingCandidate : trailingStopMode == TrailingStopMode.Chandelier ? chandelierTrailingCandidate : trailingStopMode == TrailingStopMode.SuperTrend ? superTrendTrailingCandidate : trailingStopMode == TrailingStopMode.Swing ? swingTrailingCandidate : na

float trailingReferencePrice = not na(tradeActualEntry) ? tradeActualEntry : tradePlannedEntry
float trailingInitialRiskDistance = not na(trailingReferencePrice) and not na(tradeInitialStop) ? math.abs(trailingReferencePrice - tradeInitialStop) : na
bool openTrailingPosition = tradeActive and strategy.position_size != 0.0 and currentPositionQuantity > quantityTolerance and not positionClosedEvent and (activeTradeDirection == TradeBias.Bullish or activeTradeDirection == TradeBias.Bearish)
bool trailingAfterTp1Activation = trailingActivationMode == TrailingActivationMode.AfterTP1 and tradeTP1Hit and openTrailingPosition
bool trailingLongRMultipleActivation = trailingActivationMode == TrailingActivationMode.RMultiple and activeTradeDirection == TradeBias.Bullish and openTrailingPosition and barstate.isconfirmed and not na(trailingReferencePrice) and not na(trailingInitialRiskDistance) and trailingInitialRiskDistance > 0.0 and close - trailingReferencePrice >= trailingInitialRiskDistance * trailingActivationR
bool trailingShortRMultipleActivation = trailingActivationMode == TrailingActivationMode.RMultiple and activeTradeDirection == TradeBias.Bearish and openTrailingPosition and barstate.isconfirmed and not na(trailingReferencePrice) and not na(trailingInitialRiskDistance) and trailingInitialRiskDistance > 0.0 and trailingReferencePrice - close >= trailingInitialRiskDistance * trailingActivationR
bool trailingImmediateActivation = trailingActivationMode == TrailingActivationMode.Immediate and openTrailingPosition and barstate.isconfirmed
bool trailingActivationCondition = trailingImmediateActivation or trailingAfterTp1Activation or trailingLongRMultipleActivation or trailingShortRMultipleActivation
bool trailingContextActive = trailingStopEnabled and trailingStopMode != TrailingStopMode.None and openTrailingPosition and barstate.isconfirmed and not na(tradeInitialStop) and not na(activeTradeStop) and (trailingActivated or trailingActivationCondition)

if trailingContextActive and not trailingActivated
    trailingActivated := true
    trailingActivatedEvent := true
    trailingActivationBar := bar_index

// Before TP1, its target is the nearest remaining boundary; after its verified
// fill, TP2 becomes the remaining target. This keeps every reservation valid.
float remainingTargetPrice = not tradeTP1Hit and not na(tradeTP1) ? tradeTP1 : tradeTP2
bool longTrailingCandidateValid = trailingActivated and activeTradeDirection == TradeBias.Bullish and not na(selectedTrailingCandidate) and not na(activeTradeStop) and selectedTrailingCandidate > activeTradeStop and selectedTrailingCandidate < close and (na(remainingTargetPrice) or selectedTrailingCandidate < remainingTargetPrice)
bool shortTrailingCandidateValid = trailingActivated and activeTradeDirection == TradeBias.Bearish and not na(selectedTrailingCandidate) and not na(activeTradeStop) and selectedTrailingCandidate < activeTradeStop and selectedTrailingCandidate > close and (na(remainingTargetPrice) or selectedTrailingCandidate > remainingTargetPrice)
bool trailingCandidateValid = longTrailingCandidateValid or shortTrailingCandidateValid

if trailingContextActive and trailingCandidateValid
    trailingStopPrice := selectedTrailingCandidate
    activeTradeStop := activeTradeDirection == TradeBias.Bullish ? math.max(activeTradeStop, selectedTrailingCandidate) : math.min(activeTradeStop, selectedTrailingCandidate)
    activeStopMode := trailingStopMode == TrailingStopMode.ATR ? ActiveStopMode.ATRTrail : trailingStopMode == TrailingStopMode.Chandelier ? ActiveStopMode.Chandelier : trailingStopMode == TrailingStopMode.SuperTrend ? ActiveStopMode.SuperTrend : ActiveStopMode.Swing
    trailingStopUpdatedEvent := true

// Reuse the original IDs to maintain full stop coverage before TP1 and to
// protect only the residual target after its verified fill.
if trailingStopUpdatedEvent and openTrailingPosition and not na(activeTradeStop)
    if activeTradeDirection == TradeBias.Bullish
        if not na(tradeTP1) and not tradeTP1Hit and not na(tradeTP1QuantityPercent) and tradeTP1QuantityPercent > 0.0
            strategy.exit("L-TP1", from_entry = "LONG", stop = activeTradeStop, limit = tradeTP1, qty_percent = tradeTP1QuantityPercent)
        if not na(tradeTP2) and not na(tradeTP2QuantityPercent) and tradeTP2QuantityPercent > 0.0
            strategy.exit("L-TP2", from_entry = "LONG", stop = activeTradeStop, limit = tradeTP2, qty_percent = tradeTP2QuantityPercent)
        else if na(tradeTP1)
            strategy.exit("L-SL", from_entry = "LONG", stop = activeTradeStop, qty_percent = 100.0)
    else if activeTradeDirection == TradeBias.Bearish
        if not na(tradeTP1) and not tradeTP1Hit and not na(tradeTP1QuantityPercent) and tradeTP1QuantityPercent > 0.0
            strategy.exit("S-TP1", from_entry = "SHORT", stop = activeTradeStop, limit = tradeTP1, qty_percent = tradeTP1QuantityPercent)
        if not na(tradeTP2) and not na(tradeTP2QuantityPercent) and tradeTP2QuantityPercent > 0.0
            strategy.exit("S-TP2", from_entry = "SHORT", stop = activeTradeStop, limit = tradeTP2, qty_percent = tradeTP2QuantityPercent)
        else if na(tradeTP1)
            strategy.exit("S-SL", from_entry = "SHORT", stop = activeTradeStop, qty_percent = 100.0)

bool closedAtTrailingStop = positionClosedEvent and trailingActivated and (activeStopMode == ActiveStopMode.ATRTrail or activeStopMode == ActiveStopMode.Chandelier or activeStopMode == ActiveStopMode.SuperTrend or activeStopMode == ActiveStopMode.Swing) and not na(lastClosedExitPrice) and not na(activeTradeStop) and math.abs(lastClosedExitPrice - activeTradeStop) <= syminfo.mintick * 2.0
if closedAtTrailingStop
    tradeTrailingStopHit := true
    tradeTrailingStopHitEvent := true
tradeEffectiveStop := not na(activeTradeStop) ? activeTradeStop : tradeInitialStop

//==============================================================================
// 28. M9-E REALIZED OUTCOMES AND EXECUTION-BASED GUARD RECONCILIATION
//==============================================================================
// Closed-trade records may represent partial exit legs. Each newly reported
// leg is therefore accumulated by the active entry ID and classified only once
// the complete position is flat.
tradeClosedEvent := false
tradeWinEvent := false
tradeLossEvent := false
tradeBreakevenEvent := false
bool newClosedTradeAvailable = strategy.closedtrades > lastProcessedClosedTradeCount
bool processedActiveExitLeg = false
if newClosedTradeAvailable
    for closedTradeIndex = lastProcessedClosedTradeCount to strategy.closedtrades - 1
        string closedTradeEntryId = strategy.closedtrades.entry_id(closedTradeIndex)
        float closedTradeProfit = strategy.closedtrades.profit(closedTradeIndex)
        if closedTradeEntryId == activeTradeEntryId and activeTradeEntryId != ""
            activeTradeRealizedProfit += closedTradeProfit
            activeTradeClosedLegCount += 1
            processedActiveExitLeg := true
            lastTradeEntryPrice := strategy.closedtrades.entry_price(closedTradeIndex)
            lastTradeExitPrice := strategy.closedtrades.exit_price(closedTradeIndex)
            lastTradeEntryBar := strategy.closedtrades.entry_bar_index(closedTradeIndex)
            lastTradeExitBar := strategy.closedtrades.exit_bar_index(closedTradeIndex)
            lastTradeEntryId := closedTradeEntryId
            lastTradeExitId := strategy.closedtrades.exit_id(closedTradeIndex)
    lastProcessedClosedTradeCount := strategy.closedtrades

// Final trade diagnostics are emitted only for a complete lifecycle. Account
// return uses frozen entry equity; R uses the separately frozen cash-risk base.
if processedActiveExitLeg and strategy.position_size == 0.0 and activeTradeClosedLegCount > 0
    lastTradeProfit := activeTradeRealizedProfit
    lastTradeProfitPercent := not na(tradeInitialEquity) and tradeInitialEquity > 0.0 ? activeTradeRealizedProfit * 100.0 / tradeInitialEquity : na
    lastTradeRMultiple := not na(tradeInitialCashRisk) and tradeInitialCashRisk > 0.0 ? activeTradeRealizedProfit / tradeInitialCashRisk : na
    bool finalExitAtTP1 = not na(lastTradeExitPrice) and not na(tradeTP1) and math.abs(lastTradeExitPrice - tradeTP1) <= syminfo.mintick * 2.0
    bool finalExitAtTP2 = not na(lastTradeExitPrice) and not na(tradeTP2) and math.abs(lastTradeExitPrice - tradeTP2) <= syminfo.mintick * 2.0
    bool finalExitAtEffectiveStop = not na(lastTradeExitPrice) and not na(tradeEffectiveStop) and math.abs(lastTradeExitPrice - tradeEffectiveStop) <= syminfo.mintick * 2.0
    bool effectiveStopIsTrailing = activeStopMode == ActiveStopMode.ATRTrail or activeStopMode == ActiveStopMode.Chandelier or activeStopMode == ActiveStopMode.SuperTrend or activeStopMode == ActiveStopMode.Swing
    lastTradeExitReason := finalExitAtTP2 ? TradeExitReason.TP2 : finalExitAtTP1 ? TradeExitReason.TP1 : finalExitAtEffectiveStop and effectiveStopIsTrailing ? TradeExitReason.TrailingStop : finalExitAtEffectiveStop and activeStopMode == ActiveStopMode.Breakeven ? TradeExitReason.Breakeven : finalExitAtEffectiveStop and activeStopMode == ActiveStopMode.Initial ? TradeExitReason.InitialStop : TradeExitReason.Other
    lastTradeOutcome := activeTradeRealizedProfit > TRADE_PROFIT_TOLERANCE ? TradeOutcome.Win : activeTradeRealizedProfit < -TRADE_PROFIT_TOLERANCE ? TradeOutcome.Loss : TradeOutcome.Breakeven
    tradeClosedEvent := true
    tradeWinEvent := lastTradeOutcome == TradeOutcome.Win
    tradeLossEvent := lastTradeOutcome == TradeOutcome.Loss
    tradeBreakevenEvent := lastTradeOutcome == TradeOutcome.Breakeven
    dailyRealizedTradeProfit += activeTradeRealizedProfit
    sessionRealizedTradeProfit += activeTradeRealizedProfit
    if lastTradeOutcome == TradeOutcome.Loss
        consecutiveLossCount += 1
    else if lastTradeOutcome == TradeOutcome.Win
        consecutiveLossCount := 0

// M8 retains approval diagnostics, but its trade-count guard now prefers actual
// entries whenever execution is on. Outcome changes are reflected immediately
// for subsequent bars and dashboard diagnostics without changing past orders.
dailyTradeCountPass := not dailyRiskGuardEnabled or (tradeExecutionEnabled ? dailyExecutedTradeCount : dailyApprovedSetupCount) < maximumTradesPerDay
consecutiveLossLimitPass := not dailyRiskGuardEnabled or consecutiveLossCount < maximumConsecutiveLosses
riskGuardPass := dailyRiskBudgetAvailable and dailyLossLimitPass and dailyTradeCountPass and consecutiveLossLimitPass and sessionRiskBudgetAvailable
blockedByTradeCount := dailyRiskGuardEnabled and not dailyTradeCountPass
blockedByConsecutiveLosses := dailyRiskGuardEnabled and not consecutiveLossLimitPass
int reconciledRiskBlockCount = (blockedByDailyRisk ? 1 : 0) + (blockedByDailyLoss ? 1 : 0) + (blockedByTradeCount ? 1 : 0) + (blockedByConsecutiveLosses ? 1 : 0) + (blockedBySessionRisk ? 1 : 0)
riskBlockReason := reconciledRiskBlockCount > 1 ? RiskBlockReason.Multiple : blockedByDailyRisk ? RiskBlockReason.DailyRisk : blockedByDailyLoss ? RiskBlockReason.DailyLoss : blockedByTradeCount ? RiskBlockReason.TradeCount : blockedByConsecutiveLosses ? RiskBlockReason.ConsecutiveLosses : blockedBySessionRisk ? RiskBlockReason.SessionRisk : RiskBlockReason.None
riskBlockReasonDashboardText := riskBlockReason == RiskBlockReason.DailyRisk ? "Daily Risk" : riskBlockReason == RiskBlockReason.DailyLoss ? "Daily Loss" : riskBlockReason == RiskBlockReason.TradeCount ? "Trade Count" : riskBlockReason == RiskBlockReason.ConsecutiveLosses ? "Consecutive Losses" : riskBlockReason == RiskBlockReason.SessionRisk ? "Session Risk" : riskBlockReason == RiskBlockReason.Multiple ? "Multiple" : "None"

// Dashboard text is formed in the main execution scope. This prevents Pine
// from coercing series enum values to const parameters through UpdateDashboard.
smartMoneyBiasDashboardText := smartMoneyBias == SmartMoneyBias.Bullish ? "Bullish" : smartMoneyBias == SmartMoneyBias.Bearish ? "Bearish" : "Neutral"
smartMoneyStrengthDashboardText := smartMoneyStrength == SmartMoneyStrength.Extreme ? "Extreme" : smartMoneyStrength == SmartMoneyStrength.Strong ? "Strong" : smartMoneyStrength == SmartMoneyStrength.Normal ? "Normal" : "Weak"
tradeSetupStateDashboardText := tradeSetupState == TradeSetupState.BullishQualified ? "Bullish Qualified" : tradeSetupState == TradeSetupState.BearishQualified ? "Bearish Qualified" : tradeSetupState == TradeSetupState.Conflict ? "Conflict" : tradeSetupState == TradeSetupState.Disqualified ? "Disqualified" : tradeSetupState == TradeSetupState.Expired ? "Expired" : "None"
tradeBiasDashboardText := tradeBias == TradeBias.Bullish ? "Bullish" : tradeBias == TradeBias.Bearish ? "Bearish" : tradeBias == TradeBias.Neutral ? "Neutral" : "None"
tradeSetupStrengthDashboardText := tradeSetupStrength == TradeSetupStrength.Extreme ? "Extreme" : tradeSetupStrength == TradeSetupStrength.Strong ? "Strong" : tradeSetupStrength == TradeSetupStrength.Normal ? "Normal" : "Weak"

// M7 dashboard mirrors are assigned after the directional series are complete.
// They keep the single dashboard independent of forward references and enum
// qualifier coercion inside the dashboard function.
bullishTradeScoreRawDisplay := bullishTradeScoreRaw
bearishTradeScoreRawDisplay := bearishTradeScoreRaw
bullishTradePenaltyDisplay := bullishTradePenalty
bearishTradePenaltyDisplay := bearishTradePenalty
bullishMandatoryGateDisplay := bullishMandatoryGatePass
bearishMandatoryGateDisplay := bearishMandatoryGatePass
bullishTradeCandidateDisplay := bullishTradeQualificationCandidate
bearishTradeCandidateDisplay := bearishTradeQualificationCandidate
tradeScoreDifferenceDisplay := tradeScoreDifference

if na(rangeBox)
    [nextRangeBox, nextRangeHighLine, nextRangeLowLine, nextRangeMidLine, nextRangeHighLabel, nextRangeLowLabel, nextRangeWidthLabel] = CreateRangeDrawings()
    rangeBox := nextRangeBox
    rangeHighLine := nextRangeHighLine
    rangeLowLine := nextRangeLowLine
    rangeMidLine := nextRangeMidLine
    rangeHighLabel := nextRangeHighLabel
    rangeLowLabel := nextRangeLowLabel
    rangeWidthLabel := nextRangeWidthLabel
trendLabel := CalculateTrendLabel(trendLabel)
UpdateRangeDrawings()
UpdateDashboard()
UpdateDebugPanel()

plot(showEmaPlots ? fastEmaValue : na, "Fast EMA", color = color.teal, linewidth = 2)
plot(showEmaPlots ? slowEmaValue : na, "Slow EMA", color = color.orange, linewidth = 2)
color trendBackground = IsBullTrend() ? color.new(color.lime, 90) : IsBearTrend() ? color.new(color.red, 90) : color.new(color.gray, 95)
bgcolor(showTrendBackground ? trendBackground : na, title = "Trend Background")
color tradeBiasBackground = tradeSetupState == TradeSetupState.BullishQualified ? color.new(color.lime, 93) : tradeSetupState == TradeSetupState.BearishQualified ? color.new(color.red, 93) : tradeSetupState == TradeSetupState.Conflict ? color.new(color.orange, 94) : na
bgcolor(showTradeBiasBackground ? tradeBiasBackground : na, title = "Trade Bias Background")
plot(showBreakoutLevels and (breakoutConfirmed or breakoutFailed) ? breakoutPrice : na, "Breakout Level", color = breakoutTradeDirection == TradeDirection.Long ? color.lime : breakoutTradeDirection == TradeDirection.Short ? color.red : color.gray, linewidth = 2, style = plot.style_linebr)
plotshape(showBreakoutMarkers and bullishBreakoutSignal, "Bullish Breakout", shape.triangleup, location.belowbar, color.lime, size = size.small)
plotshape(showBreakoutMarkers and bearishBreakoutSignal, "Bearish Breakout", shape.triangledown, location.abovebar, color.red, size = size.small)
plotshape(showBreakoutMarkers and bullishBreakoutFailure, "Bullish Breakout Failure", shape.xcross, location.abovebar, color.orange, size = size.tiny)
plotshape(showBreakoutMarkers and bearishBreakoutFailure, "Bearish Breakout Failure", shape.xcross, location.belowbar, color.orange, size = size.tiny)
plotchar(showBreakoutScore and (bullishBreakoutSignal or bearishBreakoutSignal) ? breakoutScore : na, "Breakout Score", "•", location.top, color = color.white)
bool retestLevelVisible = retestState != RetestState.None and not na(retestLevel)
plot(showRetestLevel and retestLevelVisible ? retestLevel : na, "Retest Level", color = retestTradeDirection == TradeDirection.Long ? color.aqua : retestTradeDirection == TradeDirection.Short ? color.fuchsia : color.gray, linewidth = 2, style = plot.style_linebr)
plotshape(showRetestMarkers and bullishRetestDetected, "Bullish Retest Detected", shape.circle, location.belowbar, color.aqua, size = size.tiny)
plotshape(showRetestMarkers and bearishRetestDetected, "Bearish Retest Detected", shape.circle, location.abovebar, color.fuchsia, size = size.tiny)
plotshape(showRetestMarkers and bullishRetestConfirmed, "Bullish Retest Confirmed", shape.diamond, location.belowbar, color.lime, size = size.small)
plotshape(showRetestMarkers and bearishRetestConfirmed, "Bearish Retest Confirmed", shape.diamond, location.abovebar, color.red, size = size.small)
plotshape(showRetestMarkers and bullishRetestFailure, "Bullish Retest Failure", shape.xcross, location.abovebar, color.orange, size = size.small)
plotshape(showRetestMarkers and bearishRetestFailure, "Bearish Retest Failure", shape.xcross, location.belowbar, color.orange, size = size.small)
plotchar(showRetestScore and (bullishRetestConfirmed or bearishRetestConfirmed) ? retestScore : na, "Retest Score", "R", location.bottom, color = color.white)
plotshape(showQualifiedSetupMarkers and bullishTradeQualifiedEvent, "Bullish Qualified Setup", shape.labelup, location.belowbar, color.lime, text = "LONG", textcolor = color.white, size = size.small)
plotshape(showQualifiedSetupMarkers and bearishTradeQualifiedEvent, "Bearish Qualified Setup", shape.labeldown, location.abovebar, color.red, text = "SHORT", textcolor = color.white, size = size.small)
if showSetupScore and bullishTradeQualifiedEvent
    label.new(bar_index, low, "LONG " + FormatValueOrDash(tradeSetupScore), style = label.style_label_up, color = color.lime, textcolor = color.white, size = size.tiny)
if showSetupScore and bearishTradeQualifiedEvent
    label.new(bar_index, high, "SHORT " + FormatValueOrDash(tradeSetupScore), style = label.style_label_down, color = color.red, textcolor = color.white, size = size.tiny)
plot(showPreviousDayLevels ? previousDayHigh : na, "Previous Day High", color = color.new(color.blue, 20), linewidth = 1, style = plot.style_linebr)
plot(showPreviousDayLevels ? previousDayLow : na, "Previous Day Low", color = color.new(color.blue, 20), linewidth = 1, style = plot.style_linebr)
plot(showPreviousDayLevels ? previousDayClose : na, "Previous Day Close", color = color.new(color.blue, 55), linewidth = 1, style = plot.style_linebr)
plot(showPreviousDayLevels ? previousDayMid : na, "Previous Day Mid", color = color.new(color.blue, 70), linewidth = 1, style = plot.style_linebr)
plot(showPreviousWeekLevels ? previousWeekHigh : na, "Previous Week High", color = color.new(color.purple, 20), linewidth = 1, style = plot.style_linebr)
plot(showPreviousWeekLevels ? previousWeekLow : na, "Previous Week Low", color = color.new(color.purple, 20), linewidth = 1, style = plot.style_linebr)
plot(showPreviousWeekLevels ? previousWeekClose : na, "Previous Week Close", color = color.new(color.purple, 55), linewidth = 1, style = plot.style_linebr)
plot(showPreviousWeekLevels ? previousWeekMid : na, "Previous Week Mid", color = color.new(color.purple, 70), linewidth = 1, style = plot.style_linebr)
plot(showEqualHighsLows and equalHighActive ? equalHighLevel : na, "Equal Highs", color = color.orange, linewidth = 2, style = plot.style_linebr)
plot(showEqualHighsLows and equalLowActive ? equalLowLevel : na, "Equal Lows", color = color.aqua, linewidth = 2, style = plot.style_linebr)
plotshape(showLiquiditySweeps and bullishLiquiditySweep, "Bullish Liquidity Sweep", shape.triangleup, location.belowbar, color.lime, size = size.small)
plotshape(showLiquiditySweeps and bearishLiquiditySweep, "Bearish Liquidity Sweep", shape.triangledown, location.abovebar, color.red, size = size.small)
plot(showFvgZones and latestBullishFvgActive ? latestBullishFvgTop : na, "Bullish FVG Top", color = color.new(color.lime, 35), style = plot.style_linebr)
plot(showFvgZones and latestBullishFvgActive ? latestBullishFvgBottom : na, "Bullish FVG Bottom", color = color.new(color.lime, 35), style = plot.style_linebr)
plot(showFvgZones and latestBearishFvgActive ? latestBearishFvgTop : na, "Bearish FVG Top", color = color.new(color.red, 35), style = plot.style_linebr)
plot(showFvgZones and latestBearishFvgActive ? latestBearishFvgBottom : na, "Bearish FVG Bottom", color = color.new(color.red, 35), style = plot.style_linebr)
plot(showOrderBlocks and latestBullishObActive ? latestBullishObMid : na, "Bullish OB Mid", color = color.new(color.aqua, 20), linewidth = 2, style = plot.style_linebr)
plot(showOrderBlocks and latestBearishObActive ? latestBearishObMid : na, "Bearish OB Mid", color = color.new(color.orange, 20), linewidth = 2, style = plot.style_linebr)
plot(showPremiumDiscount ? dealingRangeHigh : na, "Dealing Range High", color = color.new(color.purple, 35), style = plot.style_linebr)
plot(showPremiumDiscount ? dealingRangeLow : na, "Dealing Range Low", color = color.new(color.purple, 35), style = plot.style_linebr)
plot(showPremiumDiscount ? dealingRangeEquilibrium : na, "Dealing Range Equilibrium", color = color.new(color.gray, 30), style = plot.style_linebr)
