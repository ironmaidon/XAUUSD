    if enabled and symbolMatches and sessionState.justStarted
        [resetRangeState, resetTradeControl, resetBreakoutDirection, resetAtrAtCompletion, resetBreakoutState] = CreateSessionRange()
        rangeState := resetRangeState
        tradeControl := resetTradeControl
        breakoutDirection := resetBreakoutDirection
        atrAtRangeCompletion := resetAtrAtCompletion
        breakoutState := resetBreakoutState
        breakoutAttempted := false
        breakoutConfirmed := false
        breakoutFailed := false
        breakoutBarIndex := na
        breakoutPrice := na
        breakoutTradeDirection := TradeDirection.None
        breakoutDistance := na
        breakoutDistancePercent := na
        breakoutDistanceATR := na
        breakoutScore := na
        breakoutStrength := BreakoutStrength.Weak
        bullishFailureCount := 0
        bearishFailureCount := 0
        retestState := RetestState.None
        retestLevel := na
        retestScore := na
        retestBarIndex := na
        retestStartBarIndex := na
        retestStartTime := na
        retestTradeDirection := TradeDirection.None
        retestDistance := na
        retestDistanceATR := na
        retestPenetration := na
        retestPenetrationATR := na
        retestBarsSinceBreakout := na
        retestAttempted := false
        retestConfirmed := false
        retestFailed := false
        bullishRetestFailureCount := 0
        bearishRetestFailureCount := 0
        retestAttemptCount := 0
        retestRetryPending := false
    if enabled and symbolMatches and sessionState.isActive
        [calculatedRangeState, calculatedAtrAtCompletion, calculatedRangeBreakoutState] = CalculateOpeningRange(rangeState, atrValue)
        rangeState := calculatedRangeState
        atrAtRangeCompletion := calculatedAtrAtCompletion
        breakoutState := calculatedRangeBreakoutState
        [calculatedBreakoutDirection, calculatedBreakoutState, calculatedSessionStatistics] = CalculateBreakoutState(rangeState, breakoutState, breakoutDirection, sessionStatistics)
        breakoutDirection := calculatedBreakoutDirection
        breakoutState := calculatedBreakoutState
        sessionStatistics := calculatedSessionStatistics

    // M4-C event outputs reset every confirmed bar; persistent state is retained.
    bullishBreakoutSignal := false
    bearishBreakoutSignal := false
    bullishBreakoutFailure := false
    bearishBreakoutFailure := false
    if bullishBreakoutAccepted
        breakoutState := BreakoutState.BullishConfirmed
        breakoutAttempted := true
        breakoutConfirmed := true
        breakoutFailed := false
        breakoutBarIndex := bar_index
        breakoutPrice := close
        breakoutTradeDirection := TradeDirection.Long
        breakoutDistance := close - rangeState.high
        breakoutDistancePercent := SafeDivide(breakoutDistance * 100.0, rangeState.high, na)
        breakoutDistanceATR := SafeDivide(breakoutDistance, atrValue, na)
        breakoutScore := bullishBreakoutScore
        breakoutStrength := bullishBreakoutStrength
        bullishBreakoutSignal := true
        bullishFailureCount := 0
        bearishFailureCount := 0
    else if bearishBreakoutAccepted
        breakoutState := BreakoutState.BearishConfirmed
        breakoutAttempted := true
        breakoutConfirmed := true
        breakoutFailed := false
        breakoutBarIndex := bar_index
        breakoutPrice := close
        breakoutTradeDirection := TradeDirection.Short
        breakoutDistance := rangeState.low - close
        breakoutDistancePercent := SafeDivide(breakoutDistance * 100.0, rangeState.low, na)
        breakoutDistanceATR := SafeDivide(breakoutDistance, atrValue, na)
        breakoutScore := bearishBreakoutScore
        breakoutStrength := bearishBreakoutStrength
        bearishBreakoutSignal := true
        bullishFailureCount := 0
        bearishFailureCount := 0
    if enableFailureDetection and breakoutState == BreakoutState.BullishConfirmed
        bullishFailureCount := close <= rangeState.high - failureBuffer ? bullishFailureCount + 1 : 0
        if bullishFailureCount >= failureConfirmationBars
            breakoutState := BreakoutState.BullishFailed
            breakoutConfirmed := false
            breakoutFailed := true
            bullishBreakoutFailure := true
    else if enableFailureDetection and breakoutState == BreakoutState.BearishConfirmed
        bearishFailureCount := close >= rangeState.low + failureBuffer ? bearishFailureCount + 1 : 0
        if bearishFailureCount >= failureConfirmationBars
            breakoutState := BreakoutState.BearishFailed
            breakoutConfirmed := false
            breakoutFailed := true
            bearishBreakoutFailure := true
    if bullishBreakoutSignal != bearishBreakoutSignal
        retestState := RetestState.WaitingForRetest
        retestTradeDirection := bullishBreakoutSignal ? TradeDirection.Long : TradeDirection.Short
        retestLevel := bullishBreakoutSignal ? rangeState.high : rangeState.low
        retestStartBarIndex := bar_index
        retestStartTime := time
        retestBarIndex := na
        retestDistance := na
        retestDistanceATR := na
        retestPenetration := na
        retestPenetrationATR := na
        retestBarsSinceBreakout := 0
        retestAttempted := false
        retestConfirmed := false
        retestFailed := false
        bullishRetestFailureCount := 0
        bearishRetestFailureCount := 0
        retestAttemptCount := 0
        retestRetryPending := false
    bool matchingBreakoutFailure = (retestTradeDirection == TradeDirection.Long and (bullishBreakoutFailure or breakoutState == BreakoutState.BullishFailed)) or (retestTradeDirection == TradeDirection.Short and (bearishBreakoutFailure or breakoutState == BreakoutState.BearishFailed))
    bool retestLifecycleActive = retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected or (retestState == RetestState.RetestFailed and retestRetryPending)
    bool retestFailureTransition = false
    if retestLifecycleActive and not retestConfirmed and matchingBreakoutFailure
        retestState := RetestState.RetestFailed
        retestFailed := true
        retestConfirmed := false
        retestRetryPending := false
        retestRetryEligible := false
    else if retestLifecycleActive and not retestConfirmed and not retestWindowValid
        retestState := RetestState.Expired
        retestConfirmed := false
        retestFailed := false
        retestRetryPending := false
        retestRetryEligible := false
    else if retestState == RetestState.RetestFailed and retestRetryPending and retestRetryEligible
        retestState := RetestState.WaitingForRetest
        retestFailed := false
        retestConfirmed := false
        retestRetryPending := false
        retestRetryEligible := false
        retestBarIndex := na
        retestDistance := na
        retestDistanceATR := na
        retestPenetration := na
        retestPenetrationATR := na
        bullishRetestFailureCount := 0
        bearishRetestFailureCount := 0
    if retestActive and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected)
        retestBarsSinceBreakout := bar_index - retestStartBarIndex
        retestDistance := math.abs(close - retestLevel)
        retestDistanceATR := SafeDivide(retestDistance, atrValue, na)
        retestPenetration := retestTradeDirection == TradeDirection.Long ? math.max(retestLevel - low, 0.0) : math.max(high - retestLevel, 0.0)
        retestPenetrationATR := SafeDivide(retestPenetration, atrValue, na)
        if (retestTradeDirection == TradeDirection.Long and low < retestLevel - maximumRetestPenetration) or (retestTradeDirection == TradeDirection.Short and high > retestLevel + maximumRetestPenetration)
            retestState := RetestState.RetestFailed
            retestFailed := true
            retestFailureTransition := true
        else if retestState == RetestState.WaitingForRetest and (bullishRetestInteraction or bearishRetestInteraction)
            retestState := RetestState.RetestDetected
            retestAttempted := true
            retestAttemptCount += 1
            retestBarIndex := bar_index
            bullishRetestDetected := bullishRetestInteraction
            bearishRetestDetected := bearishRetestInteraction
    if retestState == RetestState.RetestDetected and not retestConfirmed
        if retestTradeDirection == TradeDirection.Long
            bullishRetestFailureCount := bullishRetestCloseFailure ? bullishRetestFailureCount + 1 : 0
            bearishRetestFailureCount := 0
        else if retestTradeDirection == TradeDirection.Short
            bearishRetestFailureCount := bearishRetestCloseFailure ? bearishRetestFailureCount + 1 : 0
            bullishRetestFailureCount := 0
        else
            bullishRetestFailureCount := 0
            bearishRetestFailureCount := 0
    else
        bullishRetestFailureCount := 0
        bearishRetestFailureCount := 0
    if bullishRetestFailureThresholdReached and retestTradeDirection == TradeDirection.Long and retestState == RetestState.RetestDetected and not retestConfirmed and barstate.isconfirmed
        bullishRetestFailure := true
        bearishRetestFailure := false
        retestState := RetestState.RetestFailed
        retestFailed := true
        retestConfirmed := false
        retestFailureTransition := true
        bullishRetestFailureCount := 0
        bearishRetestFailureCount := 0
    else if bearishRetestFailureThresholdReached and retestTradeDirection == TradeDirection.Short and retestState == RetestState.RetestDetected and not retestConfirmed and barstate.isconfirmed
        bearishRetestFailure := true
        bullishRetestFailure := false
        retestState := RetestState.RetestFailed
        retestFailed := true
        retestConfirmed := false
        retestFailureTransition := true
        bullishRetestFailureCount := 0
        bearishRetestFailureCount := 0
    if retestFailureTransition
        retestRetryEligible := allowMultipleRetestAttempts and not retestConfirmed and not matchingBreakoutFailure and retestWindowValid
        if retestRetryEligible
            retestRetryPending := true
    if (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected) and bullishRetestConfirmationCandidate != bearishRetestConfirmationCandidate
        if bullishRetestConfirmationCandidate
            retestState := RetestState.RetestConfirmed
            retestConfirmed := true
            retestFailed := false
            retestRetryPending := false
            retestRetryEligible := false
            retestTradeDirection := TradeDirection.Long
            retestScore := bullishRetestScore
            retestBarIndex := bar_index
            bullishRetestConfirmed := true
        else if bearishRetestConfirmationCandidate
            retestState := RetestState.RetestConfirmed
            retestConfirmed := true
            retestFailed := false
            retestRetryPending := false
            retestRetryEligible := false
            retestTradeDirection := TradeDirection.Short
            retestScore := bearishRetestScore
            retestBarIndex := bar_index
            bearishRetestConfirmed := true
    // M6-B priority is Equal, Previous Day, Previous Week, M3 Swing, then Opening Range.
    // An ambiguous two-sided sweep is rejected so only one directional event can occur per bar.
    bullishLiquiditySweep := false
    bearishLiquiditySweep := false
    if bullishRawLiquiditySweep != bearishRawLiquiditySweep
        if bullishRawLiquiditySweep
            bullishSweepConfirmationCount += 1
            bearishSweepConfirmationCount := 0
            if bullishSweepConfirmationCount == sweepConfirmationBars
                bullishLiquiditySweep := true
                sweptLevel := bullishSweepLevelCandidate
                sweepDistance := bullishSweepPenetrationCandidate
                sweepDistanceATR := SafeDivide(sweepDistance, atrValue, na)
                sweepSource := bullishSweepSourceCandidate
                sweepStrength := CalculateSweepStrength(sweepDistance, bullishSweepMaximumPenetration, lowerWickPercent, close > sweptLevel, sweepSource)
                sweepBias := TradeDirection.Long
                sweepBarIndex := bar_index
        else
            bearishSweepConfirmationCount += 1
            bullishSweepConfirmationCount := 0
            if bearishSweepConfirmationCount == sweepConfirmationBars
                bearishLiquiditySweep := true
                sweptLevel := bearishSweepLevelCandidate
                sweepDistance := bearishSweepPenetrationCandidate
                sweepDistanceATR := SafeDivide(sweepDistance, atrValue, na)
                sweepSource := bearishSweepSourceCandidate
                sweepStrength := CalculateSweepStrength(sweepDistance, bearishSweepMaximumPenetration, upperWickPercent, close < sweptLevel, sweepSource)
                sweepBias := TradeDirection.Short
                sweepBarIndex := bar_index
    else
        bullishSweepConfirmationCount := 0
        bearishSweepConfirmationCount := 0
    // M6-C keeps both direction-specific arrays bounded and applies wick-based
    // mitigation for Midpoint/FullFill; CloseThrough requires a completed close.
    bullishFvgCreated := false
    bearishFvgCreated := false
    if not fairValueGapsEnabled
        array.clear(bullishFvgZones)
        array.clear(bearishFvgZones)
    while array.size(bullishFvgZones) > maximumActiveFvgs
        array.shift(bullishFvgZones)
    while array.size(bearishFvgZones) > maximumActiveFvgs
        array.shift(bearishFvgZones)
    if array.size(bullishFvgZones) > 0
        for index = 0 to array.size(bullishFvgZones) - 1
            FvgZone zone = array.get(bullishFvgZones, index)
            if zone.active
                bool expired = bar_index - zone.creationBar > maximumFvgAge
                bool enteredFromAbove = close[1] > zone.top and low <= zone.top and high >= zone.bottom
                bool fullyMitigated = fvgInvalidationMode == FvgInvalidationMode.Midpoint ? low <= zone.midpoint : fvgInvalidationMode == FvgInvalidationMode.FullFill ? low <= zone.bottom : close <= zone.bottom
                zone.partiallyMitigated := zone.partiallyMitigated or (enteredFromAbove and not fullyMitigated)
                zone.fullyMitigated := zone.fullyMitigated or fullyMitigated
                zone.active := not expired and not zone.fullyMitigated
                array.set(bullishFvgZones, index, zone)
    if array.size(bearishFvgZones) > 0
        for index = 0 to array.size(bearishFvgZones) - 1
            FvgZone zone = array.get(bearishFvgZones, index)
            if zone.active
                bool expired = bar_index - zone.creationBar > maximumFvgAge
                bool enteredFromBelow = close[1] < zone.bottom and high >= zone.bottom and low <= zone.top
                bool fullyMitigated = fvgInvalidationMode == FvgInvalidationMode.Midpoint ? high >= zone.midpoint : fvgInvalidationMode == FvgInvalidationMode.FullFill ? high >= zone.top : close >= zone.top
                zone.partiallyMitigated := zone.partiallyMitigated or (enteredFromBelow and not fullyMitigated)
                zone.fullyMitigated := zone.fullyMitigated or fullyMitigated
                zone.active := not expired and not zone.fullyMitigated
                array.set(bearishFvgZones, index, zone)
    if bullishFvgCandidate != bearishFvgCandidate
        if bullishFvgCandidate
            while array.size(bullishFvgZones) >= maximumActiveFvgs
                array.shift(bullishFvgZones)
            array.push(bullishFvgZones, FvgZone.new(TradeDirection.Long, bullishFvgTopCandidate, bullishFvgBottomCandidate, bullishFvgMidCandidate, bar_index, true, false, false))
            bullishFvgCreated := true
        else if bearishFvgCandidate
            while array.size(bearishFvgZones) >= maximumActiveFvgs
                array.shift(bearishFvgZones)
            array.push(bearishFvgZones, FvgZone.new(TradeDirection.Short, bearishFvgTopCandidate, bearishFvgBottomCandidate, bearishFvgMidCandidate, bar_index, true, false, false))
            bearishFvgCreated := true
    latestBullishFvgTop := na
    latestBullishFvgBottom := na
    latestBullishFvgMid := na
    latestBullishFvgAge := na
    latestBullishFvgActive := false
    nearestBullishFvgDistance := na
    insideBullishFvg := false
    bullishFvgSupportsRetest := false
    int latestBullishFvgCreationBar = na
    if array.size(bullishFvgZones) > 0
        for index = 0 to array.size(bullishFvgZones) - 1
            FvgZone zone = array.get(bullishFvgZones, index)
            if zone.active
                float zoneDistance = DistanceToFvgZone(close, zone.top, zone.bottom)
                float retestZoneDistance = DistanceToFvgZone(retestLevel, zone.top, zone.bottom)
                if na(latestBullishFvgCreationBar) or zone.creationBar > latestBullishFvgCreationBar
                    latestBullishFvgTop := zone.top
                    latestBullishFvgBottom := zone.bottom
                    latestBullishFvgMid := zone.midpoint
                    latestBullishFvgAge := bar_index - zone.creationBar
                    latestBullishFvgActive := true
                    latestBullishFvgCreationBar := zone.creationBar
                if na(nearestBullishFvgDistance) or zoneDistance < nearestBullishFvgDistance
                    nearestBullishFvgDistance := zoneDistance
                insideBullishFvg := insideBullishFvg or zoneDistance == 0.0
                bullishFvgSupportsRetest := bullishFvgSupportsRetest or (retestTradeDirection == TradeDirection.Long and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected) and not na(retestTolerance) and not na(retestZoneDistance) and retestZoneDistance <= retestTolerance)
    latestBearishFvgTop := na
    latestBearishFvgBottom := na
    latestBearishFvgMid := na
    latestBearishFvgAge := na
    latestBearishFvgActive := false
    nearestBearishFvgDistance := na
    insideBearishFvg := false
    bearishFvgSupportsRetest := false
    int latestBearishFvgCreationBar = na
    if array.size(bearishFvgZones) > 0
        for index = 0 to array.size(bearishFvgZones) - 1
            FvgZone zone = array.get(bearishFvgZones, index)
            if zone.active
                float zoneDistance = DistanceToFvgZone(close, zone.top, zone.bottom)
                float retestZoneDistance = DistanceToFvgZone(retestLevel, zone.top, zone.bottom)
                if na(latestBearishFvgCreationBar) or zone.creationBar > latestBearishFvgCreationBar
                    latestBearishFvgTop := zone.top
                    latestBearishFvgBottom := zone.bottom
                    latestBearishFvgMid := zone.midpoint
                    latestBearishFvgAge := bar_index - zone.creationBar
                    latestBearishFvgActive := true
                    latestBearishFvgCreationBar := zone.creationBar
                if na(nearestBearishFvgDistance) or zoneDistance < nearestBearishFvgDistance
                    nearestBearishFvgDistance := zoneDistance
                insideBearishFvg := insideBearishFvg or zoneDistance == 0.0
                bearishFvgSupportsRetest := bearishFvgSupportsRetest or (retestTradeDirection == TradeDirection.Short and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected) and not na(retestTolerance) and not na(retestZoneDistance) and retestZoneDistance <= retestTolerance)
    nearestBullishFvgDistanceATR := SafeDivide(nearestBullishFvgDistance, atrValue, na)
    nearestBearishFvgDistanceATR := SafeDivide(nearestBearishFvgDistance, atrValue, na)
    // M6-D uses the complete opposite candle range as the deterministic OB zone.
    float bullishObSourceTop = na
    float bullishObSourceBottom = na
    int bullishObSourceBar = na
    float bearishObSourceTop = na
    float bearishObSourceBottom = na
    int bearishObSourceBar = na
    bool bullishStructureContext = trendState.structureBreak and (trendState.structure == MarketStructure.HigherHigh or trendState.structure == MarketStructure.HigherLow)
    bool bearishStructureContext = trendState.structureBreak and (trendState.structure == MarketStructure.LowerHigh or trendState.structure == MarketStructure.LowerLow)
    bool bullishObSetup = orderBlocksEnabled and close > open and breakoutCandleATR >= minimumOrderBlockDisplacementAtr and (not requireOrderBlockStructureBreak or bullishStructureContext)
    bool bearishObSetup = orderBlocksEnabled and close < open and breakoutCandleATR >= minimumOrderBlockDisplacementAtr and (not requireOrderBlockStructureBreak or bearishStructureContext)
    if bullishObSetup
        for offset = 1 to orderBlockLookback
            if offset <= bar_index and na(bullishObSourceBar) and close[offset] < open[offset]
                bullishObSourceTop := high[offset]
                bullishObSourceBottom := low[offset]
                bullishObSourceBar := bar_index - offset
    if bearishObSetup
        for offset = 1 to orderBlockLookback
            if offset <= bar_index and na(bearishObSourceBar) and close[offset] > open[offset]
                bearishObSourceTop := high[offset]
                bearishObSourceBottom := low[offset]
                bearishObSourceBar := bar_index - offset
    if not orderBlocksEnabled
        array.clear(bullishOrderBlocks)
        array.clear(bearishOrderBlocks)
    while array.size(bullishOrderBlocks) > maximumActiveOrderBlocks
        array.shift(bullishOrderBlocks)
    while array.size(bearishOrderBlocks) > maximumActiveOrderBlocks
        array.shift(bearishOrderBlocks)
    if array.size(bullishOrderBlocks) > 0
        for index = 0 to array.size(bullishOrderBlocks) - 1
            OrderBlockZone zone = array.get(bullishOrderBlocks, index)
            if zone.active
                bool invalidated = orderBlockInvalidationMode == OrderBlockInvalidationMode.WickThrough ? low < zone.bottom : close < zone.bottom
                zone.mitigated := zone.mitigated or (close[1] > zone.top and low <= zone.top and high >= zone.bottom)
                zone.invalidated := zone.invalidated or invalidated
                zone.active := not zone.invalidated and bar_index - zone.creationBar <= maximumOrderBlockAge
                array.set(bullishOrderBlocks, index, zone)
    if array.size(bearishOrderBlocks) > 0
        for index = 0 to array.size(bearishOrderBlocks) - 1
            OrderBlockZone zone = array.get(bearishOrderBlocks, index)
            if zone.active
                bool invalidated = orderBlockInvalidationMode == OrderBlockInvalidationMode.WickThrough ? high > zone.top : close > zone.top
                zone.mitigated := zone.mitigated or (close[1] < zone.bottom and high >= zone.bottom and low <= zone.top)
                zone.invalidated := zone.invalidated or invalidated
                zone.active := not zone.invalidated and bar_index - zone.creationBar <= maximumOrderBlockAge
                array.set(bearishOrderBlocks, index, zone)
    bool bullishObDuplicate = false
    bool bearishObDuplicate = false
    if array.size(bullishOrderBlocks) > 0
        for index = 0 to array.size(bullishOrderBlocks) - 1
            OrderBlockZone existingZone = array.get(bullishOrderBlocks, index)
            bullishObDuplicate := bullishObDuplicate or (not na(bullishObSourceBar) and existingZone.sourceBar == bullishObSourceBar)
    if array.size(bearishOrderBlocks) > 0
        for index = 0 to array.size(bearishOrderBlocks) - 1
            OrderBlockZone existingZone = array.get(bearishOrderBlocks, index)
            bearishObDuplicate := bearishObDuplicate or (not na(bearishObSourceBar) and existingZone.sourceBar == bearishObSourceBar)
    if bullishObSetup and not na(bullishObSourceBar) and not bullishObDuplicate
        while array.size(bullishOrderBlocks) >= maximumActiveOrderBlocks
            array.shift(bullishOrderBlocks)
        array.push(bullishOrderBlocks, OrderBlockZone.new(TradeDirection.Long, bullishObSourceTop, bullishObSourceBottom, (bullishObSourceTop + bullishObSourceBottom) * 0.5, bar_index, bullishObSourceBar, true, false, false))
    if bearishObSetup and not na(bearishObSourceBar) and not bearishObDuplicate
        while array.size(bearishOrderBlocks) >= maximumActiveOrderBlocks
            array.shift(bearishOrderBlocks)
        array.push(bearishOrderBlocks, OrderBlockZone.new(TradeDirection.Short, bearishObSourceTop, bearishObSourceBottom, (bearishObSourceTop + bearishObSourceBottom) * 0.5, bar_index, bearishObSourceBar, true, false, false))
    latestBullishObTop := na
    latestBullishObBottom := na
    latestBullishObMid := na
    latestBullishObAge := na
    latestBullishObActive := false
    nearestBullishObDistance := na
    insideBullishOrderBlock := false
    bullishObSupportsRetest := false
    int latestBullishObCreationBar = na
    if array.size(bullishOrderBlocks) > 0
        for index = 0 to array.size(bullishOrderBlocks) - 1
            OrderBlockZone zone = array.get(bullishOrderBlocks, index)
            if zone.active
                float distance = DistanceToFvgZone(close, zone.top, zone.bottom)
                float retestDistanceToZone = DistanceToFvgZone(retestLevel, zone.top, zone.bottom)
                if na(latestBullishObCreationBar) or zone.creationBar > latestBullishObCreationBar
                    latestBullishObTop := zone.top
                    latestBullishObBottom := zone.bottom
                    latestBullishObMid := zone.midpoint
                    latestBullishObAge := bar_index - zone.creationBar
                    latestBullishObActive := true
                    latestBullishObCreationBar := zone.creationBar
                nearestBullishObDistance := na(nearestBullishObDistance) or distance < nearestBullishObDistance ? distance : nearestBullishObDistance
                insideBullishOrderBlock := insideBullishOrderBlock or distance == 0.0
                bullishObSupportsRetest := bullishObSupportsRetest or (retestTradeDirection == TradeDirection.Long and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected) and not na(retestTolerance) and not na(retestDistanceToZone) and retestDistanceToZone <= retestTolerance)
    latestBearishObTop := na
    latestBearishObBottom := na
    latestBearishObMid := na
    latestBearishObAge := na
    latestBearishObActive := false
    nearestBearishObDistance := na
    insideBearishOrderBlock := false
    bearishObSupportsRetest := false
    int latestBearishObCreationBar = na
    if array.size(bearishOrderBlocks) > 0
        for index = 0 to array.size(bearishOrderBlocks) - 1
            OrderBlockZone zone = array.get(bearishOrderBlocks, index)
            if zone.active
                float distance = DistanceToFvgZone(close, zone.top, zone.bottom)
                float retestDistanceToZone = DistanceToFvgZone(retestLevel, zone.top, zone.bottom)
                if na(latestBearishObCreationBar) or zone.creationBar > latestBearishObCreationBar
                    latestBearishObTop := zone.top
                    latestBearishObBottom := zone.bottom
                    latestBearishObMid := zone.midpoint
                    latestBearishObAge := bar_index - zone.creationBar
                    latestBearishObActive := true
                    latestBearishObCreationBar := zone.creationBar
                nearestBearishObDistance := na(nearestBearishObDistance) or distance < nearestBearishObDistance ? distance : nearestBearishObDistance
                insideBearishOrderBlock := insideBearishOrderBlock or distance == 0.0
                bearishObSupportsRetest := bearishObSupportsRetest or (retestTradeDirection == TradeDirection.Short and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected) and not na(retestTolerance) and not na(retestDistanceToZone) and retestDistanceToZone <= retestTolerance)
    nearestBullishObDistanceATR := SafeDivide(nearestBullishObDistance, atrValue, na)
    nearestBearishObDistanceATR := SafeDivide(nearestBearishObDistance, atrValue, na)
    float candidateRangeHigh = dealingRangeMode == DealingRangeMode.RecentStructure ? trendState.swingHigh : dealingRangeMode == DealingRangeMode.OpeningRange ? rangeState.high : previousDayHigh
    float candidateRangeLow = dealingRangeMode == DealingRangeMode.RecentStructure ? trendState.swingLow : dealingRangeMode == DealingRangeMode.OpeningRange ? rangeState.low : previousDayLow
    if dealingRangeMode == DealingRangeMode.RecentStructure and (na(candidateRangeHigh) or na(candidateRangeLow) or candidateRangeHigh <= candidateRangeLow) and rangeState.isComplete
        candidateRangeHigh := rangeState.high
        candidateRangeLow := rangeState.low
    dealingRangeHigh := premiumDiscountEnabled and not na(candidateRangeHigh) and not na(candidateRangeLow) and candidateRangeHigh > candidateRangeLow ? candidateRangeHigh : na
    dealingRangeLow := premiumDiscountEnabled and not na(candidateRangeHigh) and not na(candidateRangeLow) and candidateRangeHigh > candidateRangeLow ? candidateRangeLow : na
    dealingRangeEquilibrium := not na(dealingRangeHigh) ? (dealingRangeHigh + dealingRangeLow) * 0.5 : na
    premiumDiscountState := na(dealingRangeEquilibrium) ? PremiumDiscountState.Unknown : close > dealingRangeEquilibrium + syminfo.mintick ? PremiumDiscountState.Premium : close < dealingRangeEquilibrium - syminfo.mintick ? PremiumDiscountState.Discount : PremiumDiscountState.Equilibrium
    bullishDiscountSupportsRetest := retestTradeDirection == TradeDirection.Long and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected) and premiumDiscountState == PremiumDiscountState.Discount
    bearishPremiumSupportsRetest := retestTradeDirection == TradeDirection.Short and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected) and premiumDiscountState == PremiumDiscountState.Premium
    if not sessionState.isActive and not breakoutConfirmed and not breakoutFailed
        breakoutState := BreakoutState.Invalidated
    else if rangeState.isComplete and not breakoutWindowValid and not breakoutConfirmed and not breakoutFailed
        breakoutState := BreakoutState.Invalidated

bool bullishSweepSupportsRetest = bullishLiquiditySweep and retestTradeDirection == TradeDirection.Long and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected)
bool bearishSweepSupportsRetest = bearishLiquiditySweep and retestTradeDirection == TradeDirection.Short and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected)
int sweepContextAge = not na(sweepBarIndex) ? bar_index - sweepBarIndex : 1000000
bool bullishRecentSweep = sweepBias == TradeDirection.Long and sweepContextAge <= 10
bool bearishRecentSweep = sweepBias == TradeDirection.Short and sweepContextAge <= 10
bool significantSweepSource = sweepSource == LiquiditySource.EqualHigh or sweepSource == LiquiditySource.EqualLow or sweepSource == LiquiditySource.PreviousDayHigh or sweepSource == LiquiditySource.PreviousDayLow or sweepSource == LiquiditySource.PreviousWeekHigh or sweepSource == LiquiditySource.PreviousWeekLow
float bullishSweepContextScore = math.min(25.0, (bullishLiquiditySweep ? 12.0 : 0.0) + (bullishRecentSweep ? 6.0 : 0.0) + (bullishSweepSupportsRetest ? 4.0 : 0.0) + (bullishRecentSweep and significantSweepSource ? 3.0 : 0.0))
float bearishSweepContextScore = math.min(25.0, (bearishLiquiditySweep ? 12.0 : 0.0) + (bearishRecentSweep ? 6.0 : 0.0) + (bearishSweepSupportsRetest ? 4.0 : 0.0) + (bearishRecentSweep and significantSweepSource ? 3.0 : 0.0))
float bullishFvgContextScore = math.min(20.0, (latestBullishFvgActive ? 8.0 : 0.0) + (insideBullishFvg ? 6.0 : 0.0) + (bullishFvgSupportsRetest ? 4.0 : 0.0) + (not na(nearestBullishFvgDistanceATR) and nearestBullishFvgDistanceATR <= 1.0 ? 2.0 : 0.0))
float bearishFvgContextScore = math.min(20.0, (latestBearishFvgActive ? 8.0 : 0.0) + (insideBearishFvg ? 6.0 : 0.0) + (bearishFvgSupportsRetest ? 4.0 : 0.0) + (not na(nearestBearishFvgDistanceATR) and nearestBearishFvgDistanceATR <= 1.0 ? 2.0 : 0.0))
float bullishObContextScore = math.min(20.0, (latestBullishObActive ? 8.0 : 0.0) + (insideBullishOrderBlock ? 6.0 : 0.0) + (bullishObSupportsRetest ? 4.0 : 0.0) + (not na(nearestBullishObDistanceATR) and nearestBullishObDistanceATR <= 1.0 ? 2.0 : 0.0))
float bearishObContextScore = math.min(20.0, (latestBearishObActive ? 8.0 : 0.0) + (insideBearishOrderBlock ? 6.0 : 0.0) + (bearishObSupportsRetest ? 4.0 : 0.0) + (not na(nearestBearishObDistanceATR) and nearestBearishObDistanceATR <= 1.0 ? 2.0 : 0.0))
float bullishEqualLevelScore = math.min(10.0, (equalLowActive ? 6.0 : 0.0) + (bullishRecentSweep and sweepSource == LiquiditySource.EqualLow ? 4.0 : 0.0))
float bearishEqualLevelScore = math.min(10.0, (equalHighActive ? 6.0 : 0.0) + (bearishRecentSweep and sweepSource == LiquiditySource.EqualHigh ? 4.0 : 0.0))
float bullishHtfLiquidityScore = math.min(15.0, (bullishRecentSweep and (sweepSource == LiquiditySource.PreviousDayLow or sweepSource == LiquiditySource.PreviousWeekLow) ? 10.0 : 0.0) + (not na(distanceToPDL) and distanceToPDL <= atrValue ? 3.0 : 0.0) + (not na(distanceToPWL) and distanceToPWL <= atrValue ? 2.0 : 0.0))
float bearishHtfLiquidityScore = math.min(15.0, (bearishRecentSweep and (sweepSource == LiquiditySource.PreviousDayHigh or sweepSource == LiquiditySource.PreviousWeekHigh) ? 10.0 : 0.0) + (not na(distanceToPDH) and distanceToPDH <= atrValue ? 3.0 : 0.0) + (not na(distanceToPWH) and distanceToPWH <= atrValue ? 2.0 : 0.0))
float bullishPremiumDiscountScore = bullishDiscountSupportsRetest ? 10.0 : premiumDiscountState == PremiumDiscountState.Discount ? 7.0 : premiumDiscountState == PremiumDiscountState.Equilibrium ? 3.0 : 0.0
float bearishPremiumDiscountScore = bearishPremiumSupportsRetest ? 10.0 : premiumDiscountState == PremiumDiscountState.Premium ? 7.0 : premiumDiscountState == PremiumDiscountState.Equilibrium ? 3.0 : 0.0
bullishSmartMoneyScore := math.min(100.0, bullishSweepContextScore + bullishFvgContextScore + bullishObContextScore + bullishEqualLevelScore + bullishHtfLiquidityScore + bullishPremiumDiscountScore)
bearishSmartMoneyScore := math.min(100.0, bearishSweepContextScore + bearishFvgContextScore + bearishObContextScore + bearishEqualLevelScore + bearishHtfLiquidityScore + bearishPremiumDiscountScore)
smartMoneyBias := bullishSmartMoneyScore - bearishSmartMoneyScore >= smartMoneyBiasMinimumDifference ? SmartMoneyBias.Bullish : bearishSmartMoneyScore - bullishSmartMoneyScore >= smartMoneyBiasMinimumDifference ? SmartMoneyBias.Bearish : SmartMoneyBias.Neutral
float dominantSmartMoneyScore = math.max(bullishSmartMoneyScore, bearishSmartMoneyScore)
smartMoneyStrength := dominantSmartMoneyScore >= 85.0 ? SmartMoneyStrength.Extreme : dominantSmartMoneyScore >= 65.0 ? SmartMoneyStrength.Strong : dominantSmartMoneyScore >= 40.0 ? SmartMoneyStrength.Normal : SmartMoneyStrength.Weak
float bullishSessionScore = math.min(10.0, (sessionState.isActive ? 2.0 : 0.0) + (rangeState.isComplete ? 2.0 : 0.0) + (rangeState.qualityAccepted ? 3.0 : 0.0) + (breakoutRangeQualityValid ? 3.0 : 0.0))
float bearishSessionScore = bullishSessionScore
float bullishTrendScore = math.min(20.0, (trendState.direction == TrendDirection.Bullish ? 5.0 : 0.0) + (trendState.htfFastEma > trendState.htfSlowEma ? 5.0 : 0.0) + (close > trendState.vwapValue ? 3.0 : 0.0) + (trendState.isTrending and trendState.plusDi > trendState.minusDi ? 3.0 : 0.0) + ((trendState.structure == MarketStructure.HigherHigh or trendState.structure == MarketStructure.HigherLow) ? 4.0 : 0.0))
float bearishTrendScore = math.min(20.0, (trendState.direction == TrendDirection.Bearish ? 5.0 : 0.0) + (trendState.htfFastEma < trendState.htfSlowEma ? 5.0 : 0.0) + (close < trendState.vwapValue ? 3.0 : 0.0) + (trendState.isTrending and trendState.minusDi > trendState.plusDi ? 3.0 : 0.0) + ((trendState.structure == MarketStructure.LowerHigh or trendState.structure == MarketStructure.LowerLow) ? 4.0 : 0.0))
bool bullishBreakoutContext = breakoutState == BreakoutState.BullishConfirmed and breakoutTradeDirection == TradeDirection.Long and not breakoutFailed
bool bearishBreakoutContext = breakoutState == BreakoutState.BearishConfirmed and breakoutTradeDirection == TradeDirection.Short and not breakoutFailed
float bullishTradeBreakoutScore = bullishBreakoutContext ? math.min(25.0, math.max(0.0, bullishBreakoutScore * 0.25)) : 0.0
float bearishTradeBreakoutScore = bearishBreakoutContext ? math.min(25.0, math.max(0.0, bearishBreakoutScore * 0.25)) : 0.0
bool bullishTradeRetestContext = retestTradeDirection == TradeDirection.Long and (retestState == RetestState.RetestDetected or retestState == RetestState.RetestConfirmed) and not retestFailed
bool bearishTradeRetestContext = retestTradeDirection == TradeDirection.Short and (retestState == RetestState.RetestDetected or retestState == RetestState.RetestConfirmed) and not retestFailed
float bullishRetestSourceScore = retestState == RetestState.RetestConfirmed ? retestScore : bullishRetestScore
float bearishRetestSourceScore = retestState == RetestState.RetestConfirmed ? retestScore : bearishRetestScore
float bullishTradeRetestScore = bullishTradeRetestContext and not na(bullishRetestSourceScore) ? math.min(25.0, math.max(0.0, bullishRetestSourceScore * 0.25)) : 0.0
float bearishTradeRetestScore = bearishTradeRetestContext and not na(bearishRetestSourceScore) ? math.min(25.0, math.max(0.0, bearishRetestSourceScore * 0.25)) : 0.0
float bullishTradeSmartMoneyScore = math.min(20.0, math.max(0.0, bullishSmartMoneyScore * 0.20))
float bearishTradeSmartMoneyScore = math.min(20.0, math.max(0.0, bearishSmartMoneyScore * 0.20))
float bullishTradeScoreRaw = math.min(100.0, math.max(0.0, bullishSessionScore + bullishTrendScore + bullishTradeBreakoutScore + bullishTradeRetestScore + bullishTradeSmartMoneyScore))
float bearishTradeScoreRaw = math.min(100.0, math.max(0.0, bearishSessionScore + bearishTrendScore + bearishTradeBreakoutScore + bearishTradeRetestScore + bearishTradeSmartMoneyScore))
bool bullishSessionGate = sessionState.isActive and rangeState.isComplete and rangeState.qualityAccepted and breakoutRangeQualityValid
bool bearishSessionGate = bullishSessionGate
bool bullishBreakoutGate = not requireBreakoutConfirmationForScore or bullishBreakoutContext
bool bearishBreakoutGate = not requireBreakoutConfirmationForScore or bearishBreakoutContext
bool bullishRetestGate = not requireRetestConfirmationForScore or (retestState == RetestState.RetestConfirmed and retestTradeDirection == TradeDirection.Long and not retestFailed)
bool bearishRetestGate = not requireRetestConfirmationForScore or (retestState == RetestState.RetestConfirmed and retestTradeDirection == TradeDirection.Short and not retestFailed)
bool bullishTrendGate = (not requireTrendAlignmentForScore or trendState.direction == TrendDirection.Bullish) and bullishTrendScore >= minimumTradeTrendScore
bool bearishTrendGate = (not requireTrendAlignmentForScore or trendState.direction == TrendDirection.Bearish) and bearishTrendScore >= minimumTradeTrendScore
bool bullishSmartMoneyGate = bullishTradeSmartMoneyScore >= minimumTradeSmartMoneyScore
bool bearishSmartMoneyGate = bearishTradeSmartMoneyScore >= minimumTradeSmartMoneyScore
bool bullishComponentMinimumsPass = bullishTradeBreakoutScore >= minimumTradeBreakoutScore and bullishTradeRetestScore >= minimumTradeRetestScore
bool bearishComponentMinimumsPass = bearishTradeBreakoutScore >= minimumTradeBreakoutScore and bearishTradeRetestScore >= minimumTradeRetestScore
bool bullishMandatoryGatePass = bullishSessionGate and bullishBreakoutGate and bullishRetestGate and bullishTrendGate and bullishSmartMoneyGate and bullishComponentMinimumsPass
bool bearishMandatoryGatePass = bearishSessionGate and bearishBreakoutGate and bearishRetestGate and bearishTrendGate and bearishSmartMoneyGate and bearishComponentMinimumsPass
bool bullishHardDisqualified = not bullishSessionGate or (requireBreakoutConfirmationForScore and (breakoutState == BreakoutState.BullishFailed or breakoutState == BreakoutState.Invalidated)) or (requireRetestConfirmationForScore and retestTradeDirection == TradeDirection.Long and (retestState == RetestState.RetestFailed or retestState == RetestState.Expired))
bool bearishHardDisqualified = not bearishSessionGate or (requireBreakoutConfirmationForScore and (breakoutState == BreakoutState.BearishFailed or breakoutState == BreakoutState.Invalidated)) or (requireRetestConfirmationForScore and retestTradeDirection == TradeDirection.Short and (retestState == RetestState.RetestFailed or retestState == RetestState.Expired))
bool bullishLateRetest = retestTradeDirection == TradeDirection.Long and not na(retestBarsSinceBreakout) and (retestWindowMode == RetestWindowMode.Bars ? retestBarsSinceBreakout > retestWindowValue * 0.75 : not na(retestStartTime) and time - retestStartTime > retestWindowValue * MILLISECONDS_PER_MINUTE * 0.75)
bool bearishLateRetest = retestTradeDirection == TradeDirection.Short and not na(retestBarsSinceBreakout) and (retestWindowMode == RetestWindowMode.Bars ? retestBarsSinceBreakout > retestWindowValue * 0.75 : not na(retestStartTime) and time - retestStartTime > retestWindowValue * MILLISECONDS_PER_MINUTE * 0.75)
float bullishTradePenalty = enableSetupPenalties ? math.min(100.0, ((breakoutState == BreakoutState.BullishFailed or (retestTradeDirection == TradeDirection.Long and retestFailed)) ? failedContextPenalty : 0.0) + (trendState.direction == TrendDirection.Bearish ? opposingTrendPenalty : 0.0) + (smartMoneyBias == SmartMoneyBias.Bearish ? opposingSmartMoneyPenalty : 0.0) + (bullishBreakoutContext and not na(breakoutDistanceATR) and breakoutDistanceATR > maximumPreferredBreakoutDistanceAtr ? excessiveBreakoutDistancePenalty : 0.0) + (bullishLateRetest ? lateRetestPenalty : 0.0)) : 0.0
float bearishTradePenalty = enableSetupPenalties ? math.min(100.0, ((breakoutState == BreakoutState.BearishFailed or (retestTradeDirection == TradeDirection.Short and retestFailed)) ? failedContextPenalty : 0.0) + (trendState.direction == TrendDirection.Bullish ? opposingTrendPenalty : 0.0) + (smartMoneyBias == SmartMoneyBias.Bullish ? opposingSmartMoneyPenalty : 0.0) + (bearishBreakoutContext and not na(breakoutDistanceATR) and breakoutDistanceATR > maximumPreferredBreakoutDistanceAtr ? excessiveBreakoutDistancePenalty : 0.0) + (bearishLateRetest ? lateRetestPenalty : 0.0)) : 0.0
float bullishTradeScoreAdjusted = math.min(100.0, math.max(0.0, bullishTradeScoreRaw - bullishTradePenalty))
float bearishTradeScoreAdjusted = math.min(100.0, math.max(0.0, bearishTradeScoreRaw - bearishTradePenalty))
bullishTradeScore := tradeScoringEnabled ? bullishTradeScoreAdjusted : 0.0
bearishTradeScore := tradeScoringEnabled ? bearishTradeScoreAdjusted : 0.0

//==============================================================================
// 19. M7-C SETUP QUALIFICATION AND LIFECYCLE
//==============================================================================
// The threshold applies only when a setup is created. Once qualified, its
// lifecycle is controlled by the mandatory contextual gates and M2/M4/M5 state,
// rather than transient score fluctuations caused by bounded penalties.
bool bullishScoreThresholdPass = not na(bullishTradeScore) and bullishTradeScore >= tradeQualificationThreshold
bool bearishScoreThresholdPass = not na(bearishTradeScore) and bearishTradeScore >= tradeQualificationThreshold
bool bullishCurrentLifecycleValid = bullishBreakoutContext and bullishTradeRetestContext
bool bearishCurrentLifecycleValid = bearishBreakoutContext and bearishTradeRetestContext
bool bullishTradeQualificationCandidate = tradeScoringEnabled and barstate.isconfirmed and bullishMandatoryGatePass and not bullishHardDisqualified and bullishScoreThresholdPass and bullishCurrentLifecycleValid
bool bearishTradeQualificationCandidate = tradeScoringEnabled and barstate.isconfirmed and bearishMandatoryGatePass and not bearishHardDisqualified and bearishScoreThresholdPass and bearishCurrentLifecycleValid
float tradeScoreDifference = not na(bullishTradeScore) and not na(bearishTradeScore) ? math.abs(bullishTradeScore - bearishTradeScore) : na
float bullishScoreLead = not na(bullishTradeScore) and not na(bearishTradeScore) ? bullishTradeScore - bearishTradeScore : na
float bearishScoreLead = not na(bullishTradeScore) and not na(bearishTradeScore) ? bearishTradeScore - bullishTradeScore : na
bool dualQualification = bullishTradeQualificationCandidate and bearishTradeQualificationCandidate
bool bullishDualLead = dualQualification and not na(bullishScoreLead) and bullishScoreLead > 0.0
bool bearishDualLead = dualQualification and not na(bearishScoreLead) and bearishScoreLead > 0.0
bool directionalDifferenceMeetsMinimum = not na(tradeScoreDifference) and tradeScoreDifference > 0.0 and tradeScoreDifference >= minimumDirectionalScoreDifference
bool dualQualificationConflict = dualQualification and not directionalDifferenceMeetsMinimum
bool bullishDirectionSelected = (bullishTradeQualificationCandidate and not bearishTradeQualificationCandidate) or (bullishDualLead and (directionalDifferenceMeetsMinimum or not rejectDirectionalConflict))
bool bearishDirectionSelected = (bearishTradeQualificationCandidate and not bullishTradeQualificationCandidate) or (bearishDualLead and (directionalDifferenceMeetsMinimum or not rejectDirectionalConflict))
bool unresolvedDirectionalConflict = dualQualificationConflict and (rejectDirectionalConflict or (not bullishDualLead and not bearishDualLead))

// Qualification events are explicitly reset on every bar and are asserted only
// on entry to a new final directional setup.
bullishTradeQualifiedEvent := false
bearishTradeQualifiedEvent := false

bool bullishActiveSetup = tradeSetupState == TradeSetupState.BullishQualified
bool bearishActiveSetup = tradeSetupState == TradeSetupState.BearishQualified
bool bullishLifecycleExpired = sessionState.justEnded or not sessionState.isActive or (retestTradeDirection == TradeDirection.Long and retestState == RetestState.Expired)
bool bearishLifecycleExpired = sessionState.justEnded or not sessionState.isActive or (retestTradeDirection == TradeDirection.Short and retestState == RetestState.Expired)
bool bullishLifecycleFailed = bullishHardDisqualified or breakoutState == BreakoutState.BullishFailed or breakoutState == BreakoutState.Invalidated or (retestTradeDirection == TradeDirection.Long and retestState == RetestState.RetestFailed)
bool bearishLifecycleFailed = bearishHardDisqualified or breakoutState == BreakoutState.BearishFailed or breakoutState == BreakoutState.Invalidated or (retestTradeDirection == TradeDirection.Short and retestState == RetestState.RetestFailed)
bool bullishLifecycleStale = not bullishCurrentLifecycleValid and not bullishLifecycleFailed and not bearishCurrentLifecycleValid
bool bearishLifecycleStale = not bearishCurrentLifecycleValid and not bearishLifecycleFailed and not bullishCurrentLifecycleValid
bool bullishContextInvalid = not bullishMandatoryGatePass or bearishCurrentLifecycleValid
bool bearishContextInvalid = not bearishMandatoryGatePass or bullishCurrentLifecycleValid

// A fresh M2 session clears M7-only setup data. M2 through M6 state remains
// exclusively owned by its existing engines.
if sessionState.justStarted
    tradeSetupState := TradeSetupState.None
    tradeBias := TradeBias.None
    tradeSetupBarIndex := na
    tradeSetupScore := na
    tradeSetupDirection := TradeBias.None
else if bullishActiveSetup
    if bullishLifecycleExpired or bullishLifecycleStale
        tradeSetupState := TradeSetupState.Expired
        tradeBias := TradeBias.None
        tradeSetupBarIndex := na
        tradeSetupScore := na
        tradeSetupDirection := TradeBias.None
    else if bullishLifecycleFailed or bullishContextInvalid
        tradeSetupState := TradeSetupState.Disqualified
        tradeBias := TradeBias.None
        tradeSetupBarIndex := na
        tradeSetupScore := na
        tradeSetupDirection := TradeBias.None
    else if unresolvedDirectionalConflict
        tradeSetupState := TradeSetupState.Conflict
        tradeBias := TradeBias.Neutral
        tradeSetupBarIndex := na
        tradeSetupScore := na
        tradeSetupDirection := TradeBias.None
else if bearishActiveSetup
    if bearishLifecycleExpired or bearishLifecycleStale
        tradeSetupState := TradeSetupState.Expired
        tradeBias := TradeBias.None
        tradeSetupBarIndex := na
        tradeSetupScore := na
        tradeSetupDirection := TradeBias.None
    else if bearishLifecycleFailed or bearishContextInvalid
        tradeSetupState := TradeSetupState.Disqualified
        tradeBias := TradeBias.None
        tradeSetupBarIndex := na
        tradeSetupScore := na
        tradeSetupDirection := TradeBias.None
    else if unresolvedDirectionalConflict
        tradeSetupState := TradeSetupState.Conflict
        tradeBias := TradeBias.Neutral
        tradeSetupBarIndex := na
        tradeSetupScore := na
        tradeSetupDirection := TradeBias.None
else
    if unresolvedDirectionalConflict
        tradeSetupState := TradeSetupState.Conflict
        tradeBias := TradeBias.Neutral
        tradeSetupBarIndex := na
        tradeSetupScore := na
        tradeSetupDirection := TradeBias.None
    else if bullishDirectionSelected
        tradeSetupState := TradeSetupState.BullishQualified
        tradeBias := TradeBias.Bullish
        tradeSetupBarIndex := bar_index
        tradeSetupScore := bullishTradeScore
        tradeSetupDirection := TradeBias.Bullish
        bullishTradeQualifiedEvent := true
    else if bearishDirectionSelected
        tradeSetupState := TradeSetupState.BearishQualified
        tradeBias := TradeBias.Bearish
        tradeSetupBarIndex := bar_index
        tradeSetupScore := bearishTradeScore
        tradeSetupDirection := TradeBias.Bearish
        bearishTradeQualifiedEvent := true
    else if tradeSetupState == TradeSetupState.Conflict
        tradeSetupState := TradeSetupState.None
        tradeBias := TradeBias.None
        tradeSetupBarIndex := na
        tradeSetupScore := na
        tradeSetupDirection := TradeBias.None

// Current-state outputs are derived from the owned enum, so both directions
// cannot qualify simultaneously. Setup strength is diagnostic and only applies
// to an active qualified setup with a valid stored origin score.
bullishTradeQualified := tradeSetupState == TradeSetupState.BullishQualified
bearishTradeQualified := tradeSetupState == TradeSetupState.BearishQualified
tradeSetupStrength := (bullishTradeQualified or bearishTradeQualified) and not na(tradeSetupScore) ? tradeSetupScore >= 90.0 ? TradeSetupStrength.Extreme : tradeSetupScore >= 75.0 ? TradeSetupStrength.Strong : tradeSetupScore >= 60.0 ? TradeSetupStrength.Normal : TradeSetupStrength.Weak : TradeSetupStrength.Weak

//==============================================================================
// 20. M8-A INITIAL STOP AND RISK-DISTANCE ENGINE
//==============================================================================
// M8-A captures an initial context only on a new M7 qualification event. It
// deliberately does not move stops after capture; dynamic management is M9.
bool newBullishRiskContext = riskEngineEnabled and bullishTradeQualifiedEvent and tradeSetupDirection == TradeBias.Bullish
bool newBearishRiskContext = riskEngineEnabled and bearishTradeQualifiedEvent and tradeSetupDirection == TradeBias.Bearish
bool newRiskContext = newBullishRiskContext or newBearishRiskContext
TradeBias newRiskDirection = newBullishRiskContext ? TradeBias.Bullish : newBearishRiskContext ? TradeBias.Bearish : TradeBias.None
float riskEntryCandidate = newRiskContext and barstate.isconfirmed ? close : na
float swingStopBufferPrice = swingStopBufferTicks * syminfo.mintick
float rangeStopBufferPrice = rangeStopBufferTicks * syminfo.mintick
float retestStructureBufferPrice = syminfo.mintick

// Candidate stops use only confirmed state from earlier modules. The retest
// candidate is placed beyond the actual completed retest penetration, with a
// one-tick structural buffer, and is valid only inside M5's allowed boundary.
float bullishAtrStopCandidate = not na(riskEntryCandidate) and not na(atrValue) ? riskEntryCandidate - atrValue * atrStopMultiplier : na
float bearishAtrStopCandidate = not na(riskEntryCandidate) and not na(atrValue) ? riskEntryCandidate + atrValue * atrStopMultiplier : na
float bullishSwingStopCandidate = not na(riskEntryCandidate) and not na(trendState.swingLow) ? trendState.swingLow - swingStopBufferPrice : na
float bearishSwingStopCandidate = not na(riskEntryCandidate) and not na(trendState.swingHigh) ? trendState.swingHigh + swingStopBufferPrice : na
float bullishRangeStopCandidate = not na(riskEntryCandidate) and rangeState.isComplete and rangeState.qualityAccepted and not na(rangeState.low) ? rangeState.low - rangeStopBufferPrice : na
float bearishRangeStopCandidate = not na(riskEntryCandidate) and rangeState.isComplete and rangeState.qualityAccepted and not na(rangeState.high) ? rangeState.high + rangeStopBufferPrice : na
bool bullishRetestStructureValid = retestTradeDirection == TradeDirection.Long and retestState == RetestState.RetestConfirmed and not na(retestLevel) and not na(retestPenetration) and not na(maximumRetestPenetration) and retestPenetration >= 0.0 and retestPenetration <= maximumRetestPenetration
bool bearishRetestStructureValid = retestTradeDirection == TradeDirection.Short and retestState == RetestState.RetestConfirmed and not na(retestLevel) and not na(retestPenetration) and not na(maximumRetestPenetration) and retestPenetration >= 0.0 and retestPenetration <= maximumRetestPenetration
float bullishRetestStopCandidate = not na(riskEntryCandidate) and bullishRetestStructureValid ? retestLevel - retestPenetration - retestStructureBufferPrice : na
float bearishRetestStopCandidate = not na(riskEntryCandidate) and bearishRetestStructureValid ? retestLevel + retestPenetration + retestStructureBufferPrice : na
bool bullishAtrStopValid = not na(bullishAtrStopCandidate) and not na(riskEntryCandidate) and bullishAtrStopCandidate < riskEntryCandidate
bool bearishAtrStopValid = not na(bearishAtrStopCandidate) and not na(riskEntryCandidate) and bearishAtrStopCandidate > riskEntryCandidate
bool bullishSwingStopValid = not na(bullishSwingStopCandidate) and not na(riskEntryCandidate) and bullishSwingStopCandidate < riskEntryCandidate
bool bearishSwingStopValid = not na(bearishSwingStopCandidate) and not na(riskEntryCandidate) and bearishSwingStopCandidate > riskEntryCandidate
bool bullishRangeStopValid = not na(bullishRangeStopCandidate) and not na(riskEntryCandidate) and bullishRangeStopCandidate < riskEntryCandidate
bool bearishRangeStopValid = not na(bearishRangeStopCandidate) and not na(riskEntryCandidate) and bearishRangeStopCandidate > riskEntryCandidate
bool bullishRetestStopValid = not na(bullishRetestStopCandidate) and not na(riskEntryCandidate) and bullishRetestStopCandidate < riskEntryCandidate
bool bearishRetestStopValid = not na(bearishRetestStopCandidate) and not na(riskEntryCandidate) and bearishRetestStopCandidate > riskEntryCandidate

// Conservative selection chooses the furthest directionally-valid structural
// stop: the lowest long stop or highest short stop. Invalid/na candidates are
// excluded before comparison.
float bullishConservativeStopCandidate = na
if bullishAtrStopValid
    bullishConservativeStopCandidate := bullishAtrStopCandidate
if bullishSwingStopValid
    bullishConservativeStopCandidate := na(bullishConservativeStopCandidate) ? bullishSwingStopCandidate : math.min(bullishConservativeStopCandidate, bullishSwingStopCandidate)
if bullishRangeStopValid
    bullishConservativeStopCandidate := na(bullishConservativeStopCandidate) ? bullishRangeStopCandidate : math.min(bullishConservativeStopCandidate, bullishRangeStopCandidate)
if bullishRetestStopValid
    bullishConservativeStopCandidate := na(bullishConservativeStopCandidate) ? bullishRetestStopCandidate : math.min(bullishConservativeStopCandidate, bullishRetestStopCandidate)
float bearishConservativeStopCandidate = na
if bearishAtrStopValid
    bearishConservativeStopCandidate := bearishAtrStopCandidate
if bearishSwingStopValid
    bearishConservativeStopCandidate := na(bearishConservativeStopCandidate) ? bearishSwingStopCandidate : math.max(bearishConservativeStopCandidate, bearishSwingStopCandidate)
if bearishRangeStopValid
    bearishConservativeStopCandidate := na(bearishConservativeStopCandidate) ? bearishRangeStopCandidate : math.max(bearishConservativeStopCandidate, bearishRangeStopCandidate)
if bearishRetestStopValid
    bearishConservativeStopCandidate := na(bearishConservativeStopCandidate) ? bearishRetestStopCandidate : math.max(bearishConservativeStopCandidate, bearishRetestStopCandidate)

float selectedRiskStopCandidate = na
StopSource selectedRiskStopSource = StopSource.None
if newBullishRiskContext
    if stopLossMode == StopLossMode.ATR
        selectedRiskStopCandidate := bullishAtrStopCandidate
        selectedRiskStopSource := StopSource.ATR
    else if stopLossMode == StopLossMode.Swing
        selectedRiskStopCandidate := bullishSwingStopCandidate
        selectedRiskStopSource := StopSource.Swing
    else if stopLossMode == StopLossMode.OpeningRange
        selectedRiskStopCandidate := bullishRangeStopCandidate
        selectedRiskStopSource := StopSource.OpeningRange
    else if stopLossMode == StopLossMode.RetestStructure
        selectedRiskStopCandidate := bullishRetestStopCandidate
        selectedRiskStopSource := StopSource.Retest
    else
        selectedRiskStopCandidate := bullishConservativeStopCandidate
        selectedRiskStopSource := StopSource.Conservative
else if newBearishRiskContext
    if stopLossMode == StopLossMode.ATR
        selectedRiskStopCandidate := bearishAtrStopCandidate
        selectedRiskStopSource := StopSource.ATR
    else if stopLossMode == StopLossMode.Swing
        selectedRiskStopCandidate := bearishSwingStopCandidate
        selectedRiskStopSource := StopSource.Swing
    else if stopLossMode == StopLossMode.OpeningRange
        selectedRiskStopCandidate := bearishRangeStopCandidate
        selectedRiskStopSource := StopSource.OpeningRange
    else if stopLossMode == StopLossMode.RetestStructure
        selectedRiskStopCandidate := bearishRetestStopCandidate
        selectedRiskStopSource := StopSource.Retest
    else
        selectedRiskStopCandidate := bearishConservativeStopCandidate
        selectedRiskStopSource := StopSource.Conservative
bool selectedRiskStopValid = newRiskDirection == TradeBias.Bullish ? not na(selectedRiskStopCandidate) and selectedRiskStopCandidate < riskEntryCandidate : newRiskDirection == TradeBias.Bearish ? not na(selectedRiskStopCandidate) and selectedRiskStopCandidate > riskEntryCandidate : false
float selectedRiskDistance = selectedRiskStopValid ? newRiskDirection == TradeBias.Bullish ? riskEntryCandidate - selectedRiskStopCandidate : selectedRiskStopCandidate - riskEntryCandidate : na
float selectedRiskDistanceATR = selectedRiskStopValid ? SafeDivide(selectedRiskDistance, atrValue, na) : na

// Risk context is reset only by M2/M7 lifecycle boundaries or when disabled;
// a later M7 event overwrites it as a new initial-risk context.
bool riskContextResetRequired = not riskEngineEnabled or sessionState.justStarted or tradeSetupState == TradeSetupState.Disqualified or tradeSetupState == TradeSetupState.Expired or not (bullishTradeQualified or bearishTradeQualified)
if riskContextResetRequired
    riskEntryPrice := na
    riskStopPrice := na
    riskDistance := na
    riskDistanceATR := na
    riskStopSource := StopSource.None
    riskDirection := TradeBias.None
    riskSetupBarIndex := na
    riskContextActive := false
else if newRiskContext
    riskEntryPrice := riskEntryCandidate
    riskStopPrice := selectedRiskStopValid ? selectedRiskStopCandidate : na
    riskDistance := selectedRiskDistance
    riskDistanceATR := selectedRiskDistanceATR
    riskStopSource := selectedRiskStopValid ? selectedRiskStopSource : StopSource.None
    riskDirection := newRiskDirection
    riskSetupBarIndex := bar_index
    riskContextActive := true

// Exposed M8-A outputs mirror the fixed context and are inactive outside an
// M7-qualified setup. Stop-distance validation is diagnostic only in M8-A.
float proposedEntryPrice = riskContextActive ? riskEntryPrice : na
float proposedStopPrice = riskContextActive ? riskStopPrice : na
bool proposedStopValid = riskContextActive and not na(proposedEntryPrice) and not na(proposedStopPrice) and (riskDirection == TradeBias.Bullish ? proposedStopPrice < proposedEntryPrice : riskDirection == TradeBias.Bearish ? proposedStopPrice > proposedEntryPrice : false)
float proposedRiskDistance = proposedStopValid ? riskDistance : na
float proposedRiskDistanceATR = proposedStopValid ? riskDistanceATR : na
bool stopDistanceValid = proposedStopValid and not na(proposedRiskDistance) and proposedRiskDistance > 0.0 and not na(proposedRiskDistanceATR) and minimumStopDistanceAtr <= maximumStopDistanceAtr and proposedRiskDistanceATR >= minimumStopDistanceAtr and proposedRiskDistanceATR <= maximumStopDistanceAtr
StopSource stopSource = riskContextActive ? riskStopSource : StopSource.None

//==============================================================================
// 21. M8-B FIXED RISK-BASED POSITION SIZING
//==============================================================================
// TradingView quantity and point-value semantics depend on the selected XAUUSD
// data feed/broker symbol. This quantity is valid for TradingView strategy
// economics using syminfo.pointvalue; live broker lot conversion must be
// verified separately before automation. No ounces-per-lot assumption is made.
float sizingEquityCandidate = accountEquitySource == AccountEquitySource.DynamicStrategyEquity ? strategy.equity : strategy.initial_capital
bool sizingEquityCandidateValid = not na(sizingEquityCandidate) and sizingEquityCandidate > 0.0
float riskPerUnitCandidate = riskContextActive and not na(riskDistance) and riskDistance > 0.0 and not na(syminfo.pointvalue) and syminfo.pointvalue > 0.0 ? riskDistance * syminfo.pointvalue : na
bool riskPerUnitCandidateValid = not na(riskPerUnitCandidate) and riskPerUnitCandidate > 0.0
float cashRiskTargetCandidate = positionSizingMode == PositionSizingMode.RiskPercent and sizingEquityCandidateValid ? sizingEquityCandidate * riskPerTradePercent * 0.01 : positionSizingMode == PositionSizingMode.FixedCashRisk ? fixedCashRisk : na
bool cashRiskTargetCandidateValid = not na(cashRiskTargetCandidate) and cashRiskTargetCandidate >= 0.0
float rawQuantityCandidate = positionSizingMode == PositionSizingMode.FixedQuantity ? fixedQuantity : cashRiskTargetCandidateValid and riskPerUnitCandidateValid ? SafeDivide(cashRiskTargetCandidate, riskPerUnitCandidate, na) : na
bool quantityStepValid = quantityStep > 0.0
float normalizedQuantityCandidate = not na(rawQuantityCandidate) and rawQuantityCandidate > 0.0 and quantityStepValid ? math.floor(rawQuantityCandidate / quantityStep) * quantityStep : na
float maximumNormalizedQuantity = quantityStepValid and maximumPositionQuantity > 0.0 ? math.floor(maximumPositionQuantity / quantityStep) * quantityStep : na
float cappedQuantityCandidate = not na(normalizedQuantityCandidate) and not na(maximumNormalizedQuantity) and normalizedQuantityCandidate > maximumPositionQuantity ? maximumNormalizedQuantity : normalizedQuantityCandidate
bool quantityWithinBoundsCandidate = not na(cappedQuantityCandidate) and cappedQuantityCandidate > 0.0 and cappedQuantityCandidate >= minimumPositionQuantity and cappedQuantityCandidate <= maximumPositionQuantity and not na(maximumNormalizedQuantity) and maximumNormalizedQuantity >= minimumPositionQuantity
float actualCashRiskCandidate = quantityWithinBoundsCandidate and riskPerUnitCandidateValid ? cappedQuantityCandidate * riskPerUnitCandidate : na
float actualRiskPercentCandidate = not na(actualCashRiskCandidate) and sizingEquityCandidateValid ? actualCashRiskCandidate * 100.0 / sizingEquityCandidate : na
float cashRiskToleranceCandidate = cashRiskTargetCandidateValid ? math.max(0.000001, cashRiskTargetCandidate * 0.000001) : na
bool riskBasedMode = positionSizingMode == PositionSizingMode.RiskPercent or positionSizingMode == PositionSizingMode.FixedCashRisk
bool positionRiskWithinLimitCandidate = riskBasedMode ? not na(actualCashRiskCandidate) and cashRiskTargetCandidateValid and actualCashRiskCandidate <= cashRiskTargetCandidate + cashRiskToleranceCandidate : positionSizingMode == PositionSizingMode.FixedQuantity
bool fixedQuantityRiskWithinLimit = positionSizingMode != PositionSizingMode.FixedQuantity or not na(actualRiskPercentCandidate) and actualRiskPercentCandidate <= maximumAllowedRiskPercent
bool positionSizingValidCandidate = riskEngineEnabled and newRiskContext and riskContextActive and proposedStopValid and stopDistanceValid and riskPerUnitCandidateValid and sizingEquityCandidateValid and quantityStepValid and quantityWithinBoundsCandidate and not na(actualCashRiskCandidate) and actualCashRiskCandidate >= 0.0 and positionRiskWithinLimitCandidate and fixedQuantityRiskWithinLimit

// Sizing state shares M8-A's lifecycle and is captured only once for each new
// setup. A quantity below the configured minimum is rejected, never raised;
// a quantity above the maximum is capped only after rounding down, reducing risk.
bool sizingContextResetRequired = riskContextResetRequired or not riskContextActive
if sizingContextResetRequired
    riskSizingEquity := na
    riskCashAmount := na
    riskRawQuantity := na
    riskQuantity := na
    riskPerUnitStored := na
    riskActualCashAmount := na
    riskActualPercent := na
    riskPositionRiskWithinLimit := false
    riskSizingValid := false
else if newRiskContext
    riskSizingEquity := sizingEquityCandidateValid ? sizingEquityCandidate : na
    riskCashAmount := positionSizingMode == PositionSizingMode.FixedQuantity ? actualCashRiskCandidate : cashRiskTargetCandidate
    riskRawQuantity := rawQuantityCandidate
    riskQuantity := quantityWithinBoundsCandidate ? cappedQuantityCandidate : na
    riskPerUnitStored := riskPerUnitCandidate
    riskActualCashAmount := actualCashRiskCandidate
    riskActualPercent := actualRiskPercentCandidate
    riskPositionRiskWithinLimit := positionRiskWithinLimitCandidate
    riskSizingValid := positionSizingValidCandidate

// Exposed outputs mirror the frozen sizing context; they never resize solely
// because strategy.equity or the current ATR changes after qualification.
float sizingEquity = riskContextActive ? riskSizingEquity : na
float proposedCashRisk = riskContextActive ? riskCashAmount : na
float riskPerUnit = riskContextActive ? riskPerUnitStored : na
float rawPositionQuantity = riskContextActive ? riskRawQuantity : na
float proposedPositionQuantity = riskContextActive ? riskQuantity : na
float actualCashRisk = riskContextActive ? riskActualCashAmount : na
float actualRiskPercent = riskContextActive ? riskActualPercent : na
bool positionRiskWithinLimit = riskContextActive and riskPositionRiskWithinLimit
bool positionSizingValid = riskContextActive and riskSizingValid

//==============================================================================
// 22. M8-C PROJECTED TARGETS, RR, AND FINAL RISK APPROVAL
//==============================================================================
// M8-C intentionally supports deterministic fixed-R targets only. Structural
// target selection and post-entry target management remain M9 responsibilities.
bool targetContextValid = riskContextActive and proposedStopValid and stopDistanceValid and not na(riskEntryPrice) and not na(riskStopPrice) and not na(riskDistance) and riskDistance > 0.0 and (riskDirection == TradeBias.Bullish or riskDirection == TradeBias.Bearish)
float tp1Candidate = newRiskContext and targetContextValid and tp1RMultiple > 0.0 ? riskDirection == TradeBias.Bullish ? riskEntryPrice + riskDistance * tp1RMultiple : riskEntryPrice - riskDistance * tp1RMultiple : na
float tp2Candidate = newRiskContext and targetContextValid and tp2RMultiple > 0.0 ? riskDirection == TradeBias.Bullish ? riskEntryPrice + riskDistance * tp2RMultiple : riskEntryPrice - riskDistance * tp2RMultiple : na
bool tp1CandidateValid = targetContextValid and not na(tp1Candidate) and (riskDirection == TradeBias.Bullish ? tp1Candidate > riskEntryPrice : tp1Candidate < riskEntryPrice)
bool tp2CandidateValid = targetContextValid and not na(tp2Candidate) and (riskDirection == TradeBias.Bullish ? tp2Candidate > riskEntryPrice : tp2Candidate < riskEntryPrice)
float rr1Candidate = tp1CandidateValid ? math.max(0.0, SafeDivide(math.abs(tp1Candidate - riskEntryPrice), riskDistance, na)) : na
float rr2Candidate = tp2CandidateValid ? math.max(0.0, SafeDivide(math.abs(tp2Candidate - riskEntryPrice), riskDistance, na)) : na
bool rr1CandidatePass = not na(rr1Candidate) and rr1Candidate >= minimumRequiredRr
bool rr2CandidatePass = not na(rr2Candidate) and rr2Candidate >= minimumRequiredRr
bool targetOrderingCandidateValid = tp1CandidateValid and tp2CandidateValid and (riskDirection == TradeBias.Bullish ? tp2Candidate > tp1Candidate and tp1Candidate > riskEntryPrice and riskEntryPrice > riskStopPrice : tp2Candidate < tp1Candidate and tp1Candidate < riskEntryPrice and riskEntryPrice < riskStopPrice)
bool requiredRrCandidatePass = requireTp2RrValidation ? rr2CandidatePass : rr1CandidatePass
bool m7RiskDirectionMatches = riskDirection == TradeBias.Bullish ? bullishTradeQualified and tradeSetupDirection == TradeBias.Bullish : riskDirection == TradeBias.Bearish ? bearishTradeQualified and tradeSetupDirection == TradeBias.Bearish : false
bool baseRiskApprovalCandidate = finalRiskApprovalEnabled and riskEngineEnabled and newRiskContext and targetOrderingCandidateValid and requiredRrCandidatePass and riskSizingValid and positionSizingValid and positionRiskWithinLimit and m7RiskDirectionMatches

// Targets and base-approval events are reset on every bar, then captured once
