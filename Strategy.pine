//============================================================================== 
// 5. UTILITY FUNCTIONS
//============================================================================== 
// Returns a TradingView session specification from two HHMM input values.
BuildSession(string startValue, string endValue) =>
    startValue + "-" + endValue

// Returns true when the current chart bar belongs to the supplied session.
IsInSession(string sessionSpec, string timezone) =>
    not na(time(timeframe.period, sessionSpec, timezone))

// Returns a readable name for a session enum value.
SessionText(SessionName sessionName) =>
    switch sessionName
        SessionName.Asia => "Asia"
        SessionName.London => "London"
        SessionName.NewYork => "New York"
        SessionName.Custom => "Custom"
        => "None"

// Returns a readable name for a breakout-state enum value.
StateText(BreakoutState state) =>
    switch state
        BreakoutState.BullishCandidate => "Bullish Candidate"
        BreakoutState.BearishCandidate => "Bearish Candidate"
        BreakoutState.BullishConfirmed => "Bullish Confirmed"
        BreakoutState.BearishConfirmed => "Bearish Confirmed"
        BreakoutState.BullishFailed => "Bullish Failed"
        BreakoutState.BearishFailed => "Bearish Failed"
        BreakoutState.Invalidated => "Invalidated"
        => "None"

// Returns a display label for an M4 breakout direction.
BreakoutDirectionText(TradeDirection direction) =>
    direction == TradeDirection.Long ? "Bullish" : direction == TradeDirection.Short ? "Bearish" : "None"

// Returns a display label for every M4 breakout-strength enum member.
BreakoutStrengthText(BreakoutStrength strength) =>
    strength == BreakoutStrength.Extreme ? "Extreme" : strength == BreakoutStrength.Strong ? "Strong" : strength == BreakoutStrength.Normal ? "Normal" : "Weak"

// Returns a display label for every M5 retest-state enum member.
RetestStateText(RetestState state) =>
    state == RetestState.WaitingForRetest ? "Waiting" : state == RetestState.RetestDetected ? "Detected" : state == RetestState.RetestConfirmed ? "Confirmed" : state == RetestState.RetestFailed ? "Failed" : state == RetestState.Expired ? "Expired" : "None"

// Returns a display label for an M5 retest direction.
RetestDirectionText(TradeDirection direction) =>
    direction == TradeDirection.Long ? "Bullish" : direction == TradeDirection.Short ? "Bearish" : "None"

LiquiditySourceText(series LiquiditySource source) =>
    source == LiquiditySource.EqualHigh ? "Equal High" : source == LiquiditySource.EqualLow ? "Equal Low" : source == LiquiditySource.PreviousDayHigh ? "PDH" : source == LiquiditySource.PreviousDayLow ? "PDL" : source == LiquiditySource.PreviousWeekHigh ? "PWH" : source == LiquiditySource.PreviousWeekLow ? "PWL" : source == LiquiditySource.SwingHigh ? "Swing High" : source == LiquiditySource.SwingLow ? "Swing Low" : source == LiquiditySource.OpeningRangeHigh ? "OR High" : source == LiquiditySource.OpeningRangeLow ? "OR Low" : "None"

SweepStrengthText(series SweepStrength strength) =>
    strength == SweepStrength.Extreme ? "Extreme" : strength == SweepStrength.Strong ? "Strong" : strength == SweepStrength.Normal ? "Normal" : "Weak"

PremiumDiscountText(series PremiumDiscountState state) =>
    state == PremiumDiscountState.Premium ? "Premium" : state == PremiumDiscountState.Discount ? "Discount" : state == PremiumDiscountState.Equilibrium ? "Equilibrium" : "Unknown"

SmartMoneyBiasText(series SmartMoneyBias bias) =>
    bias == SmartMoneyBias.Bullish ? "Bullish" : bias == SmartMoneyBias.Bearish ? "Bearish" : "Neutral"

SmartMoneyStrengthText(series SmartMoneyStrength strength) =>
    strength == SmartMoneyStrength.Extreme ? "Extreme" : strength == SmartMoneyStrength.Strong ? "Strong" : strength == SmartMoneyStrength.Normal ? "Normal" : "Weak"

// Returns a readable label for every M7 setup-lifecycle state.
TradeSetupStateText(series TradeSetupState state) =>
    state == TradeSetupState.BullishQualified ? "Bullish Qualified" : state == TradeSetupState.BearishQualified ? "Bearish Qualified" : state == TradeSetupState.Conflict ? "Conflict" : state == TradeSetupState.Disqualified ? "Disqualified" : state == TradeSetupState.Expired ? "Expired" : "None"

// Returns a readable label for the M7-owned final trade bias.
TradeBiasText(series TradeBias bias) =>
    bias == TradeBias.Bullish ? "Bullish" : bias == TradeBias.Bearish ? "Bearish" : bias == TradeBias.Neutral ? "Neutral" : "None"

// Returns a readable label for every M7 setup-strength classification.
TradeSetupStrengthText(series TradeSetupStrength strength) =>
    strength == TradeSetupStrength.Extreme ? "Extreme" : strength == TradeSetupStrength.Strong ? "Strong" : strength == TradeSetupStrength.Normal ? "Normal" : "Weak"

// Formats a nullable decimal value for the dashboard without displaying na.
FormatValueOrDash(float value) =>
    na(value) ? "-" : str.tostring(value, "#.##")

// Formats a nullable integer value for the dashboard without displaying na.
FormatIntOrDash(int value) =>
    na(value) ? "-" : str.tostring(value)

// Prevents division-by-zero while preserving a caller supplied fallback value.
SafeDivide(float numerator, float denominator, float fallback) =>
    denominator != 0.0 ? numerator / denominator : fallback

// Formats a price using the chart symbol's minimum tick size.
FormatPrice(float price) =>
    na(price) ? "n/a" : str.tostring(price, format.mintick)

// Formats a decimal number as a concise percentage string.
FormatPercent(float value) =>
    na(value) ? "n/a" : str.tostring(value, "#.##") + "%"

// Converts the opening-range input selection into an integer minute duration.
OpeningRangeMinutes() =>
    int(str.tonumber(openingRangeLength))

// Converts a HHMM session input into minutes since midnight.
MinutesFromHhmm(string timeValue) =>
    int hours = int(str.tonumber(str.substring(timeValue, 0, 2)))
    int minutes = int(str.tonumber(str.substring(timeValue, 2, 4)))
    hours * 60 + minutes

// Returns the configured duration for one session, including midnight crossings.
SessionDurationMinutes(SessionName sessionName) =>
    string startValue = sessionName == SessionName.Asia ? asiaStart : sessionName == SessionName.London ? londonStart : sessionName == SessionName.NewYork ? newYorkStart : customStart
    string endValue = sessionName == SessionName.Asia ? asiaEnd : sessionName == SessionName.London ? londonEnd : sessionName == SessionName.NewYork ? newYorkEnd : customEnd
    int startMinutes = MinutesFromHhmm(startValue)
    int endMinutes = MinutesFromHhmm(endValue)
    int rawDuration = endMinutes - startMinutes
    rawDuration > 0 ? rawDuration : rawDuration + 1440

// Selects one current session with stable priority: Asia, London, New York, Custom.
CurrentSession() =>
    bool asiaActive = asiaEnabled and IsInSession(BuildSession(asiaStart, asiaEnd), asiaTimezone)
    bool londonActive = londonEnabled and IsInSession(BuildSession(londonStart, londonEnd), londonTimezone)
    bool newYorkActive = newYorkEnabled and IsInSession(BuildSession(newYorkStart, newYorkEnd), newYorkTimezone)
    bool customActive = customEnabled and IsInSession(BuildSession(customStart, customEnd), customTimezone)
    asiaActive ? SessionName.Asia : londonActive ? SessionName.London : newYorkActive ? SessionName.NewYork : customActive ? SessionName.Custom : SessionName.None

// Returns a concise label for a trend direction.
TrendDirectionText(TrendDirection direction) =>
    direction == TrendDirection.Bullish ? "Bullish" : direction == TrendDirection.Bearish ? "Bearish" : "Neutral"

// Returns a concise label for the calculated trend strength.
TrendStrengthText(TrendStrength strength) =>
    strength == TrendStrength.Strong ? "Strong" : strength == TrendStrength.Moderate ? "Moderate" : "Weak"

// Returns a concise label for the latest confirmed market-structure event.
MarketStructureText(MarketStructure structure) =>
    structure == MarketStructure.HigherHigh ? "Higher High" : structure == MarketStructure.HigherLow ? "Higher Low" : structure == MarketStructure.LowerHigh ? "Lower High" : structure == MarketStructure.LowerLow ? "Lower Low" : "Neutral"

// Returns the current normalized direction computed by the Trend Engine.
GetTrendDirection() =>
    trendState.direction

// Returns the current normalized 0-100 trend score.
GetTrendScore() =>
    trendState.score

// Returns true only when the normalized Trend Engine direction is bullish.
IsBullTrend() =>
    GetTrendDirection() == TrendDirection.Bullish

// Returns true only when the normalized Trend Engine direction is bearish.
IsBearTrend() =>
    GetTrendDirection() == TrendDirection.Bearish

// Returns true when ADX is at or above the configured trending threshold.
IsTrending() =>
    trendState.isTrending

// Returns true when ADX is below the configured trending threshold.
IsRanging() =>
    not IsTrending()

// Returns the latest confirmed pivot-based market-structure classification.
GetMarketStructure() =>
    trendState.structure

//==============================================================================
// 6. TREND ENGINE
//==============================================================================
var float priorSwingHigh = na
var float priorSwingLow = na

// Calculates updated swing values without mutating persistent global state.
CalculateMarketStructure(float previousHigh, float previousLow, float currentHigh, float currentLow, MarketStructure currentStructure, float pivotHigh, float pivotLow) =>
    float nextPreviousHigh = previousHigh
    float nextPreviousLow = previousLow
    float nextCurrentHigh = currentHigh
    float nextCurrentLow = currentLow
    MarketStructure nextStructure = currentStructure
    if not na(pivotHigh)
        nextPreviousHigh := currentHigh
        nextCurrentHigh := pivotHigh
        if not na(nextPreviousHigh)
            nextStructure := pivotHigh > nextPreviousHigh ? MarketStructure.HigherHigh : MarketStructure.LowerHigh
    if not na(pivotLow)
        nextPreviousLow := currentLow
        nextCurrentLow := pivotLow
        if not na(nextPreviousLow)
            nextStructure := pivotLow > nextPreviousLow ? MarketStructure.HigherLow : MarketStructure.LowerLow
    bool breaksHigh = not na(nextPreviousHigh) and ta.crossover(close, nextPreviousHigh)
    bool breaksLow = not na(nextPreviousLow) and ta.crossunder(close, nextPreviousLow)
    [nextPreviousHigh, nextPreviousLow, nextCurrentHigh, nextCurrentLow, nextStructure, breaksHigh or breaksLow]

// Calculates one bounded, pivot-confirmed equal-level cluster without mutating global state.
// Pivot values are delayed by the M3 right-side confirmation length and do not repaint once received.
CalculateEqualLevelState(bool enabled, bool isHighLevel, float previousLevel, int previousTouches, int previousLastBar, float confirmedPivot, int pivotBarIndex, float tolerance, bool toleranceValid, int minimumTouches, int maximumAge, float currentHigh, float currentLow) =>
    float nextLevel = previousLevel
    int nextTouches = previousTouches
    int nextLastBar = previousLastBar
    bool hasLevel = not na(nextLevel)
    bool expired = hasLevel and not na(nextLastBar) and bar_index - nextLastBar > maximumAge
    bool invalidated = hasLevel and toleranceValid and (isHighLevel ? currentHigh > nextLevel + tolerance : currentLow < nextLevel - tolerance)
    if not enabled or expired or invalidated
        nextLevel := na
        nextTouches := 0
        nextLastBar := na
    if enabled and not na(confirmedPivot)
        if na(nextLevel)
            nextLevel := confirmedPivot
            nextTouches := 1
            nextLastBar := pivotBarIndex
        else if toleranceValid and math.abs(confirmedPivot - nextLevel) <= tolerance
            nextLevel := (nextLevel * nextTouches + confirmedPivot) / (nextTouches + 1)
            nextTouches += 1
            nextLastBar := pivotBarIndex
        else
            nextLevel := confirmedPivot
            nextTouches := 1
            nextLastBar := pivotBarIndex
    bool active = enabled and toleranceValid and not na(nextLevel) and nextTouches >= minimumTouches and not na(nextLastBar) and bar_index - nextLastBar <= maximumAge
    [nextLevel, nextTouches, nextLastBar, active]

// Converts one sweep penetration input to price units without introducing a new ATR calculation.
CalculateSweepPenetration(float level, float inputValue, RetestDistanceMode mode, float atrValue) =>
    na(level) ? na : mode == RetestDistanceMode.Ticks ? inputValue * syminfo.mintick : mode == RetestDistanceMode.Atr ? atrValue * inputValue : math.abs(level) * inputValue * 0.01

// Returns true when a completed candle sweeps sell-side liquidity and rejects upward.
IsBullishSweepAtLevel(float level, float minimumInput, float maximumInput, RetestDistanceMode mode, float atrValue, bool requireCloseBack, bool requireRejectionWick, float minimumWickPercent, float lowPrice, float closePrice, float wickPercent) =>
    float minimumPenetration = CalculateSweepPenetration(level, minimumInput, mode, atrValue)
    float maximumPenetration = CalculateSweepPenetration(level, maximumInput, mode, atrValue)
    float penetration = not na(level) ? level - lowPrice : na
    bool boundsValid = not na(minimumPenetration) and not na(maximumPenetration) and minimumPenetration <= maximumPenetration
    bool penetrationValid = not na(penetration) and penetration > 0.0 and penetration >= minimumPenetration and penetration <= maximumPenetration
    bool closeBackValid = not requireCloseBack or (not na(level) and closePrice > level)
    bool rejectionWickValid = not requireRejectionWick or wickPercent >= minimumWickPercent
    not na(level) and boundsValid and penetrationValid and closeBackValid and rejectionWickValid

// Returns true when a completed candle sweeps buy-side liquidity and rejects downward.
IsBearishSweepAtLevel(float level, float minimumInput, float maximumInput, RetestDistanceMode mode, float atrValue, bool requireCloseBack, bool requireRejectionWick, float minimumWickPercent, float highPrice, float closePrice, float wickPercent) =>
    float minimumPenetration = CalculateSweepPenetration(level, minimumInput, mode, atrValue)
    float maximumPenetration = CalculateSweepPenetration(level, maximumInput, mode, atrValue)
    float penetration = not na(level) ? highPrice - level : na
    bool boundsValid = not na(minimumPenetration) and not na(maximumPenetration) and minimumPenetration <= maximumPenetration
    bool penetrationValid = not na(penetration) and penetration > 0.0 and penetration >= minimumPenetration and penetration <= maximumPenetration
    bool closeBackValid = not requireCloseBack or (not na(level) and closePrice < level)
    bool rejectionWickValid = not requireRejectionWick or wickPercent >= minimumWickPercent
    not na(level) and boundsValid and penetrationValid and closeBackValid and rejectionWickValid

// Classifies accepted sweep context from bounded penetration, wick quality, close-back, and source significance.
CalculateSweepStrength(float penetration, float maximumPenetration, float wickPercent, bool closeBack, LiquiditySource source) =>
    float penetrationRatio = not na(penetration) and maximumPenetration > 0.0 ? math.min(math.max(penetration / maximumPenetration, 0.0), 1.0) : 0.0
    float sourceScore = source == LiquiditySource.EqualHigh or source == LiquiditySource.EqualLow ? 30.0 : source == LiquiditySource.PreviousDayHigh or source == LiquiditySource.PreviousDayLow ? 25.0 : source == LiquiditySource.PreviousWeekHigh or source == LiquiditySource.PreviousWeekLow ? 25.0 : source == LiquiditySource.SwingHigh or source == LiquiditySource.SwingLow ? 15.0 : source == LiquiditySource.OpeningRangeHigh or source == LiquiditySource.OpeningRangeLow ? 10.0 : 0.0
    float score = sourceScore + penetrationRatio * 25.0 + math.min(math.max(wickPercent, 0.0), 100.0) * 0.25 + (closeBack ? 20.0 : 0.0)
    score >= 85.0 ? SweepStrength.Extreme : score >= 65.0 ? SweepStrength.Strong : score >= 40.0 ? SweepStrength.Normal : SweepStrength.Weak

// Returns the non-negative distance from a price to an FVG zone, or na for invalid bounds.
DistanceToFvgZone(float price, float top, float bottom) =>
    na(price) or na(top) or na(bottom) or top < bottom ? na : price > top ? price - top : price < bottom ? bottom - price : 0.0

// Calculates the normalized trend values without mutating persistent global state.
CalculateTrendState(float fastEma, float slowEma, float htfFastEma, float htfSlowEma, float vwapValue, float priorVwapValue, float adxValue, float plusDiValue, float minusDiValue, MarketStructure structure) =>
    float vwapDistance = close - vwapValue
    float vwapSlope = vwapValue - priorVwapValue
    bool trending = adxValue >= adxTrendThreshold
    bool emaBullish = emaFilterEnabled and fastEma > slowEma
    bool emaBearish = emaFilterEnabled and fastEma < slowEma
    bool htfBullish = emaFilterEnabled and htfFastEma > htfSlowEma
    bool htfBearish = emaFilterEnabled and htfFastEma < htfSlowEma
    bool vwapBullish = vwapFilterEnabled and close > vwapValue
    bool vwapBearish = vwapFilterEnabled and close < vwapValue
    bool structureBullish = structure == MarketStructure.HigherHigh or structure == MarketStructure.HigherLow
    bool structureBearish = structure == MarketStructure.LowerHigh or structure == MarketStructure.LowerLow

    float bullScore = (emaBullish ? 30.0 : 0.0) + (htfBullish ? 25.0 : 0.0) + (vwapBullish ? 15.0 : 0.0) + (trending and plusDiValue > minusDiValue ? 20.0 : 0.0) + (structureBullish ? 10.0 : 0.0)
    float bearScore = (emaBearish ? 30.0 : 0.0) + (htfBearish ? 25.0 : 0.0) + (vwapBearish ? 15.0 : 0.0) + (trending and minusDiValue > plusDiValue ? 20.0 : 0.0) + (structureBearish ? 10.0 : 0.0)
    float score = math.max(bullScore, bearScore)
    TrendDirection direction = bullScore > bearScore ? TrendDirection.Bullish : bearScore > bullScore ? TrendDirection.Bearish : TrendDirection.Neutral
    TrendStrength strength = score >= 70.0 ? TrendStrength.Strong : score >= 45.0 ? TrendStrength.Moderate : TrendStrength.Weak
    [direction, strength, score, vwapDistance, vwapSlope, trending]

//============================================================================== 
// 6. SESSION ENGINE
//============================================================================== 
// Calculates session lifecycle fields without mutating persistent global state.
CalculateSessionState(SessionEngineState previousState) =>
    SessionName activeSession = CurrentSession()
    bool activeNow = activeSession != SessionName.None
    bool sessionChanged = activeNow and activeSession != previousState.currentSession
    bool justEnded = previousState.isActive and (not activeNow or sessionChanged)
    int startTime = sessionChanged ? time : previousState.startTime
    int durationMinutes = activeNow ? (sessionChanged ? SessionDurationMinutes(activeSession) : previousState.durationMinutes) : 0
    int barsInSession = sessionChanged ? 1 : activeNow ? previousState.barsInSession + 1 : 0
    float elapsedMilliseconds = activeNow ? time - startTime : 0.0
    float durationMilliseconds = durationMinutes * MILLISECONDS_PER_MINUTE
    float progressPercent = activeNow ? math.min(100.0, SafeDivide(elapsedMilliseconds * 100.0, durationMilliseconds, 0.0)) : 0.0
    float barMilliseconds = timeframe.in_seconds() * 1000.0
    int barsRemaining = activeNow ? math.max(0, int(math.ceil(SafeDivide(durationMilliseconds - elapsedMilliseconds, barMilliseconds, 0.0)))) : 0
    SessionEngineState.new(activeNow ? activeSession : SessionName.None, activeNow, sessionChanged, justEnded, startTime, durationMinutes, barsInSession, progressPercent, barsRemaining)

//============================================================================== 
// 7. OPENING RANGE ENGINE
//============================================================================== 
// Calculates the fresh session range and trade-control state.
CreateSessionRange() =>
    OpeningRangeState freshRange = OpeningRangeState.new(na, na, na, na, na, na, na, time, time + OpeningRangeMinutes() * MILLISECONDS_PER_MINUTE, 0, true, false, false)
    TradeControlState freshTradeControl = TradeControlState.new(false, false, false, false)
    int freshBreakoutDirection = 0
    float freshAtrAtCompletion = na
    [freshRange, freshTradeControl, freshBreakoutDirection, freshAtrAtCompletion, BreakoutState.None]

// Calculates the next opening-range state from one confirmed chart bar.
CalculateOpeningRange(OpeningRangeState previousRange, float atrValue) =>
    float nextHigh = previousRange.high
    float nextLow = previousRange.low
    int nextBars = previousRange.bars
    bool nextBuilding = previousRange.isBuilding
    bool nextComplete = previousRange.isComplete
    bool rangeBar = time < previousRange.endTime
    if previousRange.isBuilding and rangeBar
        nextHigh := na(nextHigh) ? high : math.max(nextHigh, high)
        nextLow := na(nextLow) ? low : math.min(nextLow, low)
        nextBars += 1
    float nextMid = not na(nextHigh) and not na(nextLow) ? (nextHigh + nextLow) * 0.5 : na
    float nextWidth = not na(nextHigh) and not na(nextLow) ? nextHigh - nextLow : na
    float nextAtrRatio = SafeDivide(nextWidth, atrValue, na)
    float nextPercent = SafeDivide(nextWidth * 100.0, nextMid, na)
    float nextTicks = SafeDivide(nextWidth, syminfo.mintick, na)
    float nextAtrAtCompletion = na
    BreakoutState rangeCompletionState = breakoutState
    bool nextQualityAccepted = previousRange.qualityAccepted
    if previousRange.isBuilding and not rangeBar
        nextBuilding := false
        nextComplete := true
        nextAtrAtCompletion := atrValue
        nextQualityAccepted := nextAtrRatio >= minimumAtrRatio and nextAtrRatio <= maximumAtrRatio
        rangeCompletionState := BreakoutState.None
    OpeningRangeState nextRange = OpeningRangeState.new(nextHigh, nextLow, nextMid, nextWidth, nextAtrRatio, nextPercent, nextTicks, previousRange.startTime, previousRange.endTime, nextBars, nextBuilding, nextComplete, nextQualityAccepted)
    [nextRange, nextAtrAtCompletion, rangeCompletionState]

// Calculates aggregate statistics after one completed opening range.
CalculateCompletedRangeStatistics(SessionStatistics previousStatistics, OpeningRangeState completedRange) =>
    SessionStatistics.new(previousStatistics.sessions + 1, previousStatistics.totalRange + completedRange.width, na(previousStatistics.largestRange) ? completedRange.width : math.max(previousStatistics.largestRange, completedRange.width), na(previousStatistics.smallestRange) ? completedRange.width : math.min(previousStatistics.smallestRange, completedRange.width), previousStatistics.totalAtrRatio + completedRange.atrRatio, previousStatistics.breakouts, previousStatistics.falseBreakouts, previousStatistics.successfulBreakouts)

//============================================================================== 
// 8. BREAKOUT STATE MACHINE
//============================================================================== 
// Calculates the next non-trading breakout state and associated statistics.
CalculateBreakoutState(OpeningRangeState currentRange, BreakoutState currentState, int currentDirection, SessionStatistics previousStatistics) =>
    BreakoutState nextState = currentState
    int nextDirection = currentDirection
    SessionStatistics nextStatistics = previousStatistics
    if currentRange.isComplete and sessionState.isActive and currentRange.qualityAccepted
        bool closesAbove = close > currentRange.high
        bool closesBelow = close < currentRange.low
        bool closesInside = close <= currentRange.high and close >= currentRange.low
        if currentState == BreakoutState.None and (closesAbove or closesBelow)
            nextDirection := closesAbove ? 1 : -1
            nextState := closesAbove ? BreakoutState.BullishCandidate : BreakoutState.BearishCandidate
        else if currentState == BreakoutState.BullishCandidate or currentState == BreakoutState.BearishCandidate
            bool confirms = nextDirection == 1 ? closesAbove : closesBelow
            if confirms
                nextState := nextDirection == 1 ? BreakoutState.BullishConfirmed : BreakoutState.BearishConfirmed
                nextStatistics := SessionStatistics.new(previousStatistics.sessions, previousStatistics.totalRange, previousStatistics.largestRange, previousStatistics.smallestRange, previousStatistics.totalAtrRatio, previousStatistics.breakouts + 1, previousStatistics.falseBreakouts, previousStatistics.successfulBreakouts + 1)
            else if closesInside
                nextState := BreakoutState.None
                nextDirection := 0
                nextStatistics := SessionStatistics.new(previousStatistics.sessions, previousStatistics.totalRange, previousStatistics.largestRange, previousStatistics.smallestRange, previousStatistics.totalAtrRatio, previousStatistics.breakouts, previousStatistics.falseBreakouts + 1, previousStatistics.successfulBreakouts)
        else if currentState == BreakoutState.BullishConfirmed or currentState == BreakoutState.BearishConfirmed
            bool fails = nextDirection == 1 ? close <= currentRange.high : close >= currentRange.low
            if fails
                nextState := nextDirection == 1 ? BreakoutState.BullishFailed : BreakoutState.BearishFailed
    [nextDirection, nextState, nextStatistics]

//============================================================================== 
// 9. DRAWING MANAGER
//============================================================================== 
var box rangeBox = na
var line rangeHighLine = na
var line rangeLowLine = na
var line rangeMidLine = na
var label rangeHighLabel = na
var label rangeLowLabel = na
var label rangeWidthLabel = na

// Creates drawing references for assignment from the main execution scope.
CreateRangeDrawings() =>
    box nextRangeBox = box.new(bar_index, close, bar_index, close, border_color = rangeColor, bgcolor = color.new(rangeColor, rangeTransparency))
    line nextRangeHighLine = line.new(bar_index, close, bar_index, close, color = rangeColor)
    line nextRangeLowLine = line.new(bar_index, close, bar_index, close, color = rangeColor)
    line nextRangeMidLine = line.new(bar_index, close, bar_index, close, color = color.new(rangeColor, 30), style = line.style_dashed)
    label nextRangeHighLabel = label.new(bar_index, close, "", style = label.style_label_left, color = color.new(rangeColor, 80), textcolor = color.white, size = size.tiny)
    label nextRangeLowLabel = label.new(bar_index, close, "", style = label.style_label_left, color = color.new(rangeColor, 80), textcolor = color.white, size = size.tiny)
    label nextRangeWidthLabel = label.new(bar_index, close, "", style = label.style_label_left, color = color.new(rangeColor, 80), textcolor = color.white, size = size.tiny)
    [nextRangeBox, nextRangeHighLine, nextRangeLowLine, nextRangeMidLine, nextRangeHighLabel, nextRangeLowLabel, nextRangeWidthLabel]

// Shows the latest opening range using reused box, line, and label objects.
UpdateRangeDrawings() =>
    bool hasRange = not na(rangeState.high) and not na(rangeState.low)
    int leftBar = math.max(0, bar_index - rangeState.bars + 1)
    if hasRange and showRangeBox
        box.set_lefttop(rangeBox, leftBar, rangeState.high)
        box.set_rightbottom(rangeBox, bar_index, rangeState.low)
        box.set_bgcolor(rangeBox, color.new(rangeColor, rangeTransparency))
        box.set_border_color(rangeBox, showRangeBorder ? rangeColor : color.new(rangeColor, 100))
    else
        box.set_bgcolor(rangeBox, color.new(rangeColor, 100))
        box.set_border_color(rangeBox, color.new(rangeColor, 100))
    if hasRange and showRangeLines
        line.set_xy1(rangeHighLine, leftBar, rangeState.high)
        line.set_xy2(rangeHighLine, bar_index, rangeState.high)
        line.set_xy1(rangeLowLine, leftBar, rangeState.low)
        line.set_xy2(rangeLowLine, bar_index, rangeState.low)
        line.set_xy1(rangeMidLine, leftBar, rangeState.mid)
        line.set_xy2(rangeMidLine, bar_index, rangeState.mid)
        line.set_color(rangeHighLine, rangeColor)
        line.set_color(rangeLowLine, rangeColor)
        line.set_color(rangeMidLine, color.new(rangeColor, 30))
    else
        line.set_color(rangeHighLine, color.new(rangeColor, 100))
        line.set_color(rangeLowLine, color.new(rangeColor, 100))
        line.set_color(rangeMidLine, color.new(rangeColor, 100))
    if hasRange and showRangeLabels
        label.set_xy(rangeHighLabel, bar_index, rangeState.high)
        label.set_text(rangeHighLabel, "OR High " + FormatPrice(rangeState.high))
        label.set_xy(rangeLowLabel, bar_index, rangeState.low)
        label.set_text(rangeLowLabel, "OR Low " + FormatPrice(rangeState.low))
        label.set_xy(rangeWidthLabel, bar_index, rangeState.mid)
        label.set_text(rangeWidthLabel, "Width " + FormatPrice(rangeState.width))
        label.set_color(rangeHighLabel, color.new(rangeColor, 80))
        label.set_color(rangeLowLabel, color.new(rangeColor, 80))
        label.set_color(rangeWidthLabel, color.new(rangeColor, 80))
    else
        label.set_color(rangeHighLabel, color.new(rangeColor, 100))
        label.set_color(rangeLowLabel, color.new(rangeColor, 100))
        label.set_color(rangeWidthLabel, color.new(rangeColor, 100))

//==============================================================================
// 10. TREND VISUALS
//==============================================================================
var label trendLabel = na

// Returns a display color for the current normalized trend direction.
TrendColor() =>
    IsBullTrend() ? color.lime : IsBearTrend() ? color.red : color.gray

// Calculates the reusable trend-label reference without mutating global state.
CalculateTrendLabel(label previousLabel) =>
    label nextLabel = previousLabel
    if showTrendLabel and barstate.islast
        string labelText = TrendDirectionText(GetTrendDirection()) + " " + str.tostring(GetTrendScore(), "#.##") + " / " + TrendStrengthText(trendState.strength)
        if na(nextLabel)
            nextLabel := label.new(bar_index, high, labelText, style = label.style_label_down, color = TrendColor(), textcolor = color.white, size = size.small)
        else
            label.set_xy(nextLabel, bar_index, high)
            label.set_text(nextLabel, labelText)
            label.set_color(nextLabel, TrendColor())
    else if not na(nextLabel)
        label.set_color(nextLabel, color.new(TrendColor(), 100))
    nextLabel

//============================================================================== 
// 11. DASHBOARD AND DEBUG
//============================================================================== 
var table dashboard = table.new(position.top_right, 2, 67, border_width = 1)
var table debugTable = table.new(position.bottom_right, 2, 6, border_width = 1)

// Writes one consistently styled dashboard row.
SetDashboardRow(table target, int row, string caption, string value) =>
    table.cell(target, 0, row, caption, text_color = color.silver, bgcolor = color.new(color.black, 15), text_size = size.small)
    table.cell(target, 1, row, value, text_color = color.white, bgcolor = color.new(color.black, 65), text_size = size.small)

// Updates the session dashboard only on the last chart bar.
UpdateDashboard() =>
    if barstate.islast
        if showDashboard
            SetDashboardRow(dashboard, 0, DASHBOARD_TITLE, "v" + STRATEGY_VERSION)
            SetDashboardRow(dashboard, 1, "Current session", SessionText(sessionState.currentSession))
            SetDashboardRow(dashboard, 2, "Current state", StateText(breakoutState))
            SetDashboardRow(dashboard, 3, "Range width", FormatPrice(rangeState.width))
            SetDashboardRow(dashboard, 4, "ATR ratio", str.tostring(rangeState.atrRatio, "#.##"))
            SetDashboardRow(dashboard, 5, "Session progress", FormatPercent(sessionState.progressPercent))
            SetDashboardRow(dashboard, 6, "Bars in session", str.tostring(sessionState.barsInSession))
            SetDashboardRow(dashboard, 7, "Bars remaining", str.tostring(sessionState.barsRemaining))
            SetDashboardRow(dashboard, 8, "Current trend", TrendDirectionText(GetTrendDirection()))
            SetDashboardRow(dashboard, 9, "Trend score", str.tostring(GetTrendScore(), "#.##"))
            SetDashboardRow(dashboard, 10, "EMA direction", trendState.fastEma > trendState.slowEma ? "Bullish" : trendState.fastEma < trendState.slowEma ? "Bearish" : "Neutral")
            SetDashboardRow(dashboard, 11, "HTF direction", trendState.htfFastEma > trendState.htfSlowEma ? "Bullish" : trendState.htfFastEma < trendState.htfSlowEma ? "Bearish" : "Neutral")
            SetDashboardRow(dashboard, 12, "VWAP status", close > trendState.vwapValue ? "Above" : close < trendState.vwapValue ? "Below" : "At VWAP")
            SetDashboardRow(dashboard, 13, "ADX", str.tostring(trendState.adx, "#.##"))
            SetDashboardRow(dashboard, 14, "Structure", MarketStructureText(GetMarketStructure()))
            SetDashboardRow(dashboard, 15, "Breakout state", StateText(breakoutState))
            SetDashboardRow(dashboard, 16, "Breakout direction", BreakoutDirectionText(breakoutTradeDirection))
            SetDashboardRow(dashboard, 17, "Breakout score", na(breakoutScore) ? "-" : str.tostring(breakoutScore, "#.##"))
            SetDashboardRow(dashboard, 18, "Breakout strength", BreakoutStrengthText(breakoutStrength))
            SetDashboardRow(dashboard, 19, "Distance ATR", na(breakoutDistanceATR) ? "-" : str.tostring(breakoutDistanceATR, "#.##"))
            SetDashboardRow(dashboard, 20, "Breakout attempted", breakoutAttempted ? "Yes" : "No")
            SetDashboardRow(dashboard, 21, "Breakout confirmed", breakoutConfirmed ? "Yes" : "No")
            SetDashboardRow(dashboard, 22, "Breakout failed", breakoutFailed ? "Yes" : "No")
            SetDashboardRow(dashboard, 23, "Retest state", RetestStateText(retestState))
            SetDashboardRow(dashboard, 24, "Retest direction", RetestDirectionText(retestTradeDirection))
            SetDashboardRow(dashboard, 25, "Retest level", na(retestLevel) ? "-" : FormatPrice(retestLevel))
            SetDashboardRow(dashboard, 26, "Retest score", FormatValueOrDash(retestScore))
            SetDashboardRow(dashboard, 27, "Retest attempts", str.tostring(retestAttemptCount))
            SetDashboardRow(dashboard, 28, "Retry pending", retestRetryPending ? "Yes" : "No")
            SetDashboardRow(dashboard, 29, "Bars since breakout", FormatIntOrDash(retestBarsSinceBreakout))
            SetDashboardRow(dashboard, 30, "Retest distance ATR", FormatValueOrDash(retestDistanceATR))
            SetDashboardRow(dashboard, 31, "Retest penetration ATR", FormatValueOrDash(retestPenetrationATR))
            SetDashboardRow(dashboard, 32, "Retest confirmed", retestConfirmed ? "Yes" : "No")
            SetDashboardRow(dashboard, 33, "Retest failed", retestFailed ? "Yes" : "No")
            SetDashboardRow(dashboard, 34, "Smart Money bias", smartMoneyBiasDashboardText)
            SetDashboardRow(dashboard, 35, "SMC strength", smartMoneyStrengthDashboardText)
            SetDashboardRow(dashboard, 36, "Bullish SMC score", showSmartMoneyScore ? FormatValueOrDash(bullishSmartMoneyScore) : "-")
            SetDashboardRow(dashboard, 37, "Bearish SMC score", showSmartMoneyScore ? FormatValueOrDash(bearishSmartMoneyScore) : "-")
            SetDashboardRow(dashboard, 38, "Liquidity sweep", bullishLiquiditySweep ? "Bullish" : bearishLiquiditySweep ? "Bearish" : "-")
            SetDashboardRow(dashboard, 39, "Sweep source", LiquiditySourceText(sweepSource))
            SetDashboardRow(dashboard, 40, "Sweep strength", SweepStrengthText(sweepStrength))
            SetDashboardRow(dashboard, 41, "Bullish FVG", latestBullishFvgActive ? "Active" : "-")
            SetDashboardRow(dashboard, 42, "Bearish FVG", latestBearishFvgActive ? "Active" : "-")
            SetDashboardRow(dashboard, 43, "Bullish OB", latestBullishObActive ? "Active" : "-")
            SetDashboardRow(dashboard, 44, "Bearish OB", latestBearishObActive ? "Active" : "-")
            SetDashboardRow(dashboard, 45, "Premium / Discount", PremiumDiscountText(premiumDiscountState))
            SetDashboardRow(dashboard, 46, "Equal high", equalHighActive ? "Active" : "-")
            SetDashboardRow(dashboard, 47, "Equal low", equalLowActive ? "Active" : "-")
            SetDashboardRow(dashboard, 48, "PDH / PDL", priceAbovePDH ? "Above PDH" : priceBelowPDL ? "Below PDL" : "Between")
            SetDashboardRow(dashboard, 49, "PWH / PWL", priceAbovePWH ? "Above PWH" : priceBelowPWL ? "Below PWL" : "Between")
            SetDashboardRow(dashboard, 50, "Trade setup state", tradeSetupStateDashboardText)
            SetDashboardRow(dashboard, 51, "Trade bias", tradeBiasDashboardText)
            SetDashboardRow(dashboard, 52, "Setup strength", tradeSetupStrengthDashboardText)
            SetDashboardRow(dashboard, 53, "Setup score", FormatValueOrDash(tradeSetupScore))
            SetDashboardRow(dashboard, 54, "Bullish raw score", showRawVsAdjustedScore ? FormatValueOrDash(bullishTradeScoreRawDisplay) : "-")
            SetDashboardRow(dashboard, 55, "Bearish raw score", showRawVsAdjustedScore ? FormatValueOrDash(bearishTradeScoreRawDisplay) : "-")
            SetDashboardRow(dashboard, 56, "Bullish adjusted score", showRawVsAdjustedScore ? FormatValueOrDash(bullishTradeScore) : "-")
            SetDashboardRow(dashboard, 57, "Bearish adjusted score", showRawVsAdjustedScore ? FormatValueOrDash(bearishTradeScore) : "-")
            SetDashboardRow(dashboard, 58, "Bullish penalty", showRawVsAdjustedScore ? FormatValueOrDash(bullishTradePenaltyDisplay) : "-")
            SetDashboardRow(dashboard, 59, "Bearish penalty", showRawVsAdjustedScore ? FormatValueOrDash(bearishTradePenaltyDisplay) : "-")
            SetDashboardRow(dashboard, 60, "Bullish mandatory gates", bullishMandatoryGateDisplay ? "Pass" : "Fail")
            SetDashboardRow(dashboard, 61, "Bearish mandatory gates", bearishMandatoryGateDisplay ? "Pass" : "Fail")
            SetDashboardRow(dashboard, 62, "Bullish candidate", bullishTradeCandidateDisplay ? "Yes" : "No")
            SetDashboardRow(dashboard, 63, "Bearish candidate", bearishTradeCandidateDisplay ? "Yes" : "No")
            SetDashboardRow(dashboard, 64, "Bullish qualified", bullishTradeQualified ? "Yes" : "No")
            SetDashboardRow(dashboard, 65, "Bearish qualified", bearishTradeQualified ? "Yes" : "No")
            SetDashboardRow(dashboard, 66, "Directional score difference", FormatValueOrDash(tradeScoreDifferenceDisplay))
        else
            table.clear(dashboard, 0, 0, 1, 66)

// Updates the diagnostic panel only on the last chart bar when debugging is enabled.
UpdateDebugPanel() =>
    if barstate.islast
        if debugEnabled
            SetDashboardRow(debugTable, 0, "DEBUG", "v" + STRATEGY_VERSION)
            SetDashboardRow(debugTable, 1, "Session", SessionText(sessionState.currentSession))
            SetDashboardRow(debugTable, 2, "State", StateText(breakoutState))
            SetDashboardRow(debugTable, 3, "Range high", FormatPrice(rangeState.high))
            SetDashboardRow(debugTable, 4, "Range low", FormatPrice(rangeState.low))
            SetDashboardRow(debugTable, 5, "ATR / bars", str.tostring(rangeState.atrRatio, "#.##") + " / " + str.tostring(sessionState.barsInSession))
        else
            table.clear(debugTable, 0, 0, 1, 5)

//============================================================================== 
// 12. ORCHESTRATION
//============================================================================== 
float atrValue = ta.atr(ATR_LENGTH)
float breakoutBuffer = na(rangeState.high) or na(rangeState.low) ? na : breakoutBufferMode == BreakoutBufferMode.Ticks ? breakoutBufferValue * syminfo.mintick : breakoutBufferMode == BreakoutBufferMode.Percentage ? rangeState.mid * breakoutBufferValue * 0.01 : atrValue * breakoutBufferValue
float bullishBreakoutThreshold = na(rangeState.high) or na(breakoutBuffer) ? na : rangeState.high + breakoutBuffer
float bearishBreakoutThreshold = na(rangeState.low) or na(breakoutBuffer) ? na : rangeState.low - breakoutBuffer
float candleRange = high - low
float safeCandleRange = math.max(candleRange, syminfo.mintick)
float candleBody = math.abs(close - open)
float bodyPercent = candleBody * 100.0 / safeCandleRange
float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low
float upperWickPercent = upperWick * 100.0 / safeCandleRange
float lowerWickPercent = lowerWick * 100.0 / safeCandleRange
float bullishClosePosition = (close - low) * 100.0 / safeCandleRange
float bearishClosePosition = (high - close) * 100.0 / safeCandleRange
bool bullishBreakoutSignal = false
bool bearishBreakoutSignal = false
bool bullishBreakoutFailure = false
bool bearishBreakoutFailure = false
bool bullishCandleQuality = close > open and bodyPercent >= minimumBodyPercent and upperWickPercent <= maximumRejectionWickPercent and bullishClosePosition >= minimumClosePositionPercent
bool bearishCandleQuality = close < open and bodyPercent >= minimumBodyPercent and lowerWickPercent <= maximumRejectionWickPercent and bearishClosePosition >= minimumClosePositionPercent
float breakoutCandleATR = SafeDivide(candleRange, atrValue, na)
float breakoutDistanceATRCurrent = na(bullishBreakoutThreshold) ? na : SafeDivide(math.max(math.max(0.0, close - bullishBreakoutThreshold), math.max(0.0, bearishBreakoutThreshold - close)), atrValue, na)
float atrExpansionBaseline = ta.sma(atrValue, ATR_LENGTH)
float atrExpansionRatio = SafeDivide(atrValue, atrExpansionBaseline, na)
bool bullishMomentumValid = breakoutCandleATR >= minimumBreakoutRangeAtr and (not useAtrExpansionFilter or atrExpansionRatio >= minimumAtrExpansion)
bool bearishMomentumValid = bullishMomentumValid
bool bullishTrendAligned = GetTrendDirection() == TrendDirection.Bullish
bool bearishTrendAligned = GetTrendDirection() == TrendDirection.Bearish
bool bullishHTFAligned = trendState.htfFastEma > trendState.htfSlowEma
bool bearishHTFAligned = trendState.htfFastEma < trendState.htfSlowEma
bool bullishVWAPAligned = close > trendState.vwapValue
bool bearishVWAPAligned = close < trendState.vwapValue
bool bullishADXAligned = trendState.isTrending and trendState.plusDi > trendState.minusDi
bool bearishADXAligned = trendState.isTrending and trendState.minusDi > trendState.plusDi
bool bullishTrendRequirementsPass = (not requireTrendAlignment or bullishTrendAligned) and (not requireHtfAlignment or bullishHTFAligned) and (not requireVwapAlignment or bullishVWAPAligned) and (not requireAdxConfirmation or bullishADXAligned)
bool bearishTrendRequirementsPass = (not requireTrendAlignment or bearishTrendAligned) and (not requireHtfAlignment or bearishHTFAligned) and (not requireVwapAlignment or bearishVWAPAligned) and (not requireAdxConfirmation or bearishADXAligned)
bool breakoutRangeQualityValid = rangeState.isComplete and rangeState.qualityAccepted
bool bullishCloseOutsideRange = barstate.isconfirmed and close > rangeState.high
bool bearishCloseOutsideRange = barstate.isconfirmed and close < rangeState.low
bool bullishCloseOutsideBuffer = barstate.isconfirmed and close > bullishBreakoutThreshold
bool bearishCloseOutsideBuffer = barstate.isconfirmed and close < bearishBreakoutThreshold
bool bullishBreakoutCandidate = breakoutEnabled and breakoutRangeQualityValid and (breakoutMode == BreakoutConfirmationMode.CloseOnly ? bullishCloseOutsideRange : breakoutMode == BreakoutConfirmationMode.ClosePlusBuffer ? bullishCloseOutsideBuffer : breakoutMode == BreakoutConfirmationMode.CandleQuality ? bullishCloseOutsideBuffer and bullishCandleQuality : breakoutMode == BreakoutConfirmationMode.CandlePlusMomentum ? bullishCloseOutsideBuffer and bullishCandleQuality and bullishMomentumValid : bullishCloseOutsideBuffer and bullishCandleQuality and bullishMomentumValid and bullishTrendRequirementsPass)
bool bearishBreakoutCandidate = breakoutEnabled and breakoutRangeQualityValid and (breakoutMode == BreakoutConfirmationMode.CloseOnly ? bearishCloseOutsideRange : breakoutMode == BreakoutConfirmationMode.ClosePlusBuffer ? bearishCloseOutsideBuffer : breakoutMode == BreakoutConfirmationMode.CandleQuality ? bearishCloseOutsideBuffer and bearishCandleQuality : breakoutMode == BreakoutConfirmationMode.CandlePlusMomentum ? bearishCloseOutsideBuffer and bearishCandleQuality and bearishMomentumValid : bearishCloseOutsideBuffer and bearishCandleQuality and bearishMomentumValid and bearishTrendRequirementsPass)
float bullishBreakoutScore = math.max(0.0, math.min(100.0, (bullishCandleQuality ? 25.0 : 0.0) + (bullishMomentumValid ? 20.0 : 0.0) + (bullishTrendAligned ? 20.0 : 0.0) + (bullishHTFAligned ? 15.0 : 0.0) + ((bullishVWAPAligned and bullishADXAligned) ? 10.0 : 0.0) + (breakoutRangeQualityValid ? 10.0 : 0.0)))
float bearishBreakoutScore = math.max(0.0, math.min(100.0, (bearishCandleQuality ? 25.0 : 0.0) + (bearishMomentumValid ? 20.0 : 0.0) + (bearishTrendAligned ? 20.0 : 0.0) + (bearishHTFAligned ? 15.0 : 0.0) + ((bearishVWAPAligned and bearishADXAligned) ? 10.0 : 0.0) + (breakoutRangeQualityValid ? 10.0 : 0.0)))
BreakoutStrength bullishBreakoutStrength = bullishBreakoutScore >= 85.0 ? BreakoutStrength.Extreme : bullishBreakoutScore >= 65.0 ? BreakoutStrength.Strong : bullishBreakoutScore >= 40.0 ? BreakoutStrength.Normal : BreakoutStrength.Weak
BreakoutStrength bearishBreakoutStrength = bearishBreakoutScore >= 85.0 ? BreakoutStrength.Extreme : bearishBreakoutScore >= 65.0 ? BreakoutStrength.Strong : bearishBreakoutScore >= 40.0 ? BreakoutStrength.Normal : BreakoutStrength.Weak
bool bullishBreakoutQualityPass = bullishBreakoutScore >= minimumBreakoutScore
bool bearishBreakoutQualityPass = bearishBreakoutScore >= minimumBreakoutScore
int breakoutWindowMinutes = breakoutValidityWindow == "Entire session" ? 0 : int(str.tonumber(breakoutValidityWindow))
bool breakoutWindowValid = rangeState.isComplete and sessionState.isActive and (breakoutWindowMinutes == 0 or time <= rangeState.endTime + breakoutWindowMinutes * MILLISECONDS_PER_MINUTE)
bool breakoutAttemptGate = allowMultipleBreakoutAttempts or not breakoutAttempted
bool bullishBreakoutAccepted = barstate.isconfirmed and breakoutWindowValid and breakoutAttemptGate and bullishBreakoutCandidate and bullishBreakoutQualityPass and not bearishBreakoutCandidate
bool bearishBreakoutAccepted = barstate.isconfirmed and breakoutWindowValid and breakoutAttemptGate and bearishBreakoutCandidate and bearishBreakoutQualityPass and not bullishBreakoutCandidate
bool bullishRetestDetected = false
bool bearishRetestDetected = false
bool bullishRetestConfirmed = false
bool bearishRetestConfirmed = false
bool bullishRetestFailure = false
bool bearishRetestFailure = false
bool retestPendingState = retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected
bool retestWindowState = retestPendingState or (retestState == RetestState.RetestFailed and retestRetryPending)
bool retestWindowValid = retestWindowState and not na(retestStartBarIndex) and (retestWindowMode == RetestWindowMode.Bars ? bar_index - retestStartBarIndex <= retestWindowValue : time - retestStartTime <= retestWindowValue * MILLISECONDS_PER_MINUTE)
bool retestRetryEligible = allowMultipleRetestAttempts and retestState == RetestState.RetestFailed and not retestConfirmed and retestRetryPending and retestWindowValid and ((retestTradeDirection == TradeDirection.Long and breakoutState != BreakoutState.BullishFailed) or (retestTradeDirection == TradeDirection.Short and breakoutState != BreakoutState.BearishFailed))
float retestTolerance = na(retestLevel) ? na : retestToleranceMode == RetestDistanceMode.Ticks ? retestToleranceValue * syminfo.mintick : retestToleranceMode == RetestDistanceMode.Atr ? atrValue * retestToleranceValue : retestLevel * retestToleranceValue * 0.01
float maximumRetestPenetration = na(retestLevel) ? na : maximumPenetrationMode == RetestDistanceMode.Ticks ? maximumPenetrationValue * syminfo.mintick : maximumPenetrationMode == RetestDistanceMode.Atr ? atrValue * maximumPenetrationValue : retestLevel * maximumPenetrationValue * 0.01
bool retestActive = retestEnabled and retestWindowValid and not na(retestLevel) and retestTradeDirection != TradeDirection.None and not retestConfirmed and not retestFailed
bool bullishRetestInteraction = retestActive and retestTradeDirection == TradeDirection.Long and bar_index > retestStartBarIndex and low <= retestLevel + retestTolerance and low >= retestLevel - maximumRetestPenetration
bool bearishRetestInteraction = retestActive and retestTradeDirection == TradeDirection.Short and bar_index > retestStartBarIndex and high >= retestLevel - retestTolerance and high <= retestLevel + maximumRetestPenetration
bool bullishRetestContext = retestEnabled and retestTradeDirection == TradeDirection.Long and retestPendingState and not na(retestLevel) and not na(retestStartBarIndex) and bar_index > retestStartBarIndex
bool bearishRetestContext = retestEnabled and retestTradeDirection == TradeDirection.Short and retestPendingState and not na(retestLevel) and not na(retestStartBarIndex) and bar_index > retestStartBarIndex
bool bullishRetestCandleQuality = barstate.isconfirmed and bodyPercent >= minimumRetestBodyPercent and lowerWickPercent >= minimumRetestRejectionWickPercent and bullishClosePosition >= minimumRetestClosePositionPercent
bool bearishRetestCandleQuality = barstate.isconfirmed and bodyPercent >= minimumRetestBodyPercent and upperWickPercent >= minimumRetestRejectionWickPercent and bearishClosePosition >= minimumRetestClosePositionPercent
bool bullishTouchAndClose = bullishRetestContext and bullishRetestInteraction and barstate.isconfirmed and close >= retestLevel
bool bearishTouchAndClose = bearishRetestContext and bearishRetestInteraction and barstate.isconfirmed and close <= retestLevel
bool bullishRetestPinBar = bullishRetestContext and bullishRetestInteraction and bullishRetestCandleQuality and close >= retestLevel and upperWick <= lowerWick
bool bearishRetestPinBar = bearishRetestContext and bearishRetestInteraction and bearishRetestCandleQuality and close <= retestLevel and lowerWick <= upperWick
bool bullishRetestEngulfing = bullishRetestContext and barstate.isconfirmed and close > open and close[1] < open[1] and open <= close[1] and close >= open[1]
bool bearishRetestEngulfing = bearishRetestContext and barstate.isconfirmed and close < open and close[1] > open[1] and open >= close[1] and close <= open[1]
bool bullishStrongRetestRejection = bullishRetestContext and bullishRetestInteraction and bullishRetestCandleQuality and close >= retestLevel
bool bearishStrongRetestRejection = bearishRetestContext and bearishRetestInteraction and bearishRetestCandleQuality and close <= retestLevel
bool bullishAnyRetestPattern = (enableRetestPinBar and bullishRetestPinBar) or (enableRetestEngulfing and bullishRetestEngulfing) or (enableStrongRetestRejection and bullishStrongRetestRejection)
bool bearishAnyRetestPattern = (enableRetestPinBar and bearishRetestPinBar) or (enableRetestEngulfing and bearishRetestEngulfing) or (enableStrongRetestRejection and bearishStrongRetestRejection)
bool longRetestScoringActive = retestActive and retestTradeDirection == TradeDirection.Long
bool shortRetestScoringActive = retestActive and retestTradeDirection == TradeDirection.Short
float levelDistanceRatio = retestTolerance > 0 and not na(retestDistance) ? math.min(math.max(retestDistance / retestTolerance, 0.0), 1.0) : 1.0
float bullishLevelScore = longRetestScoringActive and bullishRetestInteraction ? 25.0 * (1.0 - levelDistanceRatio) : 0.0
float bearishLevelScore = shortRetestScoringActive and bearishRetestInteraction ? 25.0 * (1.0 - levelDistanceRatio) : 0.0
float bullishRejectionScore = longRetestScoringActive ? math.min(25.0, (bullishStrongRetestRejection ? 10.0 : 0.0) + math.min(lowerWickPercent, 100.0) * 0.08 + math.min(bullishClosePosition, 100.0) * 0.07) : 0.0
float bearishRejectionScore = shortRetestScoringActive ? math.min(25.0, (bearishStrongRetestRejection ? 10.0 : 0.0) + math.min(upperWickPercent, 100.0) * 0.08 + math.min(bearishClosePosition, 100.0) * 0.07) : 0.0
float bullishStructureScore = longRetestScoringActive ? math.min(20.0, (bullishRetestCandleQuality ? 10.0 : 0.0) + (bullishAnyRetestPattern ? 7.0 : 0.0) + ((bullishRetestPinBar and bullishRetestEngulfing) ? 3.0 : 0.0)) : 0.0
float bearishStructureScore = shortRetestScoringActive ? math.min(20.0, (bearishRetestCandleQuality ? 10.0 : 0.0) + (bearishAnyRetestPattern ? 7.0 : 0.0) + ((bearishRetestPinBar and bearishRetestEngulfing) ? 3.0 : 0.0)) : 0.0
float penetrationRatio = maximumRetestPenetration > 0 and not na(retestPenetration) ? math.min(math.max(retestPenetration / maximumRetestPenetration, 0.0), 1.0) : 0.0
float penetrationQualityScore = retestActive and not na(retestPenetration) ? 15.0 * (1.0 - penetrationRatio) : 0.0
float timingFraction = retestActive ? (retestWindowMode == RetestWindowMode.Bars ? math.min(math.max(SafeDivide(retestBarsSinceBreakout, retestWindowValue, 1.0), 0.0), 1.0) : math.min(math.max(SafeDivide(time - retestStartTime, retestWindowValue * MILLISECONDS_PER_MINUTE, 1.0), 0.0), 1.0)) : 1.0
float timingQualityScore = retestActive ? 15.0 * (1.0 - timingFraction) : 0.0
float bullishRetestScore = longRetestScoringActive ? math.max(0.0, math.min(100.0, bullishLevelScore + bullishRejectionScore + bullishStructureScore + penetrationQualityScore + timingQualityScore)) : 0.0
float bearishRetestScore = shortRetestScoringActive ? math.max(0.0, math.min(100.0, bearishLevelScore + bearishRejectionScore + bearishStructureScore + penetrationQualityScore + timingQualityScore)) : 0.0
bool bullishRetestQualityPass = longRetestScoringActive and bullishRetestScore >= retestScoreThreshold
bool bearishRetestQualityPass = shortRetestScoringActive and bearishRetestScore >= retestScoreThreshold
bool retestPatternEnabled = enableRetestPinBar or enableRetestEngulfing or enableStrongRetestRejection
bool bullishModePass = retestConfirmationMode == RetestConfirmationMode.TouchAndClose ? bullishTouchAndClose : retestConfirmationMode == RetestConfirmationMode.Rejection ? bullishStrongRetestRejection : retestConfirmationMode == RetestConfirmationMode.PinBar ? enableRetestPinBar and bullishRetestPinBar : retestConfirmationMode == RetestConfirmationMode.Engulfing ? enableRetestEngulfing and bullishRetestEngulfing : retestConfirmationMode == RetestConfirmationMode.AnyPattern ? bullishAnyRetestPattern : bullishTouchAndClose and bullishRetestCandleQuality and bullishStrongRetestRejection and (not retestPatternEnabled or bullishAnyRetestPattern)
bool bearishModePass = retestConfirmationMode == RetestConfirmationMode.TouchAndClose ? bearishTouchAndClose : retestConfirmationMode == RetestConfirmationMode.Rejection ? bearishStrongRetestRejection : retestConfirmationMode == RetestConfirmationMode.PinBar ? enableRetestPinBar and bearishRetestPinBar : retestConfirmationMode == RetestConfirmationMode.Engulfing ? enableRetestEngulfing and bearishRetestEngulfing : retestConfirmationMode == RetestConfirmationMode.AnyPattern ? bearishAnyRetestPattern : bearishTouchAndClose and bearishRetestCandleQuality and bearishStrongRetestRejection and (not retestPatternEnabled or bearishAnyRetestPattern)
bool bullishRetestCloseFailure = retestTradeDirection == TradeDirection.Long and retestState == RetestState.RetestDetected and retestAttempted and not retestConfirmed and not na(retestLevel) and not na(maximumRetestPenetration) and barstate.isconfirmed and close < retestLevel - maximumRetestPenetration
bool bearishRetestCloseFailure = retestTradeDirection == TradeDirection.Short and retestState == RetestState.RetestDetected and retestAttempted and not retestConfirmed and not na(retestLevel) and not na(maximumRetestPenetration) and barstate.isconfirmed and close > retestLevel + maximumRetestPenetration
bool bullishRetestFailureThresholdReached = retestState == RetestState.RetestDetected and retestTradeDirection == TradeDirection.Long and bullishRetestCloseFailure and bullishRetestFailureCount + 1 >= retestFailureConfirmationBars
bool bearishRetestFailureThresholdReached = retestState == RetestState.RetestDetected and retestTradeDirection == TradeDirection.Short and bearishRetestCloseFailure and bearishRetestFailureCount + 1 >= retestFailureConfirmationBars
bool bullishRetestConfirmationCandidate = barstate.isconfirmed and bullishRetestContext and retestWindowValid and not retestFailed and not retestConfirmed and not bullishRetestFailureThresholdReached and bullishModePass and bullishRetestQualityPass and (not requireRetestRejection or bullishStrongRetestRejection)
bool bearishRetestConfirmationCandidate = barstate.isconfirmed and bearishRetestContext and retestWindowValid and not retestFailed and not retestConfirmed and not bearishRetestFailureThresholdReached and bearishModePass and bearishRetestQualityPass and (not requireRetestRejection or bearishStrongRetestRejection)
float fastEmaValue = ta.ema(close, fastEmaLength)
float slowEmaValue = ta.ema(close, slowEmaLength)
[htfFastEmaValue, htfSlowEmaValue] = request.security(syminfo.tickerid, htfTimeframe, [ta.ema(close, fastEmaLength), ta.ema(close, slowEmaLength)], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
float vwapValue = ta.vwap(hlc3)
[plusDiValue, minusDiValue, adxValue] = ta.dmi(adxLength, adxLength)
float confirmedPivotHigh = ta.pivothigh(high, pivotLength, pivotLength)
float confirmedPivotLow = ta.pivotlow(low, pivotLength, pivotLength)
[previousDayHigh, previousDayLow, previousDayClose] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[previousWeekHigh, previousWeekLow, previousWeekClose] = request.security(syminfo.tickerid, "W", [high[1], low[1], close[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
float previousDayMid = not na(previousDayHigh) and not na(previousDayLow) ? (previousDayHigh + previousDayLow) * 0.5 : na
float previousWeekMid = not na(previousWeekHigh) and not na(previousWeekLow) ? (previousWeekHigh + previousWeekLow) * 0.5 : na
priceAbovePDH := not na(previousDayHigh) and close > previousDayHigh
priceBelowPDL := not na(previousDayLow) and close < previousDayLow
priceAbovePWH := not na(previousWeekHigh) and close > previousWeekHigh
priceBelowPWL := not na(previousWeekLow) and close < previousWeekLow
float distanceToPDH = not na(previousDayHigh) ? math.abs(close - previousDayHigh) : na
float distanceToPDL = not na(previousDayLow) ? math.abs(close - previousDayLow) : na
float distanceToPWH = not na(previousWeekHigh) ? math.abs(close - previousWeekHigh) : na
float distanceToPWL = not na(previousWeekLow) ? math.abs(close - previousWeekLow) : na
float equalLevelTolerance = equalLevelToleranceMode == EqualLevelToleranceMode.Ticks ? equalLevelToleranceValue * syminfo.mintick : equalLevelToleranceMode == EqualLevelToleranceMode.Atr ? atrValue * equalLevelToleranceValue : close * equalLevelToleranceValue * 0.01
bool equalLevelToleranceValid = not na(equalLevelTolerance)
bool bullishEqualLowSweepRaw = liquiditySweepsEnabled and equalLowActive and IsBullishSweepAtLevel(equalLowLevel, minimumSweepPenetrationValue, maximumSweepPenetrationValue, sweepPenetrationMode, atrValue, requireSweepCloseBack, requireSweepRejectionWick, minimumSweepRejectionWickPercent, low, close, lowerWickPercent)
bool bullishPreviousDayLowSweepRaw = liquiditySweepsEnabled and IsBullishSweepAtLevel(previousDayLow, minimumSweepPenetrationValue, maximumSweepPenetrationValue, sweepPenetrationMode, atrValue, requireSweepCloseBack, requireSweepRejectionWick, minimumSweepRejectionWickPercent, low, close, lowerWickPercent)
bool bullishPreviousWeekLowSweepRaw = liquiditySweepsEnabled and IsBullishSweepAtLevel(previousWeekLow, minimumSweepPenetrationValue, maximumSweepPenetrationValue, sweepPenetrationMode, atrValue, requireSweepCloseBack, requireSweepRejectionWick, minimumSweepRejectionWickPercent, low, close, lowerWickPercent)
bool bullishSwingLowSweepRaw = liquiditySweepsEnabled and IsBullishSweepAtLevel(trendState.swingLow, minimumSweepPenetrationValue, maximumSweepPenetrationValue, sweepPenetrationMode, atrValue, requireSweepCloseBack, requireSweepRejectionWick, minimumSweepRejectionWickPercent, low, close, lowerWickPercent)
bool bullishOpeningRangeLowSweepRaw = liquiditySweepsEnabled and rangeState.isComplete and rangeState.qualityAccepted and IsBullishSweepAtLevel(rangeState.low, minimumSweepPenetrationValue, maximumSweepPenetrationValue, sweepPenetrationMode, atrValue, requireSweepCloseBack, requireSweepRejectionWick, minimumSweepRejectionWickPercent, low, close, lowerWickPercent)
bool bearishEqualHighSweepRaw = liquiditySweepsEnabled and equalHighActive and IsBearishSweepAtLevel(equalHighLevel, minimumSweepPenetrationValue, maximumSweepPenetrationValue, sweepPenetrationMode, atrValue, requireSweepCloseBack, requireSweepRejectionWick, minimumSweepRejectionWickPercent, high, close, upperWickPercent)
bool bearishPreviousDayHighSweepRaw = liquiditySweepsEnabled and IsBearishSweepAtLevel(previousDayHigh, minimumSweepPenetrationValue, maximumSweepPenetrationValue, sweepPenetrationMode, atrValue, requireSweepCloseBack, requireSweepRejectionWick, minimumSweepRejectionWickPercent, high, close, upperWickPercent)
bool bearishPreviousWeekHighSweepRaw = liquiditySweepsEnabled and IsBearishSweepAtLevel(previousWeekHigh, minimumSweepPenetrationValue, maximumSweepPenetrationValue, sweepPenetrationMode, atrValue, requireSweepCloseBack, requireSweepRejectionWick, minimumSweepRejectionWickPercent, high, close, upperWickPercent)
bool bearishSwingHighSweepRaw = liquiditySweepsEnabled and IsBearishSweepAtLevel(trendState.swingHigh, minimumSweepPenetrationValue, maximumSweepPenetrationValue, sweepPenetrationMode, atrValue, requireSweepCloseBack, requireSweepRejectionWick, minimumSweepRejectionWickPercent, high, close, upperWickPercent)
bool bearishOpeningRangeHighSweepRaw = liquiditySweepsEnabled and rangeState.isComplete and rangeState.qualityAccepted and IsBearishSweepAtLevel(rangeState.high, minimumSweepPenetrationValue, maximumSweepPenetrationValue, sweepPenetrationMode, atrValue, requireSweepCloseBack, requireSweepRejectionWick, minimumSweepRejectionWickPercent, high, close, upperWickPercent)
bool bullishRawLiquiditySweep = barstate.isconfirmed and (bullishEqualLowSweepRaw or bullishPreviousDayLowSweepRaw or bullishPreviousWeekLowSweepRaw or bullishSwingLowSweepRaw or bullishOpeningRangeLowSweepRaw)
bool bearishRawLiquiditySweep = barstate.isconfirmed and (bearishEqualHighSweepRaw or bearishPreviousDayHighSweepRaw or bearishPreviousWeekHighSweepRaw or bearishSwingHighSweepRaw or bearishOpeningRangeHighSweepRaw)
LiquiditySource bullishSweepSourceCandidate = bullishEqualLowSweepRaw ? LiquiditySource.EqualLow : bullishPreviousDayLowSweepRaw ? LiquiditySource.PreviousDayLow : bullishPreviousWeekLowSweepRaw ? LiquiditySource.PreviousWeekLow : bullishSwingLowSweepRaw ? LiquiditySource.SwingLow : bullishOpeningRangeLowSweepRaw ? LiquiditySource.OpeningRangeLow : LiquiditySource.None
LiquiditySource bearishSweepSourceCandidate = bearishEqualHighSweepRaw ? LiquiditySource.EqualHigh : bearishPreviousDayHighSweepRaw ? LiquiditySource.PreviousDayHigh : bearishPreviousWeekHighSweepRaw ? LiquiditySource.PreviousWeekHigh : bearishSwingHighSweepRaw ? LiquiditySource.SwingHigh : bearishOpeningRangeHighSweepRaw ? LiquiditySource.OpeningRangeHigh : LiquiditySource.None
float bullishSweepLevelCandidate = bullishEqualLowSweepRaw ? equalLowLevel : bullishPreviousDayLowSweepRaw ? previousDayLow : bullishPreviousWeekLowSweepRaw ? previousWeekLow : bullishSwingLowSweepRaw ? trendState.swingLow : bullishOpeningRangeLowSweepRaw ? rangeState.low : na
float bearishSweepLevelCandidate = bearishEqualHighSweepRaw ? equalHighLevel : bearishPreviousDayHighSweepRaw ? previousDayHigh : bearishPreviousWeekHighSweepRaw ? previousWeekHigh : bearishSwingHighSweepRaw ? trendState.swingHigh : bearishOpeningRangeHighSweepRaw ? rangeState.high : na
float bullishSweepPenetrationCandidate = not na(bullishSweepLevelCandidate) ? bullishSweepLevelCandidate - low : na
float bearishSweepPenetrationCandidate = not na(bearishSweepLevelCandidate) ? high - bearishSweepLevelCandidate : na
float bullishSweepMaximumPenetration = CalculateSweepPenetration(bullishSweepLevelCandidate, maximumSweepPenetrationValue, sweepPenetrationMode, atrValue)
float bearishSweepMaximumPenetration = CalculateSweepPenetration(bearishSweepLevelCandidate, maximumSweepPenetrationValue, sweepPenetrationMode, atrValue)
bool bullishFvgCreated = false
bool bearishFvgCreated = false
bool fvgHistoryAvailable = bar_index >= 2
float bullishFvgBottomCandidate = fvgHistoryAvailable ? high[2] : na
float bullishFvgTopCandidate = fvgHistoryAvailable ? low : na
float bearishFvgBottomCandidate = fvgHistoryAvailable ? high : na
float bearishFvgTopCandidate = fvgHistoryAvailable ? low[2] : na
float bullishFvgMidCandidate = not na(bullishFvgTopCandidate) and not na(bullishFvgBottomCandidate) ? (bullishFvgTopCandidate + bullishFvgBottomCandidate) * 0.5 : na
float bearishFvgMidCandidate = not na(bearishFvgTopCandidate) and not na(bearishFvgBottomCandidate) ? (bearishFvgTopCandidate + bearishFvgBottomCandidate) * 0.5 : na
float bullishFvgSizeCandidate = not na(bullishFvgTopCandidate) and not na(bullishFvgBottomCandidate) ? bullishFvgTopCandidate - bullishFvgBottomCandidate : na
float bearishFvgSizeCandidate = not na(bearishFvgTopCandidate) and not na(bearishFvgBottomCandidate) ? bearishFvgTopCandidate - bearishFvgBottomCandidate : na
float bullishFvgMinimumSize = CalculateSweepPenetration(bullishFvgMidCandidate, minimumFvgSizeValue, fvgSizeMode, atrValue)
float bearishFvgMinimumSize = CalculateSweepPenetration(bearishFvgMidCandidate, minimumFvgSizeValue, fvgSizeMode, atrValue)
float bullishFvgSizeATR = SafeDivide(bullishFvgSizeCandidate, atrValue, na)
float bearishFvgSizeATR = SafeDivide(bearishFvgSizeCandidate, atrValue, na)
bool bullishFvgDisplacementValid = not requireFvgDisplacementCandle or (close[1] > open[1] and bodyPercent[1] >= minimumFvgDisplacementBodyPercent)
bool bearishFvgDisplacementValid = not requireFvgDisplacementCandle or (close[1] < open[1] and bodyPercent[1] >= minimumFvgDisplacementBodyPercent)
bool bullishFvgCandidate = fairValueGapsEnabled and barstate.isconfirmed and fvgHistoryAvailable and not na(bullishFvgSizeCandidate) and bullishFvgSizeCandidate > 0.0 and not na(bullishFvgMinimumSize) and bullishFvgSizeCandidate >= bullishFvgMinimumSize and not na(bullishFvgSizeATR) and bullishFvgSizeATR >= minimumFvgAtrRatio and bullishFvgDisplacementValid
bool bearishFvgCandidate = fairValueGapsEnabled and barstate.isconfirmed and fvgHistoryAvailable and not na(bearishFvgSizeCandidate) and bearishFvgSizeCandidate > 0.0 and not na(bearishFvgMinimumSize) and bearishFvgSizeCandidate >= bearishFvgMinimumSize and not na(bearishFvgSizeATR) and bearishFvgSizeATR >= minimumFvgAtrRatio and bearishFvgDisplacementValid
bool symbolMatches = str.contains(str.upper(syminfo.tickerid), str.upper(expectedSymbol))

if barstate.isconfirmed
    [nextPriorSwingHigh, nextPriorSwingLow, nextCurrentSwingHigh, nextCurrentSwingLow, nextStructure, nextStructureBreak] = CalculateMarketStructure(priorSwingHigh, priorSwingLow, trendState.swingHigh, trendState.swingLow, trendState.structure, confirmedPivotHigh, confirmedPivotLow)
    [nextEqualHighLevel, nextEqualHighTouches, nextEqualHighLastBar, nextEqualHighActive] = CalculateEqualLevelState(equalLevelsEnabled, true, equalHighLevel, equalHighTouchCount, equalHighLastBar, confirmedPivotHigh, bar_index - pivotLength, equalLevelTolerance, equalLevelToleranceValid, equalLevelMinimumTouches, equalLevelMaximumAge, high, low)
    [nextEqualLowLevel, nextEqualLowTouches, nextEqualLowLastBar, nextEqualLowActive] = CalculateEqualLevelState(equalLevelsEnabled, false, equalLowLevel, equalLowTouchCount, equalLowLastBar, confirmedPivotLow, bar_index - pivotLength, equalLevelTolerance, equalLevelToleranceValid, equalLevelMinimumTouches, equalLevelMaximumAge, high, low)
    [nextTrendDirection, nextTrendStrength, nextTrendScore, nextVwapDistance, nextVwapSlope, nextIsTrending] = CalculateTrendState(fastEmaValue, slowEmaValue, htfFastEmaValue, htfSlowEmaValue, vwapValue, vwapValue[1], adxValue, plusDiValue, minusDiValue, nextStructure)

    // Persistent Trend Engine state is assigned only from the main execution scope.
    priorSwingHigh := nextPriorSwingHigh
    priorSwingLow := nextPriorSwingLow
    equalHighLevel := nextEqualHighLevel
    equalHighTouchCount := nextEqualHighTouches
    equalHighLastBar := nextEqualHighLastBar
    equalHighActive := nextEqualHighActive
    equalLowLevel := nextEqualLowLevel
    equalLowTouchCount := nextEqualLowTouches
    equalLowLastBar := nextEqualLowLastBar
    equalLowActive := nextEqualLowActive
    trendState.swingHigh := nextCurrentSwingHigh
    trendState.swingLow := nextCurrentSwingLow
    trendState.structure := nextStructure
    trendState.structureBreak := nextStructureBreak
    trendState.fastEma := fastEmaValue
    trendState.slowEma := slowEmaValue
    trendState.htfFastEma := htfFastEmaValue
    trendState.htfSlowEma := htfSlowEmaValue
    trendState.vwapValue := vwapValue
    trendState.vwapDistance := nextVwapDistance
    trendState.vwapSlope := nextVwapSlope
    trendState.adx := adxValue
    trendState.plusDi := plusDiValue
    trendState.minusDi := minusDiValue
    trendState.isTrending := nextIsTrending
    trendState.score := nextTrendScore
    trendState.direction := nextTrendDirection
    trendState.strength := nextTrendStrength
    sessionState := CalculateSessionState(sessionState)
    if sessionState.justEnded
        if rangeState.isComplete
            sessionStatistics := CalculateCompletedRangeStatistics(sessionStatistics, rangeState)
        tradeControl.sessionLocked := true
        breakoutState := BreakoutState.Invalidated
    if enabled and symbolMatches and sessionState.justStarted
        [resetRangeState, resetTradeControl, resetBreakoutDirection, resetAtrAtCompletion, resetBreakoutState] = CreateSessionRange()
        rangeState := resetRangeState
        tradeControl := resetTradeControl
        breakoutDirection := resetBreakoutDirection
        atrAtRangeCompletion := resetAtrAtCompletion
        breakoutState := resetBreakoutState
        breakoutAttempted := false
        breakoutConfirmed := false
        breakoutFailed := false
        breakoutBarIndex := na
        breakoutPrice := na
        breakoutTradeDirection := TradeDirection.None
        breakoutDistance := na
        breakoutDistancePercent := na
        breakoutDistanceATR := na
        breakoutScore := na
        breakoutStrength := BreakoutStrength.Weak
        bullishFailureCount := 0
        bearishFailureCount := 0
        retestState := RetestState.None
        retestLevel := na
        retestScore := na
        retestBarIndex := na
        retestStartBarIndex := na
        retestStartTime := na
        retestTradeDirection := TradeDirection.None
        retestDistance := na
        retestDistanceATR := na
        retestPenetration := na
        retestPenetrationATR := na
        retestBarsSinceBreakout := na
        retestAttempted := false
        retestConfirmed := false
        retestFailed := false
        bullishRetestFailureCount := 0
        bearishRetestFailureCount := 0
        retestAttemptCount := 0
        retestRetryPending := false
    if enabled and symbolMatches and sessionState.isActive
        [calculatedRangeState, calculatedAtrAtCompletion, calculatedRangeBreakoutState] = CalculateOpeningRange(rangeState, atrValue)
        rangeState := calculatedRangeState
        atrAtRangeCompletion := calculatedAtrAtCompletion
        breakoutState := calculatedRangeBreakoutState
        [calculatedBreakoutDirection, calculatedBreakoutState, calculatedSessionStatistics] = CalculateBreakoutState(rangeState, breakoutState, breakoutDirection, sessionStatistics)
        breakoutDirection := calculatedBreakoutDirection
        breakoutState := calculatedBreakoutState
        sessionStatistics := calculatedSessionStatistics

    // M4-C event outputs reset every confirmed bar; persistent state is retained.
    bullishBreakoutSignal := false
    bearishBreakoutSignal := false
    bullishBreakoutFailure := false
    bearishBreakoutFailure := false
    if bullishBreakoutAccepted
        breakoutState := BreakoutState.BullishConfirmed
        breakoutAttempted := true
        breakoutConfirmed := true
        breakoutFailed := false
        breakoutBarIndex := bar_index
        breakoutPrice := close
        breakoutTradeDirection := TradeDirection.Long
        breakoutDistance := close - rangeState.high
        breakoutDistancePercent := SafeDivide(breakoutDistance * 100.0, rangeState.high, na)
        breakoutDistanceATR := SafeDivide(breakoutDistance, atrValue, na)
        breakoutScore := bullishBreakoutScore
        breakoutStrength := bullishBreakoutStrength
        bullishBreakoutSignal := true
        bullishFailureCount := 0
        bearishFailureCount := 0
    else if bearishBreakoutAccepted
        breakoutState := BreakoutState.BearishConfirmed
        breakoutAttempted := true
        breakoutConfirmed := true
        breakoutFailed := false
        breakoutBarIndex := bar_index
        breakoutPrice := close
        breakoutTradeDirection := TradeDirection.Short
        breakoutDistance := rangeState.low - close
        breakoutDistancePercent := SafeDivide(breakoutDistance * 100.0, rangeState.low, na)
        breakoutDistanceATR := SafeDivide(breakoutDistance, atrValue, na)
        breakoutScore := bearishBreakoutScore
        breakoutStrength := bearishBreakoutStrength
        bearishBreakoutSignal := true
        bullishFailureCount := 0
        bearishFailureCount := 0
    if enableFailureDetection and breakoutState == BreakoutState.BullishConfirmed
        bullishFailureCount := close <= rangeState.high - failureBuffer ? bullishFailureCount + 1 : 0
        if bullishFailureCount >= failureConfirmationBars
            breakoutState := BreakoutState.BullishFailed
            breakoutConfirmed := false
            breakoutFailed := true
            bullishBreakoutFailure := true
    else if enableFailureDetection and breakoutState == BreakoutState.BearishConfirmed
        bearishFailureCount := close >= rangeState.low + failureBuffer ? bearishFailureCount + 1 : 0
        if bearishFailureCount >= failureConfirmationBars
            breakoutState := BreakoutState.BearishFailed
            breakoutConfirmed := false
            breakoutFailed := true
            bearishBreakoutFailure := true
    if bullishBreakoutSignal != bearishBreakoutSignal
        retestState := RetestState.WaitingForRetest
        retestTradeDirection := bullishBreakoutSignal ? TradeDirection.Long : TradeDirection.Short
        retestLevel := bullishBreakoutSignal ? rangeState.high : rangeState.low
        retestStartBarIndex := bar_index
        retestStartTime := time
        retestBarIndex := na
        retestDistance := na
        retestDistanceATR := na
        retestPenetration := na
        retestPenetrationATR := na
        retestBarsSinceBreakout := 0
        retestAttempted := false
        retestConfirmed := false
        retestFailed := false
        bullishRetestFailureCount := 0
        bearishRetestFailureCount := 0
        retestAttemptCount := 0
        retestRetryPending := false
    bool matchingBreakoutFailure = (retestTradeDirection == TradeDirection.Long and (bullishBreakoutFailure or breakoutState == BreakoutState.BullishFailed)) or (retestTradeDirection == TradeDirection.Short and (bearishBreakoutFailure or breakoutState == BreakoutState.BearishFailed))
    bool retestLifecycleActive = retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected or (retestState == RetestState.RetestFailed and retestRetryPending)
    bool retestFailureTransition = false
    if retestLifecycleActive and not retestConfirmed and matchingBreakoutFailure
        retestState := RetestState.RetestFailed
        retestFailed := true
        retestConfirmed := false
        retestRetryPending := false
        retestRetryEligible := false
    else if retestLifecycleActive and not retestConfirmed and not retestWindowValid
        retestState := RetestState.Expired
        retestConfirmed := false
        retestFailed := false
        retestRetryPending := false
        retestRetryEligible := false
    else if retestState == RetestState.RetestFailed and retestRetryPending and retestRetryEligible
        retestState := RetestState.WaitingForRetest
        retestFailed := false
        retestConfirmed := false
        retestRetryPending := false
        retestRetryEligible := false
        retestBarIndex := na
        retestDistance := na
        retestDistanceATR := na
        retestPenetration := na
        retestPenetrationATR := na
        bullishRetestFailureCount := 0
        bearishRetestFailureCount := 0
    if retestActive and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected)
        retestBarsSinceBreakout := bar_index - retestStartBarIndex
        retestDistance := math.abs(close - retestLevel)
        retestDistanceATR := SafeDivide(retestDistance, atrValue, na)
        retestPenetration := retestTradeDirection == TradeDirection.Long ? math.max(retestLevel - low, 0.0) : math.max(high - retestLevel, 0.0)
        retestPenetrationATR := SafeDivide(retestPenetration, atrValue, na)
        if (retestTradeDirection == TradeDirection.Long and low < retestLevel - maximumRetestPenetration) or (retestTradeDirection == TradeDirection.Short and high > retestLevel + maximumRetestPenetration)
            retestState := RetestState.RetestFailed
            retestFailed := true
            retestFailureTransition := true
        else if retestState == RetestState.WaitingForRetest and (bullishRetestInteraction or bearishRetestInteraction)
            retestState := RetestState.RetestDetected
            retestAttempted := true
            retestAttemptCount += 1
            retestBarIndex := bar_index
            bullishRetestDetected := bullishRetestInteraction
            bearishRetestDetected := bearishRetestInteraction
    if retestState == RetestState.RetestDetected and not retestConfirmed
        if retestTradeDirection == TradeDirection.Long
            bullishRetestFailureCount := bullishRetestCloseFailure ? bullishRetestFailureCount + 1 : 0
            bearishRetestFailureCount := 0
        else if retestTradeDirection == TradeDirection.Short
            bearishRetestFailureCount := bearishRetestCloseFailure ? bearishRetestFailureCount + 1 : 0
            bullishRetestFailureCount := 0
        else
            bullishRetestFailureCount := 0
            bearishRetestFailureCount := 0
    else
        bullishRetestFailureCount := 0
        bearishRetestFailureCount := 0
    if bullishRetestFailureThresholdReached and retestTradeDirection == TradeDirection.Long and retestState == RetestState.RetestDetected and not retestConfirmed and barstate.isconfirmed
        bullishRetestFailure := true
        bearishRetestFailure := false
        retestState := RetestState.RetestFailed
        retestFailed := true
        retestConfirmed := false
        retestFailureTransition := true
        bullishRetestFailureCount := 0
        bearishRetestFailureCount := 0
    else if bearishRetestFailureThresholdReached and retestTradeDirection == TradeDirection.Short and retestState == RetestState.RetestDetected and not retestConfirmed and barstate.isconfirmed
        bearishRetestFailure := true
        bullishRetestFailure := false
        retestState := RetestState.RetestFailed
        retestFailed := true
        retestConfirmed := false
        retestFailureTransition := true
        bullishRetestFailureCount := 0
        bearishRetestFailureCount := 0
    if retestFailureTransition
        retestRetryEligible := allowMultipleRetestAttempts and not retestConfirmed and not matchingBreakoutFailure and retestWindowValid
        if retestRetryEligible
            retestRetryPending := true
    if (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected) and bullishRetestConfirmationCandidate != bearishRetestConfirmationCandidate
        if bullishRetestConfirmationCandidate
            retestState := RetestState.RetestConfirmed
            retestConfirmed := true
            retestFailed := false
            retestRetryPending := false
            retestRetryEligible := false
            retestTradeDirection := TradeDirection.Long
            retestScore := bullishRetestScore
            retestBarIndex := bar_index
            bullishRetestConfirmed := true
        else if bearishRetestConfirmationCandidate
            retestState := RetestState.RetestConfirmed
            retestConfirmed := true
            retestFailed := false
            retestRetryPending := false
            retestRetryEligible := false
            retestTradeDirection := TradeDirection.Short
            retestScore := bearishRetestScore
            retestBarIndex := bar_index
            bearishRetestConfirmed := true
    // M6-B priority is Equal, Previous Day, Previous Week, M3 Swing, then Opening Range.
    // An ambiguous two-sided sweep is rejected so only one directional event can occur per bar.
    bullishLiquiditySweep := false
    bearishLiquiditySweep := false
    if bullishRawLiquiditySweep != bearishRawLiquiditySweep
        if bullishRawLiquiditySweep
            bullishSweepConfirmationCount += 1
            bearishSweepConfirmationCount := 0
            if bullishSweepConfirmationCount == sweepConfirmationBars
                bullishLiquiditySweep := true
                sweptLevel := bullishSweepLevelCandidate
                sweepDistance := bullishSweepPenetrationCandidate
                sweepDistanceATR := SafeDivide(sweepDistance, atrValue, na)
                sweepSource := bullishSweepSourceCandidate
                sweepStrength := CalculateSweepStrength(sweepDistance, bullishSweepMaximumPenetration, lowerWickPercent, close > sweptLevel, sweepSource)
                sweepBias := TradeDirection.Long
                sweepBarIndex := bar_index
        else
            bearishSweepConfirmationCount += 1
            bullishSweepConfirmationCount := 0
            if bearishSweepConfirmationCount == sweepConfirmationBars
                bearishLiquiditySweep := true
                sweptLevel := bearishSweepLevelCandidate
                sweepDistance := bearishSweepPenetrationCandidate
                sweepDistanceATR := SafeDivide(sweepDistance, atrValue, na)
                sweepSource := bearishSweepSourceCandidate
                sweepStrength := CalculateSweepStrength(sweepDistance, bearishSweepMaximumPenetration, upperWickPercent, close < sweptLevel, sweepSource)
                sweepBias := TradeDirection.Short
                sweepBarIndex := bar_index
    else
        bullishSweepConfirmationCount := 0
        bearishSweepConfirmationCount := 0
    // M6-C keeps both direction-specific arrays bounded and applies wick-based
    // mitigation for Midpoint/FullFill; CloseThrough requires a completed close.
    bullishFvgCreated := false
    bearishFvgCreated := false
    if not fairValueGapsEnabled
        array.clear(bullishFvgZones)
        array.clear(bearishFvgZones)
    while array.size(bullishFvgZones) > maximumActiveFvgs
        array.shift(bullishFvgZones)
    while array.size(bearishFvgZones) > maximumActiveFvgs
        array.shift(bearishFvgZones)
    if array.size(bullishFvgZones) > 0
        for index = 0 to array.size(bullishFvgZones) - 1
            FvgZone zone = array.get(bullishFvgZones, index)
            if zone.active
                bool expired = bar_index - zone.creationBar > maximumFvgAge
                bool enteredFromAbove = close[1] > zone.top and low <= zone.top and high >= zone.bottom
                bool fullyMitigated = fvgInvalidationMode == FvgInvalidationMode.Midpoint ? low <= zone.midpoint : fvgInvalidationMode == FvgInvalidationMode.FullFill ? low <= zone.bottom : close <= zone.bottom
                zone.partiallyMitigated := zone.partiallyMitigated or (enteredFromAbove and not fullyMitigated)
                zone.fullyMitigated := zone.fullyMitigated or fullyMitigated
                zone.active := not expired and not zone.fullyMitigated
                array.set(bullishFvgZones, index, zone)
    if array.size(bearishFvgZones) > 0
        for index = 0 to array.size(bearishFvgZones) - 1
            FvgZone zone = array.get(bearishFvgZones, index)
            if zone.active
                bool expired = bar_index - zone.creationBar > maximumFvgAge
                bool enteredFromBelow = close[1] < zone.bottom and high >= zone.bottom and low <= zone.top
                bool fullyMitigated = fvgInvalidationMode == FvgInvalidationMode.Midpoint ? high >= zone.midpoint : fvgInvalidationMode == FvgInvalidationMode.FullFill ? high >= zone.top : close >= zone.top
                zone.partiallyMitigated := zone.partiallyMitigated or (enteredFromBelow and not fullyMitigated)
                zone.fullyMitigated := zone.fullyMitigated or fullyMitigated
                zone.active := not expired and not zone.fullyMitigated
                array.set(bearishFvgZones, index, zone)
    if bullishFvgCandidate != bearishFvgCandidate
        if bullishFvgCandidate
            while array.size(bullishFvgZones) >= maximumActiveFvgs
                array.shift(bullishFvgZones)
            array.push(bullishFvgZones, FvgZone.new(TradeDirection.Long, bullishFvgTopCandidate, bullishFvgBottomCandidate, bullishFvgMidCandidate, bar_index, true, false, false))
            bullishFvgCreated := true
        else if bearishFvgCandidate
            while array.size(bearishFvgZones) >= maximumActiveFvgs
                array.shift(bearishFvgZones)
            array.push(bearishFvgZones, FvgZone.new(TradeDirection.Short, bearishFvgTopCandidate, bearishFvgBottomCandidate, bearishFvgMidCandidate, bar_index, true, false, false))
            bearishFvgCreated := true
    latestBullishFvgTop := na
    latestBullishFvgBottom := na
    latestBullishFvgMid := na
    latestBullishFvgAge := na
    latestBullishFvgActive := false
    nearestBullishFvgDistance := na
    insideBullishFvg := false
    bullishFvgSupportsRetest := false
    int latestBullishFvgCreationBar = na
    if array.size(bullishFvgZones) > 0
        for index = 0 to array.size(bullishFvgZones) - 1
            FvgZone zone = array.get(bullishFvgZones, index)
            if zone.active
                float zoneDistance = DistanceToFvgZone(close, zone.top, zone.bottom)
                float retestZoneDistance = DistanceToFvgZone(retestLevel, zone.top, zone.bottom)
                if na(latestBullishFvgCreationBar) or zone.creationBar > latestBullishFvgCreationBar
                    latestBullishFvgTop := zone.top
                    latestBullishFvgBottom := zone.bottom
                    latestBullishFvgMid := zone.midpoint
                    latestBullishFvgAge := bar_index - zone.creationBar
                    latestBullishFvgActive := true
                    latestBullishFvgCreationBar := zone.creationBar
                if na(nearestBullishFvgDistance) or zoneDistance < nearestBullishFvgDistance
                    nearestBullishFvgDistance := zoneDistance
                insideBullishFvg := insideBullishFvg or zoneDistance == 0.0
                bullishFvgSupportsRetest := bullishFvgSupportsRetest or (retestTradeDirection == TradeDirection.Long and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected) and not na(retestTolerance) and not na(retestZoneDistance) and retestZoneDistance <= retestTolerance)
    latestBearishFvgTop := na
    latestBearishFvgBottom := na
    latestBearishFvgMid := na
    latestBearishFvgAge := na
    latestBearishFvgActive := false
    nearestBearishFvgDistance := na
    insideBearishFvg := false
    bearishFvgSupportsRetest := false
    int latestBearishFvgCreationBar = na
    if array.size(bearishFvgZones) > 0
        for index = 0 to array.size(bearishFvgZones) - 1
            FvgZone zone = array.get(bearishFvgZones, index)
            if zone.active
                float zoneDistance = DistanceToFvgZone(close, zone.top, zone.bottom)
                float retestZoneDistance = DistanceToFvgZone(retestLevel, zone.top, zone.bottom)
                if na(latestBearishFvgCreationBar) or zone.creationBar > latestBearishFvgCreationBar
                    latestBearishFvgTop := zone.top
                    latestBearishFvgBottom := zone.bottom
                    latestBearishFvgMid := zone.midpoint
                    latestBearishFvgAge := bar_index - zone.creationBar
                    latestBearishFvgActive := true
                    latestBearishFvgCreationBar := zone.creationBar
                if na(nearestBearishFvgDistance) or zoneDistance < nearestBearishFvgDistance
                    nearestBearishFvgDistance := zoneDistance
                insideBearishFvg := insideBearishFvg or zoneDistance == 0.0
                bearishFvgSupportsRetest := bearishFvgSupportsRetest or (retestTradeDirection == TradeDirection.Short and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected) and not na(retestTolerance) and not na(retestZoneDistance) and retestZoneDistance <= retestTolerance)
    nearestBullishFvgDistanceATR := SafeDivide(nearestBullishFvgDistance, atrValue, na)
    nearestBearishFvgDistanceATR := SafeDivide(nearestBearishFvgDistance, atrValue, na)
    // M6-D uses the complete opposite candle range as the deterministic OB zone.
    float bullishObSourceTop = na
    float bullishObSourceBottom = na
    int bullishObSourceBar = na
    float bearishObSourceTop = na
    float bearishObSourceBottom = na
    int bearishObSourceBar = na
    bool bullishStructureContext = trendState.structureBreak and (trendState.structure == MarketStructure.HigherHigh or trendState.structure == MarketStructure.HigherLow)
    bool bearishStructureContext = trendState.structureBreak and (trendState.structure == MarketStructure.LowerHigh or trendState.structure == MarketStructure.LowerLow)
    bool bullishObSetup = orderBlocksEnabled and close > open and breakoutCandleATR >= minimumOrderBlockDisplacementAtr and (not requireOrderBlockStructureBreak or bullishStructureContext)
    bool bearishObSetup = orderBlocksEnabled and close < open and breakoutCandleATR >= minimumOrderBlockDisplacementAtr and (not requireOrderBlockStructureBreak or bearishStructureContext)
    if bullishObSetup
        for offset = 1 to orderBlockLookback
            if offset <= bar_index and na(bullishObSourceBar) and close[offset] < open[offset]
                bullishObSourceTop := high[offset]
                bullishObSourceBottom := low[offset]
                bullishObSourceBar := bar_index - offset
    if bearishObSetup
        for offset = 1 to orderBlockLookback
            if offset <= bar_index and na(bearishObSourceBar) and close[offset] > open[offset]
                bearishObSourceTop := high[offset]
                bearishObSourceBottom := low[offset]
                bearishObSourceBar := bar_index - offset
    if not orderBlocksEnabled
        array.clear(bullishOrderBlocks)
        array.clear(bearishOrderBlocks)
    while array.size(bullishOrderBlocks) > maximumActiveOrderBlocks
        array.shift(bullishOrderBlocks)
    while array.size(bearishOrderBlocks) > maximumActiveOrderBlocks
        array.shift(bearishOrderBlocks)
    if array.size(bullishOrderBlocks) > 0
        for index = 0 to array.size(bullishOrderBlocks) - 1
            OrderBlockZone zone = array.get(bullishOrderBlocks, index)
            if zone.active
                bool invalidated = orderBlockInvalidationMode == OrderBlockInvalidationMode.WickThrough ? low < zone.bottom : close < zone.bottom
                zone.mitigated := zone.mitigated or (close[1] > zone.top and low <= zone.top and high >= zone.bottom)
                zone.invalidated := zone.invalidated or invalidated
                zone.active := not zone.invalidated and bar_index - zone.creationBar <= maximumOrderBlockAge
                array.set(bullishOrderBlocks, index, zone)
    if array.size(bearishOrderBlocks) > 0
        for index = 0 to array.size(bearishOrderBlocks) - 1
            OrderBlockZone zone = array.get(bearishOrderBlocks, index)
            if zone.active
                bool invalidated = orderBlockInvalidationMode == OrderBlockInvalidationMode.WickThrough ? high > zone.top : close > zone.top
                zone.mitigated := zone.mitigated or (close[1] < zone.bottom and high >= zone.bottom and low <= zone.top)
                zone.invalidated := zone.invalidated or invalidated
                zone.active := not zone.invalidated and bar_index - zone.creationBar <= maximumOrderBlockAge
                array.set(bearishOrderBlocks, index, zone)
    bool bullishObDuplicate = false
    bool bearishObDuplicate = false
    if array.size(bullishOrderBlocks) > 0
        for index = 0 to array.size(bullishOrderBlocks) - 1
            OrderBlockZone existingZone = array.get(bullishOrderBlocks, index)
            bullishObDuplicate := bullishObDuplicate or (not na(bullishObSourceBar) and existingZone.sourceBar == bullishObSourceBar)
    if array.size(bearishOrderBlocks) > 0
        for index = 0 to array.size(bearishOrderBlocks) - 1
            OrderBlockZone existingZone = array.get(bearishOrderBlocks, index)
            bearishObDuplicate := bearishObDuplicate or (not na(bearishObSourceBar) and existingZone.sourceBar == bearishObSourceBar)
    if bullishObSetup and not na(bullishObSourceBar) and not bullishObDuplicate
        while array.size(bullishOrderBlocks) >= maximumActiveOrderBlocks
            array.shift(bullishOrderBlocks)
        array.push(bullishOrderBlocks, OrderBlockZone.new(TradeDirection.Long, bullishObSourceTop, bullishObSourceBottom, (bullishObSourceTop + bullishObSourceBottom) * 0.5, bar_index, bullishObSourceBar, true, false, false))
    if bearishObSetup and not na(bearishObSourceBar) and not bearishObDuplicate
        while array.size(bearishOrderBlocks) >= maximumActiveOrderBlocks
            array.shift(bearishOrderBlocks)
        array.push(bearishOrderBlocks, OrderBlockZone.new(TradeDirection.Short, bearishObSourceTop, bearishObSourceBottom, (bearishObSourceTop + bearishObSourceBottom) * 0.5, bar_index, bearishObSourceBar, true, false, false))
    latestBullishObTop := na
    latestBullishObBottom := na
    latestBullishObMid := na
    latestBullishObAge := na
    latestBullishObActive := false
    nearestBullishObDistance := na
    insideBullishOrderBlock := false
    bullishObSupportsRetest := false
    int latestBullishObCreationBar = na
    if array.size(bullishOrderBlocks) > 0
        for index = 0 to array.size(bullishOrderBlocks) - 1
            OrderBlockZone zone = array.get(bullishOrderBlocks, index)
            if zone.active
                float distance = DistanceToFvgZone(close, zone.top, zone.bottom)
                float retestDistanceToZone = DistanceToFvgZone(retestLevel, zone.top, zone.bottom)
                if na(latestBullishObCreationBar) or zone.creationBar > latestBullishObCreationBar
                    latestBullishObTop := zone.top
                    latestBullishObBottom := zone.bottom
                    latestBullishObMid := zone.midpoint
                    latestBullishObAge := bar_index - zone.creationBar
                    latestBullishObActive := true
                    latestBullishObCreationBar := zone.creationBar
                nearestBullishObDistance := na(nearestBullishObDistance) or distance < nearestBullishObDistance ? distance : nearestBullishObDistance
                insideBullishOrderBlock := insideBullishOrderBlock or distance == 0.0
                bullishObSupportsRetest := bullishObSupportsRetest or (retestTradeDirection == TradeDirection.Long and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected) and not na(retestTolerance) and not na(retestDistanceToZone) and retestDistanceToZone <= retestTolerance)
    latestBearishObTop := na
    latestBearishObBottom := na
    latestBearishObMid := na
    latestBearishObAge := na
    latestBearishObActive := false
    nearestBearishObDistance := na
    insideBearishOrderBlock := false
    bearishObSupportsRetest := false
    int latestBearishObCreationBar = na
    if array.size(bearishOrderBlocks) > 0
        for index = 0 to array.size(bearishOrderBlocks) - 1
            OrderBlockZone zone = array.get(bearishOrderBlocks, index)
            if zone.active
                float distance = DistanceToFvgZone(close, zone.top, zone.bottom)
                float retestDistanceToZone = DistanceToFvgZone(retestLevel, zone.top, zone.bottom)
                if na(latestBearishObCreationBar) or zone.creationBar > latestBearishObCreationBar
                    latestBearishObTop := zone.top
                    latestBearishObBottom := zone.bottom
                    latestBearishObMid := zone.midpoint
                    latestBearishObAge := bar_index - zone.creationBar
                    latestBearishObActive := true
                    latestBearishObCreationBar := zone.creationBar
                nearestBearishObDistance := na(nearestBearishObDistance) or distance < nearestBearishObDistance ? distance : nearestBearishObDistance
                insideBearishOrderBlock := insideBearishOrderBlock or distance == 0.0
                bearishObSupportsRetest := bearishObSupportsRetest or (retestTradeDirection == TradeDirection.Short and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected) and not na(retestTolerance) and not na(retestDistanceToZone) and retestDistanceToZone <= retestTolerance)
    nearestBullishObDistanceATR := SafeDivide(nearestBullishObDistance, atrValue, na)
    nearestBearishObDistanceATR := SafeDivide(nearestBearishObDistance, atrValue, na)
    float candidateRangeHigh = dealingRangeMode == DealingRangeMode.RecentStructure ? trendState.swingHigh : dealingRangeMode == DealingRangeMode.OpeningRange ? rangeState.high : previousDayHigh
    float candidateRangeLow = dealingRangeMode == DealingRangeMode.RecentStructure ? trendState.swingLow : dealingRangeMode == DealingRangeMode.OpeningRange ? rangeState.low : previousDayLow
    if dealingRangeMode == DealingRangeMode.RecentStructure and (na(candidateRangeHigh) or na(candidateRangeLow) or candidateRangeHigh <= candidateRangeLow) and rangeState.isComplete
        candidateRangeHigh := rangeState.high
        candidateRangeLow := rangeState.low
    dealingRangeHigh := premiumDiscountEnabled and not na(candidateRangeHigh) and not na(candidateRangeLow) and candidateRangeHigh > candidateRangeLow ? candidateRangeHigh : na
    dealingRangeLow := premiumDiscountEnabled and not na(candidateRangeHigh) and not na(candidateRangeLow) and candidateRangeHigh > candidateRangeLow ? candidateRangeLow : na
    dealingRangeEquilibrium := not na(dealingRangeHigh) ? (dealingRangeHigh + dealingRangeLow) * 0.5 : na
    premiumDiscountState := na(dealingRangeEquilibrium) ? PremiumDiscountState.Unknown : close > dealingRangeEquilibrium + syminfo.mintick ? PremiumDiscountState.Premium : close < dealingRangeEquilibrium - syminfo.mintick ? PremiumDiscountState.Discount : PremiumDiscountState.Equilibrium
    bullishDiscountSupportsRetest := retestTradeDirection == TradeDirection.Long and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected) and premiumDiscountState == PremiumDiscountState.Discount
    bearishPremiumSupportsRetest := retestTradeDirection == TradeDirection.Short and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected) and premiumDiscountState == PremiumDiscountState.Premium
    if not sessionState.isActive and not breakoutConfirmed and not breakoutFailed
        breakoutState := BreakoutState.Invalidated
    else if rangeState.isComplete and not breakoutWindowValid and not breakoutConfirmed and not breakoutFailed
        breakoutState := BreakoutState.Invalidated

bool bullishSweepSupportsRetest = bullishLiquiditySweep and retestTradeDirection == TradeDirection.Long and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected)
bool bearishSweepSupportsRetest = bearishLiquiditySweep and retestTradeDirection == TradeDirection.Short and (retestState == RetestState.WaitingForRetest or retestState == RetestState.RetestDetected)
int sweepContextAge = not na(sweepBarIndex) ? bar_index - sweepBarIndex : 1000000
bool bullishRecentSweep = sweepBias == TradeDirection.Long and sweepContextAge <= 10
bool bearishRecentSweep = sweepBias == TradeDirection.Short and sweepContextAge <= 10
bool significantSweepSource = sweepSource == LiquiditySource.EqualHigh or sweepSource == LiquiditySource.EqualLow or sweepSource == LiquiditySource.PreviousDayHigh or sweepSource == LiquiditySource.PreviousDayLow or sweepSource == LiquiditySource.PreviousWeekHigh or sweepSource == LiquiditySource.PreviousWeekLow
float bullishSweepContextScore = math.min(25.0, (bullishLiquiditySweep ? 12.0 : 0.0) + (bullishRecentSweep ? 6.0 : 0.0) + (bullishSweepSupportsRetest ? 4.0 : 0.0) + (bullishRecentSweep and significantSweepSource ? 3.0 : 0.0))
float bearishSweepContextScore = math.min(25.0, (bearishLiquiditySweep ? 12.0 : 0.0) + (bearishRecentSweep ? 6.0 : 0.0) + (bearishSweepSupportsRetest ? 4.0 : 0.0) + (bearishRecentSweep and significantSweepSource ? 3.0 : 0.0))
float bullishFvgContextScore = math.min(20.0, (latestBullishFvgActive ? 8.0 : 0.0) + (insideBullishFvg ? 6.0 : 0.0) + (bullishFvgSupportsRetest ? 4.0 : 0.0) + (not na(nearestBullishFvgDistanceATR) and nearestBullishFvgDistanceATR <= 1.0 ? 2.0 : 0.0))
float bearishFvgContextScore = math.min(20.0, (latestBearishFvgActive ? 8.0 : 0.0) + (insideBearishFvg ? 6.0 : 0.0) + (bearishFvgSupportsRetest ? 4.0 : 0.0) + (not na(nearestBearishFvgDistanceATR) and nearestBearishFvgDistanceATR <= 1.0 ? 2.0 : 0.0))
float bullishObContextScore = math.min(20.0, (latestBullishObActive ? 8.0 : 0.0) + (insideBullishOrderBlock ? 6.0 : 0.0) + (bullishObSupportsRetest ? 4.0 : 0.0) + (not na(nearestBullishObDistanceATR) and nearestBullishObDistanceATR <= 1.0 ? 2.0 : 0.0))
float bearishObContextScore = math.min(20.0, (latestBearishObActive ? 8.0 : 0.0) + (insideBearishOrderBlock ? 6.0 : 0.0) + (bearishObSupportsRetest ? 4.0 : 0.0) + (not na(nearestBearishObDistanceATR) and nearestBearishObDistanceATR <= 1.0 ? 2.0 : 0.0))
float bullishEqualLevelScore = math.min(10.0, (equalLowActive ? 6.0 : 0.0) + (bullishRecentSweep and sweepSource == LiquiditySource.EqualLow ? 4.0 : 0.0))
float bearishEqualLevelScore = math.min(10.0, (equalHighActive ? 6.0 : 0.0) + (bearishRecentSweep and sweepSource == LiquiditySource.EqualHigh ? 4.0 : 0.0))
float bullishHtfLiquidityScore = math.min(15.0, (bullishRecentSweep and (sweepSource == LiquiditySource.PreviousDayLow or sweepSource == LiquiditySource.PreviousWeekLow) ? 10.0 : 0.0) + (not na(distanceToPDL) and distanceToPDL <= atrValue ? 3.0 : 0.0) + (not na(distanceToPWL) and distanceToPWL <= atrValue ? 2.0 : 0.0))
float bearishHtfLiquidityScore = math.min(15.0, (bearishRecentSweep and (sweepSource == LiquiditySource.PreviousDayHigh or sweepSource == LiquiditySource.PreviousWeekHigh) ? 10.0 : 0.0) + (not na(distanceToPDH) and distanceToPDH <= atrValue ? 3.0 : 0.0) + (not na(distanceToPWH) and distanceToPWH <= atrValue ? 2.0 : 0.0))
float bullishPremiumDiscountScore = bullishDiscountSupportsRetest ? 10.0 : premiumDiscountState == PremiumDiscountState.Discount ? 7.0 : premiumDiscountState == PremiumDiscountState.Equilibrium ? 3.0 : 0.0
float bearishPremiumDiscountScore = bearishPremiumSupportsRetest ? 10.0 : premiumDiscountState == PremiumDiscountState.Premium ? 7.0 : premiumDiscountState == PremiumDiscountState.Equilibrium ? 3.0 : 0.0
bullishSmartMoneyScore := math.min(100.0, bullishSweepContextScore + bullishFvgContextScore + bullishObContextScore + bullishEqualLevelScore + bullishHtfLiquidityScore + bullishPremiumDiscountScore)
bearishSmartMoneyScore := math.min(100.0, bearishSweepContextScore + bearishFvgContextScore + bearishObContextScore + bearishEqualLevelScore + bearishHtfLiquidityScore + bearishPremiumDiscountScore)
smartMoneyBias := bullishSmartMoneyScore - bearishSmartMoneyScore >= smartMoneyBiasMinimumDifference ? SmartMoneyBias.Bullish : bearishSmartMoneyScore - bullishSmartMoneyScore >= smartMoneyBiasMinimumDifference ? SmartMoneyBias.Bearish : SmartMoneyBias.Neutral
float dominantSmartMoneyScore = math.max(bullishSmartMoneyScore, bearishSmartMoneyScore)
smartMoneyStrength := dominantSmartMoneyScore >= 85.0 ? SmartMoneyStrength.Extreme : dominantSmartMoneyScore >= 65.0 ? SmartMoneyStrength.Strong : dominantSmartMoneyScore >= 40.0 ? SmartMoneyStrength.Normal : SmartMoneyStrength.Weak
float bullishSessionScore = math.min(10.0, (sessionState.isActive ? 2.0 : 0.0) + (rangeState.isComplete ? 2.0 : 0.0) + (rangeState.qualityAccepted ? 3.0 : 0.0) + (breakoutRangeQualityValid ? 3.0 : 0.0))
float bearishSessionScore = bullishSessionScore
float bullishTrendScore = math.min(20.0, (trendState.direction == TrendDirection.Bullish ? 5.0 : 0.0) + (trendState.htfFastEma > trendState.htfSlowEma ? 5.0 : 0.0) + (close > trendState.vwapValue ? 3.0 : 0.0) + (trendState.isTrending and trendState.plusDi > trendState.minusDi ? 3.0 : 0.0) + ((trendState.structure == MarketStructure.HigherHigh or trendState.structure == MarketStructure.HigherLow) ? 4.0 : 0.0))
float bearishTrendScore = math.min(20.0, (trendState.direction == TrendDirection.Bearish ? 5.0 : 0.0) + (trendState.htfFastEma < trendState.htfSlowEma ? 5.0 : 0.0) + (close < trendState.vwapValue ? 3.0 : 0.0) + (trendState.isTrending and trendState.minusDi > trendState.plusDi ? 3.0 : 0.0) + ((trendState.structure == MarketStructure.LowerHigh or trendState.structure == MarketStructure.LowerLow) ? 4.0 : 0.0))
bool bullishBreakoutContext = breakoutState == BreakoutState.BullishConfirmed and breakoutTradeDirection == TradeDirection.Long and not breakoutFailed
bool bearishBreakoutContext = breakoutState == BreakoutState.BearishConfirmed and breakoutTradeDirection == TradeDirection.Short and not breakoutFailed
float bullishTradeBreakoutScore = bullishBreakoutContext ? math.min(25.0, math.max(0.0, bullishBreakoutScore * 0.25)) : 0.0
float bearishTradeBreakoutScore = bearishBreakoutContext ? math.min(25.0, math.max(0.0, bearishBreakoutScore * 0.25)) : 0.0
bool bullishTradeRetestContext = retestTradeDirection == TradeDirection.Long and (retestState == RetestState.RetestDetected or retestState == RetestState.RetestConfirmed) and not retestFailed
bool bearishTradeRetestContext = retestTradeDirection == TradeDirection.Short and (retestState == RetestState.RetestDetected or retestState == RetestState.RetestConfirmed) and not retestFailed
float bullishRetestSourceScore = retestState == RetestState.RetestConfirmed ? retestScore : bullishRetestScore
float bearishRetestSourceScore = retestState == RetestState.RetestConfirmed ? retestScore : bearishRetestScore
float bullishTradeRetestScore = bullishTradeRetestContext and not na(bullishRetestSourceScore) ? math.min(25.0, math.max(0.0, bullishRetestSourceScore * 0.25)) : 0.0
float bearishTradeRetestScore = bearishTradeRetestContext and not na(bearishRetestSourceScore) ? math.min(25.0, math.max(0.0, bearishRetestSourceScore * 0.25)) : 0.0
float bullishTradeSmartMoneyScore = math.min(20.0, math.max(0.0, bullishSmartMoneyScore * 0.20))
float bearishTradeSmartMoneyScore = math.min(20.0, math.max(0.0, bearishSmartMoneyScore * 0.20))
float bullishTradeScoreRaw = math.min(100.0, math.max(0.0, bullishSessionScore + bullishTrendScore + bullishTradeBreakoutScore + bullishTradeRetestScore + bullishTradeSmartMoneyScore))
float bearishTradeScoreRaw = math.min(100.0, math.max(0.0, bearishSessionScore + bearishTrendScore + bearishTradeBreakoutScore + bearishTradeRetestScore + bearishTradeSmartMoneyScore))
bool bullishSessionGate = sessionState.isActive and rangeState.isComplete and rangeState.qualityAccepted and breakoutRangeQualityValid
bool bearishSessionGate = bullishSessionGate
bool bullishBreakoutGate = not requireBreakoutConfirmationForScore or bullishBreakoutContext
bool bearishBreakoutGate = not requireBreakoutConfirmationForScore or bearishBreakoutContext
bool bullishRetestGate = not requireRetestConfirmationForScore or (retestState == RetestState.RetestConfirmed and retestTradeDirection == TradeDirection.Long and not retestFailed)
bool bearishRetestGate = not requireRetestConfirmationForScore or (retestState == RetestState.RetestConfirmed and retestTradeDirection == TradeDirection.Short and not retestFailed)
bool bullishTrendGate = (not requireTrendAlignmentForScore or trendState.direction == TrendDirection.Bullish) and bullishTrendScore >= minimumTradeTrendScore
bool bearishTrendGate = (not requireTrendAlignmentForScore or trendState.direction == TrendDirection.Bearish) and bearishTrendScore >= minimumTradeTrendScore
bool bullishSmartMoneyGate = bullishTradeSmartMoneyScore >= minimumTradeSmartMoneyScore
bool bearishSmartMoneyGate = bearishTradeSmartMoneyScore >= minimumTradeSmartMoneyScore
bool bullishComponentMinimumsPass = bullishTradeBreakoutScore >= minimumTradeBreakoutScore and bullishTradeRetestScore >= minimumTradeRetestScore
bool bearishComponentMinimumsPass = bearishTradeBreakoutScore >= minimumTradeBreakoutScore and bearishTradeRetestScore >= minimumTradeRetestScore
bool bullishMandatoryGatePass = bullishSessionGate and bullishBreakoutGate and bullishRetestGate and bullishTrendGate and bullishSmartMoneyGate and bullishComponentMinimumsPass
bool bearishMandatoryGatePass = bearishSessionGate and bearishBreakoutGate and bearishRetestGate and bearishTrendGate and bearishSmartMoneyGate and bearishComponentMinimumsPass
bool bullishHardDisqualified = not bullishSessionGate or (requireBreakoutConfirmationForScore and (breakoutState == BreakoutState.BullishFailed or breakoutState == BreakoutState.Invalidated)) or (requireRetestConfirmationForScore and retestTradeDirection == TradeDirection.Long and (retestState == RetestState.RetestFailed or retestState == RetestState.Expired))
bool bearishHardDisqualified = not bearishSessionGate or (requireBreakoutConfirmationForScore and (breakoutState == BreakoutState.BearishFailed or breakoutState == BreakoutState.Invalidated)) or (requireRetestConfirmationForScore and retestTradeDirection == TradeDirection.Short and (retestState == RetestState.RetestFailed or retestState == RetestState.Expired))
bool bullishLateRetest = retestTradeDirection == TradeDirection.Long and not na(retestBarsSinceBreakout) and (retestWindowMode == RetestWindowMode.Bars ? retestBarsSinceBreakout > retestWindowValue * 0.75 : not na(retestStartTime) and time - retestStartTime > retestWindowValue * MILLISECONDS_PER_MINUTE * 0.75)
bool bearishLateRetest = retestTradeDirection == TradeDirection.Short and not na(retestBarsSinceBreakout) and (retestWindowMode == RetestWindowMode.Bars ? retestBarsSinceBreakout > retestWindowValue * 0.75 : not na(retestStartTime) and time - retestStartTime > retestWindowValue * MILLISECONDS_PER_MINUTE * 0.75)
float bullishTradePenalty = enableSetupPenalties ? math.min(100.0, ((breakoutState == BreakoutState.BullishFailed or (retestTradeDirection == TradeDirection.Long and retestFailed)) ? failedContextPenalty : 0.0) + (trendState.direction == TrendDirection.Bearish ? opposingTrendPenalty : 0.0) + (smartMoneyBias == SmartMoneyBias.Bearish ? opposingSmartMoneyPenalty : 0.0) + (bullishBreakoutContext and not na(breakoutDistanceATR) and breakoutDistanceATR > maximumPreferredBreakoutDistanceAtr ? excessiveBreakoutDistancePenalty : 0.0) + (bullishLateRetest ? lateRetestPenalty : 0.0)) : 0.0
float bearishTradePenalty = enableSetupPenalties ? math.min(100.0, ((breakoutState == BreakoutState.BearishFailed or (retestTradeDirection == TradeDirection.Short and retestFailed)) ? failedContextPenalty : 0.0) + (trendState.direction == TrendDirection.Bullish ? opposingTrendPenalty : 0.0) + (smartMoneyBias == SmartMoneyBias.Bullish ? opposingSmartMoneyPenalty : 0.0) + (bearishBreakoutContext and not na(breakoutDistanceATR) and breakoutDistanceATR > maximumPreferredBreakoutDistanceAtr ? excessiveBreakoutDistancePenalty : 0.0) + (bearishLateRetest ? lateRetestPenalty : 0.0)) : 0.0
float bullishTradeScoreAdjusted = math.min(100.0, math.max(0.0, bullishTradeScoreRaw - bullishTradePenalty))
float bearishTradeScoreAdjusted = math.min(100.0, math.max(0.0, bearishTradeScoreRaw - bearishTradePenalty))
bullishTradeScore := tradeScoringEnabled ? bullishTradeScoreAdjusted : 0.0
bearishTradeScore := tradeScoringEnabled ? bearishTradeScoreAdjusted : 0.0

//==============================================================================
// 19. M7-C SETUP QUALIFICATION AND LIFECYCLE
//==============================================================================
// The threshold applies only when a setup is created. Once qualified, its
// lifecycle is controlled by the mandatory contextual gates and M2/M4/M5 state,
// rather than transient score fluctuations caused by bounded penalties.
bool bullishScoreThresholdPass = not na(bullishTradeScore) and bullishTradeScore >= tradeQualificationThreshold
bool bearishScoreThresholdPass = not na(bearishTradeScore) and bearishTradeScore >= tradeQualificationThreshold
bool bullishCurrentLifecycleValid = bullishBreakoutContext and bullishTradeRetestContext
bool bearishCurrentLifecycleValid = bearishBreakoutContext and bearishTradeRetestContext
bool bullishTradeQualificationCandidate = tradeScoringEnabled and barstate.isconfirmed and bullishMandatoryGatePass and not bullishHardDisqualified and bullishScoreThresholdPass and bullishCurrentLifecycleValid
bool bearishTradeQualificationCandidate = tradeScoringEnabled and barstate.isconfirmed and bearishMandatoryGatePass and not bearishHardDisqualified and bearishScoreThresholdPass and bearishCurrentLifecycleValid
float tradeScoreDifference = not na(bullishTradeScore) and not na(bearishTradeScore) ? math.abs(bullishTradeScore - bearishTradeScore) : na
float bullishScoreLead = not na(bullishTradeScore) and not na(bearishTradeScore) ? bullishTradeScore - bearishTradeScore : na
float bearishScoreLead = not na(bullishTradeScore) and not na(bearishTradeScore) ? bearishTradeScore - bullishTradeScore : na
bool dualQualification = bullishTradeQualificationCandidate and bearishTradeQualificationCandidate
bool bullishDualLead = dualQualification and not na(bullishScoreLead) and bullishScoreLead > 0.0
bool bearishDualLead = dualQualification and not na(bearishScoreLead) and bearishScoreLead > 0.0
bool directionalDifferenceMeetsMinimum = not na(tradeScoreDifference) and tradeScoreDifference > 0.0 and tradeScoreDifference >= minimumDirectionalScoreDifference
bool dualQualificationConflict = dualQualification and not directionalDifferenceMeetsMinimum
bool bullishDirectionSelected = (bullishTradeQualificationCandidate and not bearishTradeQualificationCandidate) or (bullishDualLead and (directionalDifferenceMeetsMinimum or not rejectDirectionalConflict))
bool bearishDirectionSelected = (bearishTradeQualificationCandidate and not bullishTradeQualificationCandidate) or (bearishDualLead and (directionalDifferenceMeetsMinimum or not rejectDirectionalConflict))
bool unresolvedDirectionalConflict = dualQualificationConflict and (rejectDirectionalConflict or (not bullishDualLead and not bearishDualLead))

// Qualification events are explicitly reset on every bar and are asserted only
// on entry to a new final directional setup.
bullishTradeQualifiedEvent := false
bearishTradeQualifiedEvent := false

bool bullishActiveSetup = tradeSetupState == TradeSetupState.BullishQualified
bool bearishActiveSetup = tradeSetupState == TradeSetupState.BearishQualified
bool bullishLifecycleExpired = sessionState.justEnded or not sessionState.isActive or (retestTradeDirection == TradeDirection.Long and retestState == RetestState.Expired)
bool bearishLifecycleExpired = sessionState.justEnded or not sessionState.isActive or (retestTradeDirection == TradeDirection.Short and retestState == RetestState.Expired)
bool bullishLifecycleFailed = bullishHardDisqualified or breakoutState == BreakoutState.BullishFailed or breakoutState == BreakoutState.Invalidated or (retestTradeDirection == TradeDirection.Long and retestState == RetestState.RetestFailed)
bool bearishLifecycleFailed = bearishHardDisqualified or breakoutState == BreakoutState.BearishFailed or breakoutState == BreakoutState.Invalidated or (retestTradeDirection == TradeDirection.Short and retestState == RetestState.RetestFailed)
bool bullishLifecycleStale = not bullishCurrentLifecycleValid and not bullishLifecycleFailed and not bearishCurrentLifecycleValid
bool bearishLifecycleStale = not bearishCurrentLifecycleValid and not bearishLifecycleFailed and not bullishCurrentLifecycleValid
bool bullishContextInvalid = not bullishMandatoryGatePass or bearishCurrentLifecycleValid
bool bearishContextInvalid = not bearishMandatoryGatePass or bullishCurrentLifecycleValid

// A fresh M2 session clears M7-only setup data. M2 through M6 state remains
// exclusively owned by its existing engines.
if sessionState.justStarted
    tradeSetupState := TradeSetupState.None
    tradeBias := TradeBias.None
    tradeSetupBarIndex := na
    tradeSetupScore := na
    tradeSetupDirection := TradeBias.None
else if bullishActiveSetup
    if bullishLifecycleExpired or bullishLifecycleStale
        tradeSetupState := TradeSetupState.Expired
        tradeBias := TradeBias.None
        tradeSetupBarIndex := na
        tradeSetupScore := na
        tradeSetupDirection := TradeBias.None
    else if bullishLifecycleFailed or bullishContextInvalid
        tradeSetupState := TradeSetupState.Disqualified
        tradeBias := TradeBias.None
        tradeSetupBarIndex := na
        tradeSetupScore := na
        tradeSetupDirection := TradeBias.None
    else if unresolvedDirectionalConflict
        tradeSetupState := TradeSetupState.Conflict
        tradeBias := TradeBias.Neutral
        tradeSetupBarIndex := na
        tradeSetupScore := na
        tradeSetupDirection := TradeBias.None
else if bearishActiveSetup
    if bearishLifecycleExpired or bearishLifecycleStale
        tradeSetupState := TradeSetupState.Expired
        tradeBias := TradeBias.None
        tradeSetupBarIndex := na
        tradeSetupScore := na
        tradeSetupDirection := TradeBias.None
    else if bearishLifecycleFailed or bearishContextInvalid
        tradeSetupState := TradeSetupState.Disqualified
        tradeBias := TradeBias.None
        tradeSetupBarIndex := na
        tradeSetupScore := na
        tradeSetupDirection := TradeBias.None
    else if unresolvedDirectionalConflict
        tradeSetupState := TradeSetupState.Conflict
        tradeBias := TradeBias.Neutral
        tradeSetupBarIndex := na
        tradeSetupScore := na
        tradeSetupDirection := TradeBias.None
else
    if unresolvedDirectionalConflict
        tradeSetupState := TradeSetupState.Conflict
        tradeBias := TradeBias.Neutral
        tradeSetupBarIndex := na
        tradeSetupScore := na
        tradeSetupDirection := TradeBias.None
    else if bullishDirectionSelected
        tradeSetupState := TradeSetupState.BullishQualified
        tradeBias := TradeBias.Bullish
        tradeSetupBarIndex := bar_index
        tradeSetupScore := bullishTradeScore
        tradeSetupDirection := TradeBias.Bullish
        bullishTradeQualifiedEvent := true
    else if bearishDirectionSelected
        tradeSetupState := TradeSetupState.BearishQualified
        tradeBias := TradeBias.Bearish
        tradeSetupBarIndex := bar_index
        tradeSetupScore := bearishTradeScore
        tradeSetupDirection := TradeBias.Bearish
        bearishTradeQualifiedEvent := true
    else if tradeSetupState == TradeSetupState.Conflict
        tradeSetupState := TradeSetupState.None
        tradeBias := TradeBias.None
        tradeSetupBarIndex := na
        tradeSetupScore := na
        tradeSetupDirection := TradeBias.None

// Current-state outputs are derived from the owned enum, so both directions
// cannot qualify simultaneously. Setup strength is diagnostic and only applies
// to an active qualified setup with a valid stored origin score.
bullishTradeQualified := tradeSetupState == TradeSetupState.BullishQualified
bearishTradeQualified := tradeSetupState == TradeSetupState.BearishQualified
tradeSetupStrength := (bullishTradeQualified or bearishTradeQualified) and not na(tradeSetupScore) ? tradeSetupScore >= 90.0 ? TradeSetupStrength.Extreme : tradeSetupScore >= 75.0 ? TradeSetupStrength.Strong : tradeSetupScore >= 60.0 ? TradeSetupStrength.Normal : TradeSetupStrength.Weak : TradeSetupStrength.Weak

// Dashboard text is formed in the main execution scope. This prevents Pine
// from coercing series enum values to const parameters through UpdateDashboard.
smartMoneyBiasDashboardText := smartMoneyBias == SmartMoneyBias.Bullish ? "Bullish" : smartMoneyBias == SmartMoneyBias.Bearish ? "Bearish" : "Neutral"
smartMoneyStrengthDashboardText := smartMoneyStrength == SmartMoneyStrength.Extreme ? "Extreme" : smartMoneyStrength == SmartMoneyStrength.Strong ? "Strong" : smartMoneyStrength == SmartMoneyStrength.Normal ? "Normal" : "Weak"
tradeSetupStateDashboardText := tradeSetupState == TradeSetupState.BullishQualified ? "Bullish Qualified" : tradeSetupState == TradeSetupState.BearishQualified ? "Bearish Qualified" : tradeSetupState == TradeSetupState.Conflict ? "Conflict" : tradeSetupState == TradeSetupState.Disqualified ? "Disqualified" : tradeSetupState == TradeSetupState.Expired ? "Expired" : "None"
tradeBiasDashboardText := tradeBias == TradeBias.Bullish ? "Bullish" : tradeBias == TradeBias.Bearish ? "Bearish" : tradeBias == TradeBias.Neutral ? "Neutral" : "None"
tradeSetupStrengthDashboardText := tradeSetupStrength == TradeSetupStrength.Extreme ? "Extreme" : tradeSetupStrength == TradeSetupStrength.Strong ? "Strong" : tradeSetupStrength == TradeSetupStrength.Normal ? "Normal" : "Weak"

// M7 dashboard mirrors are assigned after the directional series are complete.
// They keep the single dashboard independent of forward references and enum
// qualifier coercion inside the dashboard function.
bullishTradeScoreRawDisplay := bullishTradeScoreRaw
bearishTradeScoreRawDisplay := bearishTradeScoreRaw
bullishTradePenaltyDisplay := bullishTradePenalty
bearishTradePenaltyDisplay := bearishTradePenalty
bullishMandatoryGateDisplay := bullishMandatoryGatePass
bearishMandatoryGateDisplay := bearishMandatoryGatePass
bullishTradeCandidateDisplay := bullishTradeQualificationCandidate
bearishTradeCandidateDisplay := bearishTradeQualificationCandidate
tradeScoreDifferenceDisplay := tradeScoreDifference

if na(rangeBox)
    [nextRangeBox, nextRangeHighLine, nextRangeLowLine, nextRangeMidLine, nextRangeHighLabel, nextRangeLowLabel, nextRangeWidthLabel] = CreateRangeDrawings()
    rangeBox := nextRangeBox
    rangeHighLine := nextRangeHighLine
    rangeLowLine := nextRangeLowLine
    rangeMidLine := nextRangeMidLine
    rangeHighLabel := nextRangeHighLabel
    rangeLowLabel := nextRangeLowLabel
    rangeWidthLabel := nextRangeWidthLabel
trendLabel := CalculateTrendLabel(trendLabel)
UpdateRangeDrawings()
UpdateDashboard()
UpdateDebugPanel()

plot(showEmaPlots ? fastEmaValue : na, "Fast EMA", color = color.teal, linewidth = 2)
plot(showEmaPlots ? slowEmaValue : na, "Slow EMA", color = color.orange, linewidth = 2)
color trendBackground = IsBullTrend() ? color.new(color.lime, 90) : IsBearTrend() ? color.new(color.red, 90) : color.new(color.gray, 95)
bgcolor(showTrendBackground ? trendBackground : na, title = "Trend Background")
color tradeBiasBackground = tradeSetupState == TradeSetupState.BullishQualified ? color.new(color.lime, 93) : tradeSetupState == TradeSetupState.BearishQualified ? color.new(color.red, 93) : tradeSetupState == TradeSetupState.Conflict ? color.new(color.orange, 94) : na
bgcolor(showTradeBiasBackground ? tradeBiasBackground : na, title = "Trade Bias Background")
plot(showBreakoutLevels and (breakoutConfirmed or breakoutFailed) ? breakoutPrice : na, "Breakout Level", color = breakoutTradeDirection == TradeDirection.Long ? color.lime : breakoutTradeDirection == TradeDirection.Short ? color.red : color.gray, linewidth = 2, style = plot.style_linebr)
plotshape(showBreakoutMarkers and bullishBreakoutSignal, "Bullish Breakout", shape.triangleup, location.belowbar, color.lime, size = size.small)
plotshape(showBreakoutMarkers and bearishBreakoutSignal, "Bearish Breakout", shape.triangledown, location.abovebar, color.red, size = size.small)
plotshape(showBreakoutMarkers and bullishBreakoutFailure, "Bullish Breakout Failure", shape.xcross, location.abovebar, color.orange, size = size.tiny)
plotshape(showBreakoutMarkers and bearishBreakoutFailure, "Bearish Breakout Failure", shape.xcross, location.belowbar, color.orange, size = size.tiny)
plotchar(showBreakoutScore and (bullishBreakoutSignal or bearishBreakoutSignal) ? breakoutScore : na, "Breakout Score", "•", location.top, color = color.white)
bool retestLevelVisible = retestState != RetestState.None and not na(retestLevel)
plot(showRetestLevel and retestLevelVisible ? retestLevel : na, "Retest Level", color = retestTradeDirection == TradeDirection.Long ? color.aqua : retestTradeDirection == TradeDirection.Short ? color.fuchsia : color.gray, linewidth = 2, style = plot.style_linebr)
plotshape(showRetestMarkers and bullishRetestDetected, "Bullish Retest Detected", shape.circle, location.belowbar, color.aqua, size = size.tiny)
plotshape(showRetestMarkers and bearishRetestDetected, "Bearish Retest Detected", shape.circle, location.abovebar, color.fuchsia, size = size.tiny)
plotshape(showRetestMarkers and bullishRetestConfirmed, "Bullish Retest Confirmed", shape.diamond, location.belowbar, color.lime, size = size.small)
plotshape(showRetestMarkers and bearishRetestConfirmed, "Bearish Retest Confirmed", shape.diamond, location.abovebar, color.red, size = size.small)
plotshape(showRetestMarkers and bullishRetestFailure, "Bullish Retest Failure", shape.xcross, location.abovebar, color.orange, size = size.small)
plotshape(showRetestMarkers and bearishRetestFailure, "Bearish Retest Failure", shape.xcross, location.belowbar, color.orange, size = size.small)
plotchar(showRetestScore and (bullishRetestConfirmed or bearishRetestConfirmed) ? retestScore : na, "Retest Score", "R", location.bottom, color = color.white)
plotshape(showQualifiedSetupMarkers and bullishTradeQualifiedEvent, "Bullish Qualified Setup", shape.labelup, location.belowbar, color.lime, text = "LONG", textcolor = color.white, size = size.small)
plotshape(showQualifiedSetupMarkers and bearishTradeQualifiedEvent, "Bearish Qualified Setup", shape.labeldown, location.abovebar, color.red, text = "SHORT", textcolor = color.white, size = size.small)
if showSetupScore and bullishTradeQualifiedEvent
    label.new(bar_index, low, "LONG " + FormatValueOrDash(tradeSetupScore), style = label.style_label_up, color = color.lime, textcolor = color.white, size = size.tiny)
if showSetupScore and bearishTradeQualifiedEvent
    label.new(bar_index, high, "SHORT " + FormatValueOrDash(tradeSetupScore), style = label.style_label_down, color = color.red, textcolor = color.white, size = size.tiny)
plot(showPreviousDayLevels ? previousDayHigh : na, "Previous Day High", color = color.new(color.blue, 20), linewidth = 1, style = plot.style_linebr)
plot(showPreviousDayLevels ? previousDayLow : na, "Previous Day Low", color = color.new(color.blue, 20), linewidth = 1, style = plot.style_linebr)
plot(showPreviousDayLevels ? previousDayClose : na, "Previous Day Close", color = color.new(color.blue, 55), linewidth = 1, style = plot.style_linebr)
plot(showPreviousDayLevels ? previousDayMid : na, "Previous Day Mid", color = color.new(color.blue, 70), linewidth = 1, style = plot.style_linebr)
plot(showPreviousWeekLevels ? previousWeekHigh : na, "Previous Week High", color = color.new(color.purple, 20), linewidth = 1, style = plot.style_linebr)
plot(showPreviousWeekLevels ? previousWeekLow : na, "Previous Week Low", color = color.new(color.purple, 20), linewidth = 1, style = plot.style_linebr)
plot(showPreviousWeekLevels ? previousWeekClose : na, "Previous Week Close", color = color.new(color.purple, 55), linewidth = 1, style = plot.style_linebr)
plot(showPreviousWeekLevels ? previousWeekMid : na, "Previous Week Mid", color = color.new(color.purple, 70), linewidth = 1, style = plot.style_linebr)
plot(showEqualHighsLows and equalHighActive ? equalHighLevel : na, "Equal Highs", color = color.orange, linewidth = 2, style = plot.style_linebr)
plot(showEqualHighsLows and equalLowActive ? equalLowLevel : na, "Equal Lows", color = color.aqua, linewidth = 2, style = plot.style_linebr)
plotshape(showLiquiditySweeps and bullishLiquiditySweep, "Bullish Liquidity Sweep", shape.triangleup, location.belowbar, color.lime, size = size.small)
plotshape(showLiquiditySweeps and bearishLiquiditySweep, "Bearish Liquidity Sweep", shape.triangledown, location.abovebar, color.red, size = size.small)
plot(showFvgZones and latestBullishFvgActive ? latestBullishFvgTop : na, "Bullish FVG Top", color = color.new(color.lime, 35), style = plot.style_linebr)
plot(showFvgZones and latestBullishFvgActive ? latestBullishFvgBottom : na, "Bullish FVG Bottom", color = color.new(color.lime, 35), style = plot.style_linebr)
plot(showFvgZones and latestBearishFvgActive ? latestBearishFvgTop : na, "Bearish FVG Top", color = color.new(color.red, 35), style = plot.style_linebr)
plot(showFvgZones and latestBearishFvgActive ? latestBearishFvgBottom : na, "Bearish FVG Bottom", color = color.new(color.red, 35), style = plot.style_linebr)
plot(showOrderBlocks and latestBullishObActive ? latestBullishObMid : na, "Bullish OB Mid", color = color.new(color.aqua, 20), linewidth = 2, style = plot.style_linebr)
plot(showOrderBlocks and latestBearishObActive ? latestBearishObMid : na, "Bearish OB Mid", color = color.new(color.orange, 20), linewidth = 2, style = plot.style_linebr)
plot(showPremiumDiscount ? dealingRangeHigh : na, "Dealing Range High", color = color.new(color.purple, 35), style = plot.style_linebr)
plot(showPremiumDiscount ? dealingRangeLow : na, "Dealing Range Low", color = color.new(color.purple, 35), style = plot.style_linebr)
plot(showPremiumDiscount ? dealingRangeEquilibrium : na, "Dealing Range Equilibrium", color = color.new(color.gray, 30), style = plot.style_linebr)
